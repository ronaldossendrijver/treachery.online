@inherits GameComponent

@{
    var messages = MessagesInOrder.ToList();
    var reports = AllReports;
    var index = DisplayedIndex(reports);
    var isHistory = index < reports.Count - 1;
    var title = DisplayedReport is { } shown ? $"{(isHistory ? $"T{shown.Turn} · " : "")}{Client.CurrentSkin.Describe(shown.About)} log" : "Log";

    <section class="map-report-panel @(_isCollapsed ? "is-collapsed" : "") @(_isExpanded ? "is-expanded" : "") @(isHistory ? "is-history" : "")" aria-label="@title" @ref="_panelElement">
        <div class="map-report-resize map-report-resize-y" data-resize="y" aria-hidden="true" title="Drag to resize, double-click to reset"></div>
        <div class="map-report-resize map-report-resize-x" data-resize="x" aria-hidden="true" title="Drag to resize, double-click to reset"></div>
        <div class="map-report-resize map-report-resize-xy" data-resize="xy" aria-hidden="true" title="Drag to resize, double-click to reset"></div>
        <header class="map-report-header">
            <button class="map-report-toggle" type="button" aria-expanded="@(!_isCollapsed && _isExpanded)" @onclick="ToggleExpanded">
                <span class="map-report-title" title="@title">@title</span>
                <span class="map-report-chevron" aria-hidden="true">@(_isExpanded ? "⌄" : "⌃")</span>
            </button>
            @if (!_isCollapsed && reports.Count > 1)
            {
                <button class="map-report-nav" type="button" aria-label="Previous log" title="Previous log" disabled="@(index <= 0)" @onclick="() => Show(reports, index - 1)">‹</button>
                <button class="map-report-nav" type="button" aria-label="Next log" title="@(isHistory ? "Next log" : "Latest log")" disabled="@(!isHistory)" @onclick="() => Show(reports, index + 1)">›</button>
                                @if (isHistory)
                                {
                                    <button class="map-report-nav" type="button" aria-label="Latest log" title="Latest log" @onclick="() => Show(reports, reports.Count - 1)">»</button>
                                }
                            }
            @if (!_isCollapsed && _isExpanded && messages.Count > 1)
            {
                <button class="map-report-sort" type="button" aria-label="@(SortDescending ? "Sort log oldest first" : "Sort log newest first")" title="@(SortDescending ? "Oldest first" : "Newest first")" @onclick="ChangeSortOrder">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        @if (SortDescending)
                        {
                            <path d="M3.5 12.5a.5.5 0 0 1-1 0V3.707L1.354 4.854a.5.5 0 1 1-.708-.708l2-1.999.007-.007a.498.498 0 0 1 .7.006l2 2a.5.5 0 1 1-.707.708L3.5 3.707V12.5zm3.5-9a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zM7.5 6a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5zm0 3a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1h-3zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1z" />
                        }
                        else
                        {
                            <path d="M3.5 2.5a.5.5 0 0 0-1 0v8.793l-1.146-1.147a.5.5 0 0 0-.708.708l2 1.999.007.007a.497.497 0 0 0 .7-.006l2-2a.5.5 0 0 0-.707-.708L3.5 11.293V2.5zm3.5 1a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zM7.5 6a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5zm0 3a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1h-3zm0 3a.5.5 0 0 0 0 1h1a.5.5 0 0 0 0-1h-1z" />
                        }
                    </svg>
                </button>
            }
            <button class="map-report-collapse" type="button" aria-label="@(_isCollapsed ? "Show log" : "Hide log")" title="@(_isCollapsed ? "Show log" : "Hide log")" aria-expanded="@(!_isCollapsed)" @onclick="ToggleCollapsed">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    @if (_isCollapsed)
                    {
                        <path d="M3 10l5-5 5 5"/>
                    }
                    else
                    {
                        <path d="M3 6l5 5 5-5"/>
                    }
                </svg>
            </button>
        </header>

        @if (_isCollapsed)
        {
        }
        else if (!_isExpanded)
        {
            <div class="map-report-latest" aria-label="Log entries" tabindex="0" @ref="_latestElement">
                @if (messages.Count > 0)
                {
                    foreach (var latest in messages)
                    {
                        <div class="@MessageClass(latest)">
                            <ExpressionComponent Expression="@latest.Expression" Game="@Game" Size="15" />
                        </div>
                    }
                }
                else
                {
                    <div class="map-report-empty"><i>Nothing to report</i></div>
                }
            </div>
        }
        else
        {
            <div class="map-report-messages" role="log" aria-live="polite">
                @if (messages.Any())
                {
                    foreach (var message in messages)
                    {
                        <div class="@MessageClass(message)">
                            <ExpressionComponent Expression="@message.Expression" Game="@Game" Size="15" />
                        </div>
                    }
                }
                else
                {
                    <div class="map-report-empty"><i>Nothing to report</i></div>
                }
            </div>
        }
    </section>
}

@code {

    [Parameter]
    public Report? Report { get; set; }

    private bool SortDescending { get; set; }
    private bool _isExpanded;

    private static string MessageClass(Message message) => message.Target == Faction.None ? "map-report-message" : "map-report-message map-report-message-private";

    private IEnumerable<Message> MessagesInOrder {

        get
        {

            if (DisplayedReport is not { } report) return [];
            
            var messagesAscending = report.Messages.Where(m => m.Target == Faction.None || m.Target == Client.Faction);

            if (SortDescending)
            {
                return messagesAscending.OrderByDescending(m => m.Nr);
            }

            return messagesAscending;
        }
    }

    private Report? _selectedReport;

    private Report? DisplayedReport => _selectedReport ?? Report;

    private List<Report> AllReports
    {
        get
        {
            var result = Game.PreviousReports.ToList();
            if (Report is not null) result.Add(Report);
            return result;
        }
    }

    private int DisplayedIndex(List<Report> reports)
    {
        var index = _selectedReport is null ? -1 : reports.IndexOf(_selectedReport);
        if (index < 0)
        {
            _selectedReport = null;
            index = reports.Count - 1;
        }

        return index;
    }

    private void Show(List<Report> reports, int index)
    {
        if (index < 0 || index >= reports.Count) return;
        _selectedReport = index == reports.Count - 1 ? null : reports[index];
    }

    private void ChangeSortOrder()
    {
        SortDescending = !SortDescending;
    }

    private bool _isCollapsed;

    private void ToggleExpanded()
    {
        if (_isCollapsed)
        {
            _isCollapsed = false;
            return;
        }

        _isExpanded = !_isExpanded;
    }

    private void ToggleCollapsed() => _isCollapsed = !_isCollapsed;

    private ElementReference _panelElement;
    private ElementReference _latestElement;
    private Report? _scrolledReport;
    private int _scrolledCount = -1;
    private bool _scrolledDescending;
    private bool _wasCompact;

    // Keep the newest entries in view in the compact panel; older ones remain reachable by scrolling.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Browser.InitReportResize(_panelElement);

        var compact = !_isCollapsed && !_isExpanded;
        var shown = DisplayedReport;
        var count = shown?.Messages.Count ?? 0;
        if (compact && (!_wasCompact || shown != _scrolledReport || count != _scrolledCount || SortDescending != _scrolledDescending))
        {
            _scrolledReport = shown;
            _scrolledCount = count;
            _scrolledDescending = SortDescending;
            await Browser.ScrollToEdge(_latestElement, !SortDescending);
        }

        _wasCompact = compact;
    }
}
