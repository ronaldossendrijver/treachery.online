<ModalComponent Id="@Id" Title="Credits">

    <div class="credits">

        <div class="credits-hero">
            <span class="credits-eyebrow">treachery.online</span>
            <p class="credits-tagline">Made possible by the people below. Thank you!</p>
        </div>

        <dl class="credits-roles">
            <div class="credits-role">
                <dt>Game development</dt>
                <dd>
                    Ronald Ossendrijver
                    <a class="credits-mail" href="mailto:admin@treachery.online" target="_blank">admin@treachery.online</a>
                </dd>
            </div>
            <div class="credits-role">
                <dt>Design &amp; artwork</dt>
                <dd>Ilya Baranovsky, Reinier de Graaf &amp; Piper</dd>
            </div>
            <div class="credits-role">
                <dt>Leader &amp; treachery card artwork</dt>
                <dd>Avalon Hill</dd>
            </div>
            <div class="credits-role">
                <dt>Music</dt>
                <dd>St&eacute;phane Picq &amp; Philippe Ulrich</dd>
            </div>
        </dl>

        <section class="credits-donors" aria-labelledby="@($"{Id}-donors")">
            <header class="credits-donors-header">
                <h3 id="@($"{Id}-donors")">Donations</h3>
                <span class="credits-donors-legend"><span class="credits-star" aria-hidden="true">★</span> generous supporter</span>
            </header>
            <ul class="credits-donor-list">
                @foreach (var donor in Donors)
                {
                    var major = donor.StartsWith('*');
                    <li class="credits-donor @(major ? "is-major" : "")" title="@(major ? "Generous supporter" : null)">@(major ? donor[1..] : donor)</li>
                }
            </ul>
        </section>

        <div class="credits-footer">
            <span>Enjoying the game? Support its development:</span>
            <a href="https://ko-fi.com/N4N618W4XV" target="_blank"><img height="36" src="https://storage.ko-fi.com/cdn/kofi2.png?v=6" alt="Donate on Ko-fi" /></a>
        </div>

    </div>

</ModalComponent>

