@inherits GameComponent

<details class="status-menu ui-align-self-end">
    <summary class="ui-btn @BtnTypeFromStatus ui-btn-sm" aria-label="Change subscription">
        @Name(CurrentSubscription)
    </summary>
    <ul class="status-menu-options">
        @foreach (var status in Enumerations.GetValuesExceptDefault(SubscriptionType.None).Where(s => s != CurrentSubscription))
        {
            <li><button type="button" disabled="@_busy" @onclick="@(_ => SetSubscription(status))">@Name(status)</button></li>
        }
    </ul>
</details>

@code 
{
    [Parameter, EditorRequired]
    public required ScheduledGameInfo ScheduledGame { get; set; }
    
    private bool _busy;

    private SubscriptionType CurrentSubscription => ScheduledGame.Subscribers.GetValueOrDefault(Client.UserId!.Value, SubscriptionType.DontParticipate);
    
    private string BtnTypeFromStatus => CurrentSubscription switch
    {
        SubscriptionType.None => "ui-btn-dark",
        SubscriptionType.DontParticipate => "ui-btn-danger",
        SubscriptionType.MaybeAsPlayer or SubscriptionType.MaybeAsHost => "ui-btn-warning",
        SubscriptionType.CertainAsPlayer or SubscriptionType.CertainAsHost => "ui-btn-primary",
        _ => "ui-btn-dark",
    };


    private async Task SetSubscription(SubscriptionType subscription)
    {
        _busy = true;
        StateHasChanged();
        await Client.RequestSubscribeGame(ScheduledGame.ScheduledGameId, subscription);
        _busy = false;
        StateHasChanged();
    }
}