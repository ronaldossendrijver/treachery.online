@inherits GameComponent

@if (Client?.Game is null || Info is null) return;

<CardPickerComponent Tracker="this" Id="picker" />

<div @ref=@_element class="tracker">

    <nav class="tracker-nav" role="tablist" aria-label="Tracked factions and decks">
        @foreach (var p in Players)
        {
            <button type="button" role="tab" class="tracker-tab @(p == Shown ? "is-active" : "")" aria-selected="@(p == Shown)" @onclick="@(_ => Toggle(p))">
                <img width="28" height="28" src="@Client.CurrentSkin.GetFactionTableImageUrl(p.Faction)" alt=""/>
                <span class="tracker-tab-label">@Client.CurrentSkin.Describe(p.Faction)</span>
                <span class="tracker-tab-count">@KnownCards(p.Faction)</span>
            </button>
        }

        @if (Client.Game.TreacheryDiscardPile != null)
        {
            <button type="button" role="tab" class="tracker-tab tracker-tab-deck @(Client.Game.TreacheryDiscardPile == Shown ? "is-active" : "")" aria-selected="@(Client.Game.TreacheryDiscardPile == Shown)" @onclick="@(_ => Toggle(Client.Game.TreacheryDiscardPile))">
                <img width="20" height="28" src="@Client.CurrentSkin.CardBack_TreacheryCard_URL" alt=""/>
                <span class="tracker-tab-label">Discarded</span>
                <span class="tracker-tab-count">@(Info.DiscardedCards.Count() + Info.RemovedCards.Count())</span>
            </button>
        }

        @if (Client.Game.ResourceCardDeck != null)
        {
            <button type="button" role="tab" class="tracker-tab tracker-tab-deck @(Client.Game.ResourceCardDeck == Shown ? "is-active" : "")" aria-selected="@(Client.Game.ResourceCardDeck == Shown)" @onclick="_ => Toggle(Client.Game.ResourceCardDeck!)">
                <img width="20" height="28" src="@Client.CurrentSkin.CardBack_ResourceCard_URL" alt=""/>
                <span class="tracker-tab-label">@Client.CurrentSkin.Describe(Concept.Resource) deck</span>
            </button>
        }
    </nav>

    <div class="tracker-pane" role="tabpanel">

        @if (Shown is Player shown)
        {
            <header class="tracker-pane-head">
                <img width="44" height="44" src="@Client.CurrentSkin.GetFactionTableImageUrl(shown.Faction)" alt=""/>
                <div>
                    <div class="lobby-kicker">Intelligence</div>
                    <h3>@Client.CurrentSkin.Describe(shown.Faction)</h3>
                </div>
            </header>

            <section class="tracker-section">
                <div class="tracker-section-title">Treachery cards <span>@KnownCards(shown.Faction) / @shown.MaximumNumberOfCards noted · click a slot to set it</span></div>
                <div class="tracker-cards">
                    @for (var i = 0; i < shown.MaximumNumberOfCards; i++)
                    {
                        var selIndex = i;
                        var cardId = Info.TrackedTreacheryCards[shown.Faction][selIndex];

                        <button type="button" class="tracker-card" data-dialog-target="#picker" @onmousedown="@(_ => InitiatePick(shown.Faction, selIndex))" title=@DeterminePopup(cardId)>
                            @if (cardId == TreacheryCard.None)
                            {
                                <span class="tracker-card-empty" aria-label="Empty slot">+</span>
                            }
                            else if (cardId == TreacheryCard.Unknown)
                            {
                                <img src="@Client.CurrentSkin.CardBack_TreacheryCard_URL" alt="Unknown card"/>
                            }
                            else
                            {
                                var card = TreacheryCardManager.Lookup.Find(cardId);
                                <Image Shown=card Pointer/>
                            }
                        </button>
                    }
                </div>
            </section>

            <section class="tracker-section">
                @if (shown.Faction == Faction.Green)
                {
                    <div class="tracker-section-title">Traitors discarded at start</div>
                    <div class="tracker-traitors">
                        @for (var i = 0; i < 3; i++)
                        {
                            var selIndex = i;
                            <PickFromImageComponent Value=@GetDiscardedTraitor(selIndex) T=IHero OnChanged=@(hero => SetDiscardedTraitor(selIndex, hero)) Title="Select Discarded Traitor" Required=false ImageWidth=64 Values="AllTraitors" Placeholder="@EmptySlot"/>
                        }
                    </div>
                }
                else if (shown.Faction != Faction.Purple)
                {
                    <div class="tracker-section-title">Revealed @(shown.NumberOfTraitors > 1 ? "traitors" : "traitor")</div>
                    <div class="tracker-traitors">
                        @for (var i = 0; i < shown.NumberOfTraitors; i++)
                        {
                            var selIndex = i;
                            var faction = shown.Faction;
                            <PickFromImageComponent Value=@GetSelectedTraitor(faction, selIndex) T=IHero OnChanged=@(hero => SetSelectedTraitor(faction, selIndex, hero)) Title="Select Revealed Traitor" Required=false ImageWidth=64 Values="AllTraitors" Placeholder="@EmptySlot"/>
                        }
                    </div>
                }
                else
                {
                    <div class="tracker-section-title">Revealed face dancers</div>
                    <div class="tracker-traitors">
                        @for (var i = 0; i < shown.NumberOfFaceDancers; i++)
                        {
                            var selIndex = i;
                            var faction = shown.Faction;
                            <PickFromImageComponent Value=@GetSelectedTraitor(faction, selIndex) T=IHero OnChanged=@(hero => SetSelectedTraitor(faction, selIndex, hero)) Title="Select Revealed Face Dancer" Required=false ImageWidth=64 Values="AllTraitors" Placeholder="@EmptySlot"/>
                        }
                    </div>
                }
            </section>
        }
        else if (Shown == Client.Game.TreacheryDiscardPile)
        {
            <header class="tracker-pane-head">
                <img width="32" height="44" src="@Client.CurrentSkin.CardBack_TreacheryCard_URL" alt=""/>
                <div>
                    <div class="lobby-kicker">Discard pile</div>
                    <h3>Discarded treachery cards</h3>
                </div>
            </header>

            <section class="tracker-section">
                <div class="tracker-chips">
                    @foreach (var c in Info.DiscardedCards.Union(Info.RemovedCards))
                    {
                        <span class="tracker-chip">
                            <RichText Shown=@c/>
                            <button type="button" class="tracker-chip-remove" aria-label="Not discarded" title="Not discarded" @onclick="@(_ => SetNotDiscarded(c))">×</button>
                        </span>
                    }

                    @if (!Info.DiscardedCards.Any() && !Info.RemovedCards.Any())
                    {
                        <span class="tracker-empty">No treachery cards discarded yet.</span>
                    }
                </div>
                <button type="button" class="ui-btn ui-btn-secondary ui-btn-sm tracker-reshuffle" @onclick="@Info.ClearDiscarded">Reshuffle (clear) discarded cards</button>
            </section>
        }
        else if (Shown == Client.Game.ResourceCardDeck)
        {
            <header class="tracker-pane-head">
                <img width="32" height="44" src="@Client.CurrentSkin.CardBack_ResourceCard_URL" alt=""/>
                <div>
                    <div class="lobby-kicker">Draw pile</div>
                    <h3>@Client.CurrentSkin.Describe(Concept.Resource) deck</h3>
                </div>
            </header>

            <section class="tracker-section">
                <div class="tracker-section-title">Top card</div>
                <div class="tracker-traitors">
                    <PickFromImageComponent Value=@SpiceCard(Info.TrackedSpiceCard)
                                            T=ResourceCard
                                            OnChanged=@(card => Info.TrackedSpiceCard = Client.CurrentSkin.Describe(card))
                                            Title="Select Card"
                                            Required=false
                                            ImageWidth=64
                                            Values="AllSpiceCards"
                                            Placeholder="@EmptySlot"/>
                </div>
            </section>

            <section class="tracker-section">
                @if (Client.Game.Applicable(Rule.IncreasedResourceFlow))
                {
                    if (Client.Game.ResourceCardDiscardPileA?.Items.Any() is true)
                    {
                        <p class="tracker-note"><strong>Discard pile A:</strong> @Client.CurrentSkin.Join(Client.Game.ResourceCardDiscardPileA.Items)</p>
                    }
                    if (Client.Game.ResourceCardDiscardPileB?.Items.Any() is true)
                    {
                        <p class="tracker-note"><strong>Discard pile B:</strong> @Client.CurrentSkin.Join(Client.Game.ResourceCardDiscardPileB.Items)</p>
                    }
                }
                else if (Client.Game.ResourceCardDiscardPileA?.Items.Any() is true)
                {
                    <p class="tracker-note"><strong>Discarded:</strong> @Client.CurrentSkin.Join(Client.Game.ResourceCardDiscardPileA.Items)</p>
                }
            </section>
        }
        else
        {
            <p class="tracker-empty tracker-pick-hint">Select a faction or a deck to view and edit your notes.</p>
        }

        <details class="tracker-help">
            <summary>How to use the tracker</summary>
            <p>@((MarkupString)InfoMessage)</p>
        </details>
    </div>

</div>
@code {

    private object? Shown { get; set; }
    private int _trackedGameId = -1;
    private GreenIntelligence? Info { get; set; }
    private bool _popoversNeedUpdate = true;
    private ElementReference _element;

    protected override async Task OnInitializedAsync()
    {
        Info = new GreenIntelligence(Client);

        try
        {
            await Load();
        }
        catch (Exception e)
        {
            Support.Log(e);
        }

        AllTraitors = [.. Client.Game!.TraitorsInPlay.OrderBy(Name)];
        AllSpiceCards = [.. Game.ResourceCardDeck!.Items.OrderBy(Name)];
        Shown ??= Players.FirstOrDefault(p => p.Faction != Faction.Green) ?? Players.FirstOrDefault();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_trackedGameId != Client.Game!.Seed)
        {
            await Load();
            _trackedGameId = Client.Game.Seed;
        }
        else
        {
            await Save();
        }

        if (_popoversNeedUpdate)
        {
            _popoversNeedUpdate = false;
            await Browser.RefreshPopovers(_element);
        }
    }

    private IHero? GetSelectedTraitor(Faction f, int nr)
    {
        return LeaderManager.HeroLookup.Find(Info!.GetSelectedTraitor(f, nr));
    }

    private void SetSelectedTraitor(Faction f, int nr, IHero? hero)
    {
        if (Shown is Player p && f == p.Faction)
        {
            Info!.ChangeSelectedTraitor(f, nr, hero?.Id);
        }
    }

    private IHero? GetDiscardedTraitor(int nr)
    {
        return LeaderManager.HeroLookup.Find(Info!.GetDiscardedTraitor(nr));
    }

    private void SetDiscardedTraitor(int nr, IHero? hero)
    {
        Info!.ChangeDiscardedTraitor(nr, hero?.Id);
    }

    Faction _currentlyPickedFaction = Faction.None;
    int _currentlyPickedCardId;

    private void SetCurrent(Faction f, int i)
    {
        _currentlyPickedFaction = f;
        _currentlyPickedCardId = i;
    }

    private void InitiatePick(Faction f, int i)
    {
        SetCurrent(f, i);
        _ = Browser.RemovePopovers(_element);
    }

    public int CurrentCard
    {
        get
        {
            if (_currentlyPickedFaction != Faction.None)
            {
                return Info!.TrackedTreacheryCards[_currentlyPickedFaction][_currentlyPickedCardId];
            }

            return TreacheryCard.None;
        }
    }

    public void Pick(int cardId)
    {
        try
        {
            Info!.TrackedTreacheryCards[_currentlyPickedFaction][_currentlyPickedCardId] = cardId;
            _popoversNeedUpdate = true;
            StateHasChanged();
        }
        catch (Exception)
        {
            // ignored
        }
    }

    public void Discard()
    {
        try
        {
            if (Info!.TrackedTreacheryCards[_currentlyPickedFaction][_currentlyPickedCardId] != TreacheryCard.None
                && Info.TrackedTreacheryCards[_currentlyPickedFaction][_currentlyPickedCardId] != TreacheryCard.Unknown)
            {
                Info.Discard(_currentlyPickedFaction, _currentlyPickedCardId);
                _popoversNeedUpdate = true;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // ignored
        }
    }

    public IEnumerable<TreacheryCard> CardsToPick => Info!.AvailableDistinctCards(_currentlyPickedFaction, _currentlyPickedCardId);

    private void SetNotDiscarded(TreacheryCard c)
    {
        Info!.SetNotDiscarded(c);
        _popoversNeedUpdate = true;
        StateHasChanged();
    }

    private static string DeterminePopup(int cardId)
    {
        if (cardId == -1)
        {
            return "Unknown";
        }

        if (cardId == -2)
        {
            return "None";
        }

        return "";
    }

    private async Task Save()
    {
        await Browser.SaveSetting($"treachery.online;currentgame;{Client.Game!.Seed};trackerdata", Info!.ToString());
    }

    private async Task Load()
    {
        var trackerData = await Browser.LoadSetting<string>($"treachery.online;currentgame;{Client.Game!.Seed};trackerdata");
        if (!string.IsNullOrEmpty(trackerData))
        {
            Info = GreenIntelligence.Parse(Client, trackerData);
            StateHasChanged();
        }
    }

    public class CardInfo
    {
        public Player? Player;
        public int CardNumber;
        public int CardId;
    }

    private IList<IHero>? AllTraitors { get; set; }

    private IList<ResourceCard>? AllSpiceCards { get; set; }

    private ResourceCard? SpiceCard(string? name)
    {
        return name is null ? null : AllSpiceCards!.FirstOrDefault(c => Client.CurrentSkin.Describe(c) == name);
    }

    private IEnumerable<Player> Players => Client.Game!.Players.OrderBy(p => Name(p.Faction));

    private string InfoMessage => Client.CurrentSkin.Format("Welcome to the {0} Tracker! Use it to take note of (discarded) traitors, the top spice card and treachery cards.<br>When a (possibly unknown) card is won, click on an empty card placeholder and select it.<br>To indicate that a card was discarded, click it and then select the 'trash can' which will move the card to the Discarded section. When an unknown card becomes known and discarded, select it first, then discard it.<br>When the discard pile is shuffled into a new draw pile, click 'reshuffle' to clear the Discarded section.<br>If you sent a card to the Discarded section by mistake, click on the X next to it.", Faction.Green);

    private int KnownCards(Faction f) => Info!.TrackedTreacheryCards.TryGetValue(f, out var cards) ? cards.Values.Count(c => c != TreacheryCard.None) : 0;

    private static RenderFragment EmptySlot => @<span class="tracker-slot-empty" aria-label="Not set">?</span>;

    private void Toggle(object toShow)
    {
        Shown = toShow;

        _popoversNeedUpdate = true;
    }

}
