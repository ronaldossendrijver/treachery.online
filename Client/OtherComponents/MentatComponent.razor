@inherits GameComponent;

<ModalComponent Id="@Id" Title="Card and Token Reference" Size="dialog-wide">

    <h5>Treachery Cards</h5>
    <div class="ui-row ui-row-cols-3 ui-row-cols-md-6 ui-ms-1 ui-me-1">

        @foreach (var v in TreacheryCardManager.GetCardsInPlay(Game))
        {
            <div class="ui-card">
                <Hoverable Class="ui-card-img-top" Popover=@Client.CurrentSkin.GetPopup(v)>
                    <img src="@Client.CurrentSkin.GetImageUrl(v)" class="ui-card-img" alt="@Name(v)">
                </Hoverable>
            </div>
        }

    </div>

    @if (Game.IsPlaying(Faction.White))
    {
        <h5 class="ui-mt-2">@Client.CurrentSkin.Describe(Faction.White) Cards</h5>
        <div class="ui-row ui-row-cols-3 ui-row-cols-md-6 ui-ms-1 ui-me-1">

            @foreach (var v in TreacheryCardManager.GetWhiteCards())
            {
                <div class="ui-card">
                    <Hoverable Class="ui-card-img-top" Popover=@Client.CurrentSkin.GetPopup(v)>
                        <img src="@Client.CurrentSkin.GetImageUrl(v)" class="ui-card-img" alt="@Name(v)">
                    </Hoverable>
                </div>
            }

        </div>
    }

    <h5 class="ui-mt-2">@Client.CurrentSkin.Describe(Concept.Resource) Cards</h5>
    <div class="ui-row ui-row-cols-3 ui-row-cols-md-6 ui-ms-1 ui-me-1">

        @foreach (var v in Map.GetResourceCardsInPlay(Game))
        {
            <div class="ui-card">
                <Hoverable Class="ui-card-img-top" Popover=@Client.CurrentSkin.GetPopup(v)>
                    <img src="@Client.CurrentSkin.GetImageUrl(v)" class="ui-card-img" alt="@Name(v)">
                </Hoverable>
            </div>
        }

    </div>

    @if (Game.Applicable(Rule.LeaderSkills))
    {
        <h5 class="ui-mt-2">Leader Skill Cards</h5>
        <div class="ui-row ui-row-cols-3 ui-row-cols-md-6 ui-ms-1 ui-me-1">

            @foreach (var v in Enumerations.GetValuesExceptDefault(LeaderSkill.None))
            {
                <div class="ui-card">
                    <Hoverable Class="ui-card-img-top" Popover=@Client.CurrentSkin.GetPopup(v)>
                        <img src="@Client.CurrentSkin.GetImageUrl(v)" class="ui-card-img" alt="@Name(v)">
                    </Hoverable>
                </div>
            }

        </div>
    }

    @if (Game.Applicable(Rule.StrongholdBonus))
    {
        <h5 class="ui-mt-2">Stronghold Cards</h5>
        <div class="ui-row ui-row-cols-3 ui-row-cols-md-6 ui-ms-1 ui-me-1">

            @foreach (var v in Enumerations.GetValuesExceptDefault(StrongholdAdvantage.None))
            {
                <div class="ui-card">
                    <Hoverable Class="ui-card-img-top" Popover=@Client.CurrentSkin.GetPopup(v)>
                        <img src="@Client.CurrentSkin.GetImageUrl(v)" class="ui-card-img" alt="@Name(v)">
                    </Hoverable>
                </div>
            }

        </div>
    }

    @if (Game.Applicable(Rule.NexusCards))
    {
        <h5 class="ui-mt-2">Nexus Cards</h5>
        <div class="ui-row ui-row-cols-3 ui-row-cols-md-6 ui-ms-1 ui-me-1">

            @foreach (var n in Enumerations.GetValuesExceptDefault(Nexus.None))
            {
                <div class="ui-card">
                    <Hoverable Class="ui-card-img-top" Popover=@Client.CurrentSkin.GetNexusCardPopup(n)>
                        <img src="@Client.CurrentSkin.GetImageUrl(n)" class="ui-card-img" alt="@Name(n)">
                    </Hoverable>
                </div>
            }

        </div>
    }

    @if (Game.Applicable(Rule.Homeworlds))
    {
        <h5 class="ui-mt-2">Homeworld Cards</h5>
        <div class="ui-row ui-row-cols-2 ui-row-cols-md-3 ui-ms-1 ui-me-1">

            @foreach (var w in Game.Map.Homeworlds)
            {
                <div class="ui-card">
                    <Hoverable Class="ui-card-img-top" Popover=@Client.CurrentSkin.GetPopup(w)>
                        <img src="@Client.CurrentSkin.GetHomeworldCardImageUrl(w.World)" class="ui-card-img" alt="@Name(w)">
                    </Hoverable>
                </div>
            }

        </div>
    }

    @if (Game.IsPlaying(Faction.Pink))
    {
        <h5 class="ui-mt-2">Ambassador Tokens</h5>
        <div class="ui-row ui-row-cols-6 ui-row-cols-md-12 ui-ms-1 ui-me-1">

            @foreach (var t in Enumerations.GetValuesExceptDefault(Ambassador.None))
            {
                if (t != Ambassador.Cyan)
                {
                    <div class="ui-card">
                        <img src="@Client.CurrentSkin.GetImageUrl(t)" class="ui-card-img" title=@Client.CurrentSkin.GetAmbassadorDescription(t) alt="@Name(t)">
                    </div>
                }
            }

        </div>
    }

    @if (Game.IsPlaying(Faction.Cyan))
    {
        <h5 class="ui-mt-2">Terror Tokens</h5>
        <div>

            <ul>
                @foreach (var t in Enumerations.GetValuesExceptDefault(TerrorType.None))
                {
                    <li><strong>@Name(t) -</strong> @Client.CurrentSkin.GetTerrorTypeDescription(t)</li>
                }
            </ul>

        </div>
    }

    @if (Game.Applicable(Rule.DiscoveryTokens))
    {
        <h5 class="ui-mt-2">Discovery Tokens</h5>
        <div>

            <ul>
            @foreach (var t in Enumerations.GetValuesExceptDefault(DiscoveryToken.None))
            {
                <li><strong>@Name(t) -</strong> @Client.CurrentSkin.GetDiscoveryTokenDescription(t)</li>
            }
            </ul>

        </div>
    }

</ModalComponent>

@code {

    [Parameter] public new string Id { get; set; } = "";
}