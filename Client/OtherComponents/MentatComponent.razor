@inherits GameComponent;

<ModalComponent Id="@Id" Title="Cards and Tokens" Size="dialog-wide" Scrolling="true">

    <div class="ref-modal">

        <section class="ref-section">
            <h3 class="ref-section-title">Treachery Cards</h3>
            <div class="ref-grid">
                @foreach (var v in TreacheryCardManager.GetCardsInPlay(Game))
                {
                    <Hoverable Class="ref-item" Popover=@Client.CurrentSkin.GetPopup(v)>
                        <img src="@Client.CurrentSkin.GetImageUrl(v)" alt="@Name(v)" loading="lazy">
                    </Hoverable>
                }
            </div>
        </section>

        @if (Game.IsPlaying(Faction.White))
        {
            <section class="ref-section">
                <h3 class="ref-section-title">@Client.CurrentSkin.Describe(Faction.White) Cards</h3>
                <div class="ref-grid">
                    @foreach (var v in TreacheryCardManager.GetWhiteCards())
                    {
                        <Hoverable Class="ref-item" Popover=@Client.CurrentSkin.GetPopup(v)>
                            <img src="@Client.CurrentSkin.GetImageUrl(v)" alt="@Name(v)" loading="lazy">
                        </Hoverable>
                    }
                </div>
            </section>
        }

        <section class="ref-section">
            <h3 class="ref-section-title">@Client.CurrentSkin.Describe(Concept.Resource) Cards</h3>
            <div class="ref-grid">
                @foreach (var v in Map.GetResourceCardsInPlay(Game))
                {
                    <Hoverable Class="ref-item" Popover=@Client.CurrentSkin.GetPopup(v)>
                        <img src="@Client.CurrentSkin.GetImageUrl(v)" alt="@Name(v)" loading="lazy">
                    </Hoverable>
                }
            </div>
        </section>

        @if (Game.Applicable(Rule.LeaderSkills))
        {
            <section class="ref-section">
                <h3 class="ref-section-title">Leader Skill Cards</h3>
                <div class="ref-grid">
                    @foreach (var v in Enumerations.GetValuesExceptDefault(LeaderSkill.None))
                    {
                        <Hoverable Class="ref-item" Popover=@Client.CurrentSkin.GetPopup(v)>
                            <img src="@Client.CurrentSkin.GetImageUrl(v)" alt="@Name(v)" loading="lazy">
                        </Hoverable>
                    }
                </div>
            </section>
        }

        @if (Game.Applicable(Rule.StrongholdBonus))
        {
            <section class="ref-section">
                <h3 class="ref-section-title">Stronghold Cards</h3>
                <div class="ref-grid">
                    @foreach (var v in Enumerations.GetValuesExceptDefault(StrongholdAdvantage.None))
                    {
                        <Hoverable Class="ref-item" Popover=@Client.CurrentSkin.GetPopup(v)>
                            <img src="@Client.CurrentSkin.GetImageUrl(v)" alt="@Name(v)" loading="lazy">
                        </Hoverable>
                    }
                </div>
            </section>
        }

        @if (Game.Applicable(Rule.NexusCards))
        {
            <section class="ref-section">
                <h3 class="ref-section-title">Nexus Cards</h3>
                <div class="ref-grid">
                    @foreach (var n in Enumerations.GetValuesExceptDefault(Nexus.None))
                    {
                        <Hoverable Class="ref-item" Popover=@Client.CurrentSkin.GetNexusCardPopup(n)>
                            <img src="@Client.CurrentSkin.GetImageUrl(n)" alt="@Name(n)" loading="lazy">
                        </Hoverable>
                    }
                </div>
            </section>
        }

        @if (Game.Applicable(Rule.Homeworlds))
        {
            <section class="ref-section">
                <h3 class="ref-section-title">Homeworld Cards</h3>
                <div class="ref-grid ref-grid-wide">
                    @foreach (var w in Game.Map.Homeworlds)
                    {
                        <Hoverable Class="ref-item" Popover=@Client.CurrentSkin.GetPopup(w)>
                            <img src="@Client.CurrentSkin.GetHomeworldCardImageUrl(w.World)" alt="@Name(w)" loading="lazy">
                        </Hoverable>
                    }
                </div>
            </section>
        }

        @if (Game.IsPlaying(Faction.Pink))
        {
            <section class="ref-section">
                <h3 class="ref-section-title">Ambassador Tokens</h3>
                <ul class="ref-token-list">
                    @foreach (var t in Enumerations.GetValuesExceptDefault(Ambassador.None).Where(t => t != Ambassador.Cyan))
                    {
                        <li class="ref-token">
                            <img class="ref-token-img" src="@Client.CurrentSkin.GetImageUrl(t)" alt="" loading="lazy">
                            <div>
                                <strong>@Name(t)</strong>
                                <span>@Client.CurrentSkin.GetAmbassadorDescription(t)</span>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (Game.IsPlaying(Faction.Cyan))
        {
            <section class="ref-section">
                <h3 class="ref-section-title">Terror Tokens</h3>
                <ul class="ref-token-list">
                    @foreach (var t in Enumerations.GetValuesExceptDefault(TerrorType.None))
                    {
                        <li class="ref-token">
                            <div>
                                <strong>@Name(t)</strong>
                                <span>@Client.CurrentSkin.GetTerrorTypeDescription(t)</span>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (Game.Applicable(Rule.DiscoveryTokens))
        {
            <section class="ref-section">
                <h3 class="ref-section-title">Discovery Tokens</h3>
                <ul class="ref-token-list">
                    @foreach (var t in Enumerations.GetValuesExceptDefault(DiscoveryToken.None))
                    {
                        var img = Client.CurrentSkin.GetImageUrl(t);
                        <li class="ref-token">
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img class="ref-token-img" src="@img" alt="" loading="lazy">
                            }
                            <div>
                                <strong>@Name(t)</strong>
                                <span>@Client.CurrentSkin.GetDiscoveryTokenDescription(t)</span>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }

    </div>

</ModalComponent>

@code {

    [Parameter] public new string Id { get; set; } = "";
}