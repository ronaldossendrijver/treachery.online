@inherits GameComponent

@if (IsAvailable)
{
    <div class="ui-col ui-col-xs-auto ui-p-0">
        <button class="ui-btn ui-btn-link ui-p-1" type="button"
                data-dialog-target="#@DialogId" aria-haspopup="dialog"
                aria-label="@Title" title="@Title">
            <img class="notes-menu-icon" src="@Client.CurrentSkin.GetFactionTableImageUrl(Faction.Green)" alt="" width="24" height="24"/>
        </button>
    </div>

    <ModalComponent Id="@DialogId" Title="@Title" Size="dialog-large" Scrolling="true">
        <TrackerComponent/>
    </ModalComponent>
}

@code {

    private const string DialogId = "notesModal";

    private bool IsAvailable =>
        !Client.IsObserver && Client.CurrentPhase >= Phase.SelectingTraitors && Client.Faction is Faction.Green;

    private string Title => Client.CurrentSkin.Format("{0} notes", Faction.Green);
}
