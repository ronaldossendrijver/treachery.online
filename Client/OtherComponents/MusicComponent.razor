@inherits GameComponent;
 
@if (Visible)
{
    <div class="volume-settings ui-small">
        <label for="musicVolume">Music</label>
        <input id="musicVolume" class="ui-form-range" type="range" min="0" max="100" step="1" @bind="@DesiredMusicVolume" @bind:event="oninput" @bind:after="@AdjustVolume"/>
        <output for="musicVolume">@Math.Round(DesiredMusicVolume)</output>

        <label for="effectVolume">Sound effects</label>
        <input id="effectVolume" class="ui-form-range" type="range" min="0" max="100" step="1" @bind="@DesiredEffectVolume" @bind:event="oninput" @bind:after="@AdjustVolume" />
        <output for="effectVolume">@Math.Round(DesiredEffectVolume)</output>

        <label for="chatVolume">Chat notifications</label>
        <input id="chatVolume" class="ui-form-range" type="range" min="0" max="100" step="1" @bind="@DesiredChatVolume" @bind:event="oninput" @bind:after="@AdjustVolume" />
        <output for="chatVolume">@Math.Round(DesiredChatVolume)</output>
    </div>

}

@code {

    [Parameter]
    public bool Visible { get; set; }

    private float DesiredMusicVolume { get; set; } = 0;
    private float DesiredEffectVolume { get; set; } = 0;
    private float DesiredChatVolume { get; set; } = 0;
    private string CurrentSoundtrack { get; set; } = "";
    private float CurrentMusicVolume { get; set; } = -1;
    private float CurrentUiSoundVolume { get; set; } = -1;
    private bool _settingsLoaded;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_settingsLoaded)
            return;

        if (Math.Abs(CurrentUiSoundVolume - DesiredEffectVolume) > 0.001f)
        {
            CurrentUiSoundVolume = DesiredEffectVolume;
            await Browser.SetUiSoundVolume(DesiredEffectVolume);
        }

        await UpdateMusicAndSound();
    }

    private async Task UpdateMusicAndSound()
    {
        if (!_settingsLoaded || !Client.InGame)
            return;
        
        Client.CurrentEffectVolume = DesiredEffectVolume;
        Client.CurrentChatVolume = DesiredChatVolume;

        var soundtrackToPlay = DesiredMusicVolume <= 4 ? "" : DetermineSoundtrack();

        if (CurrentSoundtrack != soundtrackToPlay)
        {
            if (CurrentSoundtrack != "")
            {
                await Browser.StopSound(CurrentSoundtrack);
            }

            CurrentSoundtrack = soundtrackToPlay;
            CurrentMusicVolume = DesiredMusicVolume;

            if (soundtrackToPlay != "")
            {
                await Browser.PlaySound(soundtrackToPlay, DesiredMusicVolume, true);
            }
        }
        else if (Math.Abs(CurrentMusicVolume - DesiredMusicVolume) > 0.001f)
        {
            CurrentMusicVolume = DesiredMusicVolume;

            if (soundtrackToPlay != "")
            {
                await Browser.ChangeSoundVolume(soundtrackToPlay, DesiredMusicVolume);
            }
        }
    }

    private string DetermineSoundtrack()
    {
        if (Client.Game == null)
        {
            return Client.CurrentSkin.MusicGeneral_URL;
        }

        return Client.Game.CurrentMainPhase switch
        {
            MainPhase.Setup => Client.CurrentSkin.MusicSetup_URL,
            MainPhase.Blow or MainPhase.Charity => Client.CurrentSkin.MusicResourceBlow_URL,
            MainPhase.Bidding => Client.CurrentSkin.MusicBidding_URL,
            MainPhase.ShipmentAndMove => Client.CurrentSkin.MusicShipmentAndMove_URL,
            MainPhase.Battle when Game.CurrentPhase >= Phase.CallTraitorOrPass => Client.CurrentSkin.MusicBattleClimax_URL,
            MainPhase.Battle => Client.CurrentSkin.MusicBattle_URL,
            MainPhase.Collection or MainPhase.Contemplate or MainPhase.Ended => Client.CurrentSkin.MusicMentat_URL,
            _ => Client.CurrentSkin.MusicGeneral_URL
        };
    }

    private const string MusicVolumeKey = "treachery.online;setting.music";
    private const string EffectVolumeKey = "treachery.online;setting.effect";
    private const string ChatVolumeKey = "treachery.online;setting.chatvolume";
    private const float DefaultVolume = 50;

    private async Task AdjustVolume()
    {
        await SaveVolume(MusicVolumeKey, DesiredMusicVolume);
        await SaveVolume(EffectVolumeKey, DesiredEffectVolume);
        await SaveVolume(ChatVolumeKey, DesiredChatVolume);
    }

    private async Task SaveVolume(string key, float value)
    {
        await Browser.SaveStringSetting(key, value.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    private async Task<float> LoadVolume(string key)
    {
        try
        {
            var stored = await Browser.LoadStringSetting(key);
            if (float.TryParse(stored, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var value))
                return Math.Clamp(value, 0, 100);
        }
        catch (Exception)
        {
            //Fall back to default
        }

        return DefaultVolume;
    }

    private async Task LoadSettings()
    {
        DesiredMusicVolume = await LoadVolume(MusicVolumeKey);
        DesiredEffectVolume = await LoadVolume(EffectVolumeKey);
        DesiredChatVolume = await LoadVolume(ChatVolumeKey);
        _settingsLoaded = true;
    }
}
