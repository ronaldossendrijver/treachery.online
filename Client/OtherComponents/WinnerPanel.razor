@inherits GameComponent;

<div class="ui-card ui-p-1 ui-mb-2 ui-border-light" style="animation:fadeIn 3s;">
    <div class="ui-card-header">Victory!</div>
    <div class="ui-card-body">

        @foreach (var w in Game.Winners)
        {
            <h1 class="h1">
                <img width="72" src="@Client.CurrentSkin.GetImageUrl(w.Faction)" alt="@Client.CurrentSkin.Describe(w.Faction)"/> @w.Name</h1>
        }

        @if (!Game.Applicable(Rule.DisableEndOfGameReport))
        {
            <button class="ui-btn ui-btn-primary ui-mt-1" data-dialog-target="#storyModal">Read the story of this game...</button>
            <StoryComponent Id="storyModal" Game="Client.Game" />
        }

    </div>
</div>
