@using Treachery.Client.GameEventComponents
@using Treachery.Client.MapComponents
@inherits GameComponent

@if (ShowLauncher)
{
    <button class="deals-launcher" type="button" data-dialog-target="#@DialogId" aria-haspopup="dialog"
            aria-label="@($"Open deal offers. {OfferCount} pending offers.")">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7.5 3.5h9A2.5 2.5 0 0 1 19 6v12a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 5 18V6a2.5 2.5 0 0 1 2.5-2.5z" />
            <path d="M8 8h8M8 11.5h5M8 15h4" />
        </svg>
        <span>Deal Offers</span>
        @if (OfferCount > 0)
        {
            <span class="deals-count">@OfferCount</span>
        }
    </button>

    <dialog id="@DialogId" class="deals-dialog" aria-labelledby="@($"{DialogId}-title")">
        <div class="deals-shell">
            <header class="communications-header">
                <div>
                    <span class="eyebrow">NEGOTIATIONS</span>
                    <h2 id="@($"{DialogId}-title")">Deal Offers</h2>
                    <p>Review and respond to pending offers.</p>
                </div>
                <button class="icon-button" type="button" data-dialog-close aria-label="Close deal offers">×</button>
            </header>
            <div class="deals-content">
                @if (OfferCount > 0 || HasUnplacedDeals)
                {
                    <DealComponent />
                }
                @if (CanOfferDeal && !BoardAvailable)
                {
                    <DealOfferedComponent />
                }
                @if (OfferCount == 0 && !HasUnplacedDeals)
                {
                    <p class="deals-empty">There are no pending offers. To offer a deal, click a faction on the map. Current deals appear next to the faction that offered them.</p>
                }
            </div>
        </div>
    </dialog>
}

@code {
    private string DialogId { get; } = $"deals-{Guid.NewGuid():N}";

    private int OfferCount =>
        Client.Player is { } player && !Client.IsObserver
            ? DealAccepted.AcceptableDeals(Game, player).Count() + DealAccepted.CancellableDeals(Game, player).Count()
            : 0;

    private bool BoardAvailable =>
        !Client.PlayersNeedSeating && Game.CurrentPhase > Phase.SelectingFactions;

    private bool HasUnplacedDeals =>
        DealAccepted.CurrentDeals(Game).Any(deal => !BoardAvailable || !DealIndicatorLayout.CanPlaceOnBoard(Game, deal));

    private bool ShowLauncher =>
        Client.InGame && (OfferCount > 0 || HasUnplacedDeals || CanOfferDeal);

    private bool CanOfferDeal =>
        !Client.IsObserver && Client.Player != null && Client.Actions.Contains(typeof(DealOffered));
}
