@if (_loaded && !_dismissed)
{
    <div class="whats-new @(_open ? "is-open" : "") @(_suppressed ? "is-suppressed" : "")"
         @onmouseleave="@(() => _suppressed = false)" @onfocusout="@(() => _suppressed = false)" @onkeydown="OnKeyDown">
        <button class="whats-new-trigger" type="button" aria-expanded="@(_open ? "true" : "false")" aria-controls="whats-new-popover"
                @onclick="Toggle">
            <span class="whats-new-dot" aria-hidden="true"></span>
            Changes in this version
        </button>

        <div id="whats-new-popover" class="whats-new-popover" role="region" aria-label="Changes in this version" tabindex="0">
            <header class="whats-new-header">
                <span class="eyebrow">What's new</span>
                <h2>Advanced Bots</h2>
            </header>

            <section class="whats-new-section">
                <h3>New: Advanced Bots (experimental)</h3>
                <AdvancedBotsInfo/>
            </section>

            <section class="whats-new-section">
                <h3>Updated game design</h3>
                <p>Most controls have moved onto the map. Here is where to find things.</p>
            </section>

            <section class="whats-new-section">
                <h3>On the map</h3>
                <ul>
                    <li>
                        <strong>Give spice to another player:</strong> click that player's faction logo on the map and use the <em>Give spice</em> tab.
                        The <em>Faction info</em> tab next to it shows their leaders and faction details.
                    </li>
                    <li>
                        <strong>Manage your alliance:</strong> click your ally's faction logo on the map and use the <em>Alliance</em> tab.
                        It's no longer in the action panel.
                    </li>
                    <li>
                        <strong>Game menu:</strong> at the top right of the map. It now also holds the Automation panel, the Notekeeping Assistant and the Atreides Tracker.
                    </li>
                    <li>
                        <strong>Chat and deals:</strong> <em>Messages &amp; Players</em> and <em>Deals</em> are at the bottom right of the map.
                        Making a deal offer is now inside the Deals dialog. A number on the Deals button shows how many deals there are.
                    </li>
                    <li><strong>Game logs:</strong> at the bottom left of the map. It can be expanded or collapsed.</li>
                    <li>
                        <strong>Battles:</strong> many battle actions and decisions have now moved to the (now draggable) battle wheel.
                        <ul>
                            <li>Pick your leader, weapon and defense on the wheel.</li>
                            <li>
                                Actions taken at the start of a battle (Voice, Prescience and so on) appear on a parchment flap on the left of the wheel.
                                Actions taken after the battle (Traitor, Face Dancer, Retreat and so on) appear on the right.
                            </li>
                        </ul>
                    </li>
                </ul>
            </section>

            <section class="whats-new-section">
                <h3>In the right panel</h3>
                <ul>
                    <li>
                        <strong>Playing treachery cards:</strong> click the card in your hand in the player panel.
                        A card you can play now glows, wiggles and shows a <em>PLAY</em> label. Clicking it opens a small window to use it.
                        This works for Thumper, Harvester, Weather Control, Family Atomics, Tleilaxu Ghola, Hajr, Amal, Recruits, Truthtrance,
                        Juice of Sapho, Distrans, Ornithopter, Residual Poison, Portable Snooper, Poison Tooth, Stone Burner, Nullentropy and Semuta Drug.
                    </li>
                    <li>
                        <strong>Battle plan:</strong> while making your battle plan, you can also click a leader or card in your player panel to add it to the plan.
                        Click it again (or the <em>×</em> on it) to remove it.
                    </li>
                </ul>
            </section>

            <section class="whats-new-section">
                <h3>On a phone</h3>
                <p>The map fills the screen. The controls are in a bottom sheet you can show or hide.</p>
            </section>
        </div>

        <button class="whats-new-close" type="button" aria-label="Close changes in this version" title="Don't show again" @onclick="Dismiss">×</button>
    </div>
}

@code {
    // Change this value when the list of changes is updated, so the badge is shown again to everyone.
    private const string ChangesVersion = "advanced-bots-1";
    private const string DismissedSetting = "treachery.online;setting.whatsnew.dismissed";

    private bool _loaded;
    private bool _dismissed;
    private bool _open;
    private bool _suppressed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dismissed = await Browser.LoadStringSetting(DismissedSetting) == ChangesVersion;
        }
        catch (Exception)
        {
            _dismissed = false;
        }

        _loaded = true;
    }

    private void Toggle()
    {
        _open = !_open;
        _suppressed = !_open;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        _open = false;
        _suppressed = true;
    }

    private async Task Dismiss()
    {
        _dismissed = true;
        _open = false;
        await Browser.SaveStringSetting(DismissedSetting, ChangesVersion);
    }
}
