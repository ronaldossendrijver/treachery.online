@inherits GameComponent

@{
    var count = Client.Actions.Count(a => BattleWheelState.ActionTypes.Contains(a));
    if (count == 0) return;
}

<div class="battle-wheel-notice">
    <img src="@Client.CurrentSkin.BattleScreen_URL" alt="" />
    <div>
        <strong>Battle actions are on your battle wheel</strong>
        <span>@(BattleWheelState.Hidden ? "The battle wheels are hidden." : "Drag to move it, or hide it to see the map.")</span>
    </div>
    <button type="button" class="ui-btn ui-btn-sm @(BattleWheelState.Hidden ? "ui-btn-primary" : "ui-btn-outline-secondary")" @onclick="@(() => BattleWheelState.Hidden = !BattleWheelState.Hidden)">
        @(BattleWheelState.Hidden ? "Show wheel" : "Hide wheel")
    </button>
</div>

@code {

    protected override void OnInitialized()
    {
        base.OnInitialized();
        BattleWheelState.Changed += OnStateChanged;
    }

    public override void Dispose()
    {
        base.Dispose();
        BattleWheelState.Changed -= OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
}