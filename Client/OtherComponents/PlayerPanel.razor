@using Treachery.Client.GameEventComponents
@inherits GameComponent

@if (Client.CurrentPhase >= Phase.TradingFactions && ShownPlayer is { } shownPlayer)
{
    <div class="ui-card ui-mb-1 player-panel-card @(ShowHeader ? "player-panel-card-collapsible" : "player-panel-card-primary")" style="@FactionThemeStyle">
        @if (ShowHeader)
        {
            <button class="player-panel-heading" type="button" aria-expanded="@(!_collapsed)" @onclick="ToggleCollapsed">
                <img src="@Client.CurrentSkin.GetImageUrl(shownPlayer.Faction)" alt="" />
                <span>@Name(shownPlayer.Faction)</span>
                <span class="player-panel-collapse-icon" aria-hidden="true">@(_collapsed ? "⌄" : "⌃")</span>
            </button>
        }

        @if (!_collapsed || !ShowHeader)
        {
            <div class="player-panel-body" style="@BodyStyle">
                @if (!ShowHeader)
                {
                    <div class="player-panel-identity">
                        <img src="@Client.CurrentSkin.GetImageUrl(shownPlayer.Faction)" alt="" />
                        <span>@Name(shownPlayer.Faction)</span>
                        @if (Client.CurrentPhase >= Phase.BlackMulligan)
                        {
                            @ResourceStrip(shownPlayer)
                        }
                    </div>
                }

                @if (Client.CurrentPhase >= Phase.BlackMulligan)
                {
                    <div class="player-panel-content">
                        @if (ShowHeader)
                        {
                            @ResourceStrip(shownPlayer)
                        }
                        <div class="player-panel-sections @(HasFactionInformation ? "" : "player-panel-sections-no-faction")">
                            <section class="player-panel-section player-panel-people" style="--figure-count:@FigureCount(shownPlayer)">
                              <div class="player-panel-group player-panel-leaders">
                                <h3>Leaders</h3>
                                <div class="player-panel-figures">
                                    @foreach (var leader in shownPlayer.Leaders.Where(leader => Game.IsAlive(leader)))
                                    {
                                        <span class="player-panel-figure-slot @PickClass(leader)" aria-label="@PickTitle(leader)" @onclick="@(() => PickForBattle(leader))"><Image Src="@Client.CurrentSkin.GetImageUrl(leader)" Highlighted="@Game.IsSkilled(leader)" Class="player-panel-figure" Width="48" Popover="@Client.CurrentSkin.GetPopup(leader, Game)" /></span>
                                    }
                                    @foreach (var leader in shownPlayer.Leaders.Where(leader => !Game.IsAlive(leader)))
                                    {
                                        <span class="player-panel-figure-slot"><Image Src="@Client.CurrentSkin.GetImageUrl(leader)" Darkened Class="player-panel-figure" Width="48" Popover="@Client.CurrentSkin.GetPopup(leader, Game)" /></span>
                                    }
                                </div>
                              </div>
                              <div class="player-panel-group player-panel-traitors">
                                <h3>@(shownPlayer.FaceDancers.Count > 0 ? "Face Dancers" : shownPlayer.Traitors.Count == 1 ? "Traitor" : "Traitors")</h3>
                                <div class="player-panel-figures">
                                    @if (shownPlayer.FaceDancers.Count > 0)
                                    {
                                        @foreach (var faceDancer in shownPlayer.FaceDancers)
                                        {
                                            <span class="player-panel-figure-slot"><Image Src="@Client.CurrentSkin.GetImageUrl(faceDancer)" Blurred="@shownPlayer.RevealedFaceDancers.Contains(faceDancer)" Class="player-panel-figure" Width="48" Popover="@Client.CurrentSkin.GetPopup(faceDancer, Game)" /></span>
                                        }
                                    }
                                    else if (!Game.AssistedNoteKeepingEnabled(Player) && shownPlayer.Traitors.Count == 1)
                                    {
                                        <span class="player-panel-figure-slot"><Image Src="@Client.CurrentSkin.GetImageUrl(shownPlayer.Traitors.First())" Class="player-panel-figure" Width="48" Popover="@Client.CurrentSkin.GetPopup(shownPlayer.Traitors.First(), Game)" /></span>
                                    }
                                    else
                                    {
                                        @foreach (var traitor in shownPlayer.Traitors)
                                        {
                                            <span class="player-panel-figure-slot"><Image Src="@Client.CurrentSkin.GetImageUrl(traitor)" Blurred="@shownPlayer.RevealedTraitors.Contains(traitor)" Class="player-panel-figure" Width="48" Popover="@Client.CurrentSkin.GetPopup(traitor, Game)" /></span>
                                        }
                                        @foreach (var traitor in shownPlayer.DiscardedTraitors)
                                        {
                                            <span class="player-panel-figure-slot"><Image Src="@Client.CurrentSkin.GetImageUrl(traitor)" GreyedOut Class="player-panel-figure" Width="48" Popover="@Client.CurrentSkin.GetPopup(traitor, Game)" /></span>
                                        }
                                        @if (shownPlayer.Traitors.Count == 0 && shownPlayer.DiscardedTraitors.Count == 0)
                                        {
                                            <span class="player-panel-empty-hand">No traitor information</span>
                                        }
                                    }
                                </div>
                              </div>
                            </section>

                            <section class="player-panel-section player-panel-owned">
                                <h3>Cards</h3>
                                <div class="player-panel-owned-content">
                                    @{ var hasNexus = shownPlayer.Nexus != Faction.None; var handCount = CardsInHand.Count + (hasNexus ? 1 : 0); }
                                    @if (handCount == 0)
                                    {
                                        <span class="player-panel-empty-hand">No treachery cards</span>
                                    }
                                    else
                                    {
                                        <div class="player-card-hand" aria-label="Cards in hand" style="--hand-count:@handCount">
                                            @for (var i = 0; i < CardsInHand.Count; i++)
                                            {
                                                var card = CardsInHand[i];
                                                var canUseCard = CanUseCard(card);
                                                <button type="button" class="player-hand-card @(i > 0 ? "player-hand-card-overlap" : "") @PickClass(card) @(canUseCard ? "is-card-use-available" : "")"
                                                        aria-label="@(canUseCard ? $"Use {Name(card)}" : PickTitle(card))"
                                                        title="@(canUseCard ? $"Use {Name(card)}" : PickTitle(card))"
                                                        data-dialog-target="@(canUseCard ? $"#{CardUseDialogId(card)}" : null)"
                                                        @onclick="@(() => HandleCardClick(card))"
                                                        style="@HandCardStyle(i, handCount)">
                                                    <Image Shown="@CardsInHand[i]" Game="Game" Class="player-hand-image" />
                                                </button>
                                            }
                                            @if (hasNexus)
                                            {
                                                var nexus = shownPlayer.Nexus.ToNexus();
                                                if (CanPlayNexus)
                                                {
                                                    <button type="button" class="player-hand-card player-hand-nexus is-card-use-available @(CardsInHand.Count > 0 ? "player-hand-card-overlap" : "")"
                                                            aria-label="@($"Use {Name(nexus)}")"
                                                            title="@($"Use {Name(nexus)}")"
                                                            data-dialog-target="#@NexusUseDialogId"
                                                            style="@HandCardStyle(CardsInHand.Count, handCount)">
                                                        <Image Src="@Client.CurrentSkin.GetImageUrl(nexus)" Class="player-hand-image" />
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="player-hand-card player-hand-nexus @(CardsInHand.Count > 0 ? "player-hand-card-overlap" : "")" style="@HandCardStyle(CardsInHand.Count, handCount)">
                                                        <Image Src="@Client.CurrentSkin.GetImageUrl(nexus)" Popover="@Client.CurrentSkin.GetNexusCardPopup(nexus)" Class="player-hand-image" />
                                                    </span>
                                                }
                                            }
                                        </div>
                                    }
                                    @foreach (var card in CardsInHand.Where(CanUseCard))
                                    {
                                        <div class="card-use-window" id="@CardUseDialogId(card)" popover="manual" role="dialog" aria-labelledby="@($"{CardUseDialogId(card)}-title")" data-draggable="card-use-window">
                                            <header class="card-use-window-header" data-drag-handle title="Drag to move">
                                                <span class="card-use-window-grip" aria-hidden="true">⠿</span>
                                                <div class="card-use-window-heading">
                                                    <span class="card-use-window-eyebrow">Play card</span>
                                                    <h2 id="@($"{CardUseDialogId(card)}-title")">@Name(card)</h2>
                                                </div>
                                                <button type="button" class="icon-button card-use-window-close" data-dialog-close aria-label="Close without playing">×</button>
                                            </header>
                                            <div class="card-use-dialog">
                                                <img class="card-use-dialog-image" src="@Client.CurrentSkin.GetImageUrl(card)" alt="@Name(card)" />
                                                <div class="card-use-dialog-actions">
                                                    @foreach (var action in ActionsForCard(card))
                                                    {
                                                        switch (action.Name)
                                                        {
                                                            case nameof(ThumperPlayed): <SimpleActionComponent GameEventType="ThumperPlayed" Title="@Client.CurrentSkin.Format("Use {0}?", TreacheryCardType.Thumper)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.Thumper)" /> break;
                                                            case nameof(RaiseDeadPlayed): <RaiseDeadComponent /> break;
                                                            case nameof(Karma): <KarmaComponent SelectedCard="card" /> break;
                                                            case nameof(KarmaHandSwapInitiated): <KarmaHandSwapInitiatedComponent /> break;
                                                            case nameof(KarmaShipmentPrevention): <KarmaShipmentPreventionComponent /> break;
                                                            case nameof(KarmaRevivalPrevention): <KarmaRevivalPreventionComponent /> break;
                                                            case nameof(KarmaHandSwap): <KarmaHandSwapComponent /> break;
                                                            case nameof(KarmaFreeRevival): <KarmaFreeRevivalComponent /> break;
                                                            case nameof(KarmaHmsMovement): <KarmaHmsMovementComponent /> break;
                                                            case nameof(KarmaMonster): <KarmaMonsterComponent /> break;
                                                            case nameof(KarmaWhiteBuy): <KarmaWhiteBuyComponent /> break;
                                                            case nameof(KarmaBrownDiscard): <KarmaBrownDiscardComponent SelectedCard="card" /> break;
                                                            case nameof(KarmaPrescience): <SimpleActionComponent GameEventType="KarmaPrescience" Title="@Client.CurrentSkin.Format("Use {0} to see the entire enemy battle plan?", TreacheryCardType.Karma)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.Karma)" /> break;
                                                            case nameof(KarmaPinkDial): <SimpleActionComponent GameEventType="KarmaPinkDial" Title="@Client.CurrentSkin.Format("Use {0} to add the difference between the leader discs to your dial?", TreacheryCardType.Karma)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.Karma)" /> break;
                                                            case nameof(StormSpellPlayed): <StormSpellPlayedComponent /> break;
                                                            case nameof(MetheorPlayed): <SimpleActionComponent GameEventType="MetheorPlayed" Title="@Client.CurrentSkin.Format("Use {0}?", TreacheryCardType.Metheor)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.Metheor)" /> break;
                                                            case nameof(Caravan): <CaravanComponent /> break;
                                                            case nameof(ClairVoyancePlayed): <ClairVoyancePlayedComponent /> break;
                                                            case nameof(AmalPlayed): <SimpleActionComponent GameEventType="AmalPlayed" Title="@Client.CurrentSkin.Format("Use {0}?", TreacheryCardType.Amal)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.Amal)" /> break;
                                                            case nameof(RecruitsPlayed): <SimpleActionComponent GameEventType="RecruitsPlayed" Title="@Client.CurrentSkin.Format("Use {0}?", TreacheryCardType.Recruits)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.Recruits)" /> break;
                                                            case nameof(HarvesterPlayed): <SimpleActionComponent GameEventType="HarvesterPlayed" Title="@Client.CurrentSkin.Format("Use {0}?", TreacheryCardType.Harvester)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.Harvester)" /> break;
                                                            case nameof(DiscardedSearchedAnnounced): <SimpleActionComponent GameEventType="DiscardedSearchedAnnounced" Title="@Client.CurrentSkin.Format("Use {0} to pay 2 and search and take a card from the treachery discard pile?", TreacheryCardType.SearchDiscarded)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.SearchDiscarded)" /> break;
                                                            case nameof(DiscardedSearched): <DiscardedSearchedComponent /> break;
                                                            case nameof(DiscardedTaken): <DiscardedTakenComponent /> break;
                                                            case nameof(DistransUsed): <DistransUsedComponent /> break;
                                                            case nameof(FlightUsed): <FlightUsedComponent /> break;
                                                            case nameof(JuicePlayed): <JuicePlayedComponent /> break;
                                                            case nameof(ResidualPlayed): <SimpleActionComponent GameEventType="ResidualPlayed" Title="@Client.CurrentSkin.Format("Use {0} to kill a random available opponent leader?", TreacheryCardType.Residual)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.Residual)" /> break;
                                                            case nameof(PoisonToothCancelled): <SimpleActionComponent GameEventType="PoisonToothCancelled" Title="@Client.CurrentSkin.Format("Cancel {0}?", TreacheryCardType.PoisonTooth)" Alert="false" ConfirmLabel="Cancel" /> break;
                                                            case nameof(PortableAntidoteUsed): <SimpleActionComponent GameEventType="PortableAntidoteUsed" Title="@Client.CurrentSkin.Format("Use your {0}?", TreacheryCardType.PortableAntidote)" Alert="false" ConfirmLabel="@Client.CurrentSkin.Format("Use {0}", TreacheryCardType.PortableAntidote)" /> break;
                                                            case nameof(RockWasMelted): <RockWasMeltedComponent /> break;
                                                            case nameof(BrownExtraMove): <SimpleActionComponent GameEventType="BrownExtraMove" Title="@($"Use {Name(card)} to be able to move your forces one extra territory?")" Alert="false" ConfirmLabel="@($"Use {Name(card)}")" /> break;
                                                            case nameof(BrownMovePrevention): <BrownMovePreventionComponent /> break;
                                                            case nameof(BrownKarmaPrevention): <BrownKarmaPreventionComponent /> break;
                                                            case nameof(BrownFreeRevivalPrevention): <BrownFreeRevivalPreventionComponent /> break;
                                                            case nameof(BrownRemoveForce): <BrownRemoveForceComponent /> break;
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @if (CanPlayNexus)
                                    {
                                        var nexusCard = shownPlayer.Nexus.ToNexus();
                                        <div class="card-use-window" id="@NexusUseDialogId" popover="manual" role="dialog" aria-labelledby="@($"{NexusUseDialogId}-title")" data-draggable="card-use-window">
                                            <header class="card-use-window-header" data-drag-handle title="Drag to move">
                                                <span class="card-use-window-grip" aria-hidden="true">⠿</span>
                                                <div class="card-use-window-heading">
                                                    <h2 id="@($"{NexusUseDialogId}-title")">Play Nexus card</h2>
                                                </div>
                                                <button type="button" class="icon-button card-use-window-close" data-dialog-close aria-label="Close without playing">×</button>
                                            </header>
                                            <div class="card-use-dialog">
                                                <img class="card-use-dialog-image" src="@Client.CurrentSkin.GetImageUrl(nexusCard)" alt="@Name(nexusCard)" />
                                                <div class="card-use-dialog-actions">
                                                    <NexusPlayedComponent />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>

                            @if (HasFactionInformation)
                            {
                            <section class="player-panel-section player-panel-faction-info">
                                <h3>Faction information</h3>
                                <div class="player-panel-faction-details">
                                    @if (Client.CurrentPhase > Phase.DiallingStorm && Game.HasStormPrescience(Player))
                                    {
                                        <span>Next storm: <strong>@Game.NextStormMoves</strong> sectors</span>
                                    }
                                    @if (shownPlayer.Faction == Faction.Blue && Client.CurrentPhase > Phase.BluePredicting)
                                    {
                                        <span>Prediction: <FactionComponent Diameter="24" Faction="@shownPlayer.PredictedFaction" /><SimpleNumberComponent Size="24">@shownPlayer.PredictedTurn</SimpleNumberComponent></span>
                                    }
                                    @if (shownPlayer.Faction == Faction.Green && Game.Applicable(Rule.GreenMessiah))
                                    {
                                        <span class="player-panel-faction-note">
                                            <img src="@Client.CurrentSkin.Messiah_URL" title="@Client.CurrentSkin.Describe(Concept.Messiah)" alt="" />
                                            @if (shownPlayer.TotalForcesKilledInBattle >= 7)
                                            {
                                                @(shownPlayer.MessiahAvailable ? $"{Client.CurrentSkin.Describe(Concept.Messiah)} available" : $"{Client.CurrentSkin.Describe(Concept.Messiah)} has been killed")
                                            }
                                            else
                                            {
                                                <span>Available after <SimpleNumberComponent>@(7 - shownPlayer.TotalForcesKilledInBattle)</SimpleNumberComponent> more forces are killed</span>
                                            }
                                        </span>
                                    }
                                    @if (shownPlayer.Faction == Faction.Pink && Client.CurrentPhase > Phase.BluePredicting)
                                    {
                                        <span>Ambassadors: @foreach (var ambassador in shownPlayer.Ambassadors) { <Image Shown="@ambassador" Width="24" /> }</span>
                                    }
                                    @if (shownPlayer.Faction == Faction.Cyan && Client.CurrentPhase > Phase.BluePredicting)
                                    {
                                        var textBorder = $"color:white;{Support.TextBorder(1, "#289caa")}";
                                        <div class="player-panel-terror">
                                            <div>Available terror:</div>
                                            <ul class="player-panel-terror-list">
                                                @foreach (var terror in Game.UnplacedTerrorTokens)
                                                {
                                                    <li><RichText Shown="@terror" Game="Game" Style="@textBorder" /></li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    @if (Game.CurrentMainPhase == MainPhase.ShipmentAndMove && Game.HasResourceDeckPrescience(Player) && !Game.ResourceCardDeck!.IsEmpty)
                                    {
                                        <Hoverable Popover="@Client.CurrentSkin.GetPopup(Game.ResourceCardDeck.Top!)">Resource deck top: <strong>@Name(Game.ResourceCardDeck.Top)</strong></Hoverable>
                                    }
                                </div>
                            </section>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <FactionComponent Faction="Player.Faction" />
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Player? ShownPlayer { get; set; }
    [Parameter] public bool ShowHeader { get; set; }

    private int FigureCount(Player player) =>
        player.Leaders.Count() + Math.Max(1,
            player.FaceDancers.Count > 0 ? player.FaceDancers.Count :
            !Game.AssistedNoteKeepingEnabled(Player) && player.Traitors.Count == 1 ? 1 :
            player.Traitors.Count + player.DiscardedTraitors.Count);

    private bool _collapsed = true;

    private string FactionThemeStyle =>
        $"--player-faction-color:{Client.CurrentSkin.GetFactionColor(ShownPlayer!.Faction)}";

    private string BodyStyle =>
        $"background-image:linear-gradient(rgba(27, 26, 24, 0.86), rgba(27, 26, 24, 0.94)), url('{Client.CurrentSkin.GetImageUrl(ShownPlayer!.Faction)}')";

    private List<TreacheryCard> CardsInHand
    {
        get
        {
            var cards = ShownPlayer?.TreacheryCards.ToList() ?? [];
            if (ShownPlayer != null && Game.GetCardSetAsideForBid(ShownPlayer) is { } setAsideCard)
                cards.Add(setAsideCard);
            return cards;
        }
    }

    private static readonly HashSet<Type> KarmaActionTypes =
    [
        typeof(KarmaHandSwapInitiated), typeof(KarmaShipmentPrevention), typeof(KarmaRevivalPrevention), typeof(KarmaHandSwap),
        typeof(KarmaFreeRevival), typeof(KarmaHmsMovement), typeof(KarmaMonster), typeof(KarmaWhiteBuy), typeof(KarmaBrownDiscard),
        typeof(KarmaPrescience), typeof(KarmaPinkDial)
    ];

    private bool CanUseCard(TreacheryCard card) => ActionsForCard(card).Any();

    private IEnumerable<Type> ActionsForCard(TreacheryCard card)
    {
        if (!IsOwnPanel || ShownPlayer is null || !ShownPlayer.TreacheryCards.Contains(card)) return [];

        var validKarmaCards = Karma.ValidKarmaCards(Game, ShownPlayer).ToList();
        return Client.Actions.Where(action =>
            action == typeof(Karma) ? validKarmaCards.Contains(card) :
            KarmaActionTypes.Contains(action) ? validKarmaCards.FirstOrDefault() == card :
            CardActions.CardUsedBy(action, Game, ShownPlayer) == card);
    }
    private string CardUseDialogId(TreacheryCard card) => $"{Id}-card-use-{card.Id}";

    private bool CanPlayNexus => IsOwnPanel && ShownPlayer!.Nexus != Faction.None && Client.Actions.Contains(typeof(NexusPlayed));

    private string NexusUseDialogId => $"{Id}-nexus-use";

    private void HandleCardClick(TreacheryCard card)
    {
        if (!CanUseCard(card)) PickForBattle(card);
    }

    private bool HasFactionInformation =>
        ShownPlayer is { } player
        && ((player.Faction == Faction.Blue && Client.CurrentPhase > Phase.BluePredicting)
            || (player.Faction == Faction.Green && Game.Applicable(Rule.GreenMessiah))
            || (player.Faction == Faction.Pink && Client.CurrentPhase > Phase.BluePredicting)
            || (player.Faction == Faction.Cyan && Client.CurrentPhase > Phase.BluePredicting)
            || Client.CurrentPhase > Phase.DiallingStorm && Game.HasStormPrescience(Player)
            || Game.CurrentMainPhase == MainPhase.ShipmentAndMove && Game.HasResourceDeckPrescience(Player) && !Game.ResourceCardDeck!.IsEmpty);

    private static string HandCardStyle(int index, int count)
    {
        var centeredIndex = index - (count - 1) / 2d;
        return FormattableString.Invariant($"--hand-angle:{centeredIndex * 3:0.##}deg;z-index:{index + 1}");
    }

    private void ToggleCollapsed() => _collapsed = !_collapsed;

    private bool IsOwnPanel => ShownPlayer != null && Client.Player != null && ShownPlayer == Client.Player;

    private string PickClass(object item)
    {
        if (!IsOwnPanel || !BattlePlanPicker.IsPickable(item)) return "";
        return BattlePlanPicker.IsPicked(item) ? "is-battle-pickable is-battle-picked" : "is-battle-pickable";
    }

    private string? PickTitle(object item)
    {
        if (!IsOwnPanel || !BattlePlanPicker.IsPickable(item)) return null;
        return BattlePlanPicker.IsPicked(item) ? $"Remove {Name(item)} from your battle plan" : $"Use {Name(item)} in your battle plan";
    }

    private void PickForBattle(object item)
    {
        if (IsOwnPanel) BattlePlanPicker.Pick(item);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        BattlePlanPicker.Changed += OnBattlePlanPickerChanged;
    }

    private void OnBattlePlanPickerChanged() => _ = InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        BattlePlanPicker.Changed -= OnBattlePlanPickerChanged;
        base.Dispose();
    }

    private RenderFragment ResourceStrip(Player shownPlayer) => __builder =>
    {
        <div class="player-panel-resource-strip" aria-label="Reserves">
            <div title="@Name(Concept.Resource)">
                <img src="@Client.CurrentSkin.Harvester_URL" alt="@Name(Concept.Resource)" />
                <strong>@ResourcesText</strong>
            </div>
            <div title="@Name(shownPlayer.Force)">
                <img src="@Client.CurrentSkin.GetFactionForceImageUrl(shownPlayer.Faction)" alt="@Name(shownPlayer.Force)" />
                <strong>@shownPlayer.ForcesInReserve</strong>
            </div>
            @if (shownPlayer.HasSpecialForces)
            {
                <div title="@Name(shownPlayer.SpecialForce)">
                    <img src="@Client.CurrentSkin.GetFactionSpecialForceImageUrl(shownPlayer.Faction)" alt="@Name(shownPlayer.SpecialForce)" />
                    <strong>@shownPlayer.SpecialForcesInReserve</strong>
                </div>
            }
        </div>
    };

    private string ResourcesText
    {
        get
        {
            if (ShownPlayer is null) return string.Empty;

            if (ShownPlayer.BankedResources > 0)
            {
                if (ShownPlayer.Bribes + ShownPlayer.Extortion > 0)
                {
                    if (ShownPlayer.ResourcesAfterBidding > 0)
                        return Client.CurrentSkin.Format("{0}, {1} at end of turn, {2} at end of bidding, {3} at {4}", ShownPlayer.Resources, ShownPlayer.Bribes + ShownPlayer.Extortion, ShownPlayer.ResourcesAfterBidding, ShownPlayer.BankedResources, MainPhase.Contemplate);

                    return Client.CurrentSkin.Format("{0}, {1} at {2}, {3} at {4}", ShownPlayer.Resources, ShownPlayer.Bribes + ShownPlayer.Extortion, MainPhase.Contemplate, ShownPlayer.BankedResources, MainPhase.Contemplate);
                }

                if (ShownPlayer.ResourcesAfterBidding > 0)
                    return Client.CurrentSkin.Format("{0}, {1} at end of {2}, {3} at {4}", ShownPlayer.Resources, ShownPlayer.ResourcesAfterBidding, MainPhase.Bidding, ShownPlayer.BankedResources, MainPhase.Contemplate);

                return Client.CurrentSkin.Format("{0}, {1} at {2}", ShownPlayer.Resources, ShownPlayer.BankedResources, MainPhase.Contemplate);
            }

            if (ShownPlayer.Bribes + ShownPlayer.Extortion > 0)
            {
                if (ShownPlayer.ResourcesAfterBidding > 0)
                    return Client.CurrentSkin.Format("{0}, {1} at end of turn, {2} at end of bidding", ShownPlayer.Resources, ShownPlayer.Bribes + ShownPlayer.Extortion, ShownPlayer.ResourcesAfterBidding);

                return Client.CurrentSkin.Format("{0}, {1} at {2}", ShownPlayer.Resources, ShownPlayer.Bribes + ShownPlayer.Extortion, MainPhase.Contemplate);
            }

            if (ShownPlayer.ResourcesAfterBidding > 0)
                return Client.CurrentSkin.Format("{0}, {1} at end of {2}", ShownPlayer.Resources, ShownPlayer.ResourcesAfterBidding, MainPhase.Bidding);

            return Client.CurrentSkin.Format("{0}", ShownPlayer.Resources);
        }
    }
}
