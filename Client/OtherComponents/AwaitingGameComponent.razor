@inherits GameComponent

@if (Client.InGame)
{
    <div class="ui-card ui-mb-2 ui-border-white">

        <div class="ui-card-header">Welcome to @(Client.GameName)</div>

        <div class="ui-card-body">

            <div class="ui-mt-1 ui-mb-0"><strong>Maximum number of turns:</strong> @Settings.MaximumTurns</div>

            <div class="ui-mt-1 ui-mb-0"><strong>Maximum number of players:</strong> @Settings.NumberOfPlayers</div>

            <div class="ui-mt-1 ui-mb-0">
                @foreach (var faction in Settings.AllowedFactionsInPlay)
                {
                    <FactionComponent Faction="@faction"/>
                }
            </div>
            
            <JoinedPlayersPanel/>
            
            <label class="ui-mt-1 ui-mb-0 ui-small">Core Game, Advanced Rules</label>
            <ul class="ui-mt-0 ui-mb-1">
                @foreach (var rule in Game.GetRulesInGroup(RuleGroup.CoreAdvanced, Game.ExpansionLevel))
                {
                    <li class="ui-small" style="@DetermineRuleClass(Settings.InitialRules.Contains(rule))">@Client.CurrentSkin.Describe(rule)</li>
                }
            </ul>

            <label class="ui-mt-1 ui-mb-0 ui-small">Core Game, Exceptions to Basic Rules</label>
            <ul class="ui-mt-0 ui-mb-1">
                @foreach (var rule in Game.GetRulesInGroup(RuleGroup.CoreBasicExceptions, Game.ExpansionLevel))
                {
                    <li class="ui-small" style="@DetermineRuleClass(Settings.InitialRules.Contains(rule))">@Client.CurrentSkin.Describe(rule)</li>
                }
            </ul>

            <label class="ui-mt-1 ui-mb-0 ui-small">Core Game, Exceptions to Advanced Rules</label>
            <ul class="ui-mt-0 ui-mb-1">
                @foreach (var rule in Game.GetRulesInGroup(RuleGroup.CoreAdvancedExceptions, Game.ExpansionLevel))
                {
                    <li class="ui-small" style="@DetermineRuleClass(Settings.InitialRules.Contains(rule))">@Client.CurrentSkin.Describe(rule)</li>
                }
            </ul>

            <label class="ui-mt-1 ui-mb-0 ui-small">Ixians &amp; Tleilaxu Expansion</label>
            <ul class="ui-mt-0 ui-mb-1">
                @foreach (var rule in Game.GetRulesInGroup(RuleGroup.ExpansionIxAndBtBasic, Game.ExpansionLevel))
                {
                    <li class="ui-small" style="@DetermineRuleClass(Settings.InitialRules.Contains(rule))">@Client.CurrentSkin.Describe(rule)</li>
                }
            </ul>

            <label class="ui-mt-1 ui-mb-0 ui-small">Ixians &amp; Tleilaxu Expansion, Advanced Rules</label>
            <ul class="ui-mt-0 ui-mb-1">
                @foreach (var rule in Game.GetRulesInGroup(RuleGroup.ExpansionIxAndBtAdvanced, Game.ExpansionLevel))
                {
                    <li class="ui-small" style="@DetermineRuleClass(Settings.InitialRules.Contains(rule))">@Client.CurrentSkin.Describe(rule)</li>
                }
            </ul>

            <label class="ui-mt-1 ui-mb-0 ui-small">House Rules</label>
            <ul class="ui-mt-0 ui-mb-1">
                @foreach (var rule in Game.GetRulesInGroup(RuleGroup.House, Game.ExpansionLevel))
                {
                    <li class="ui-small" style="@DetermineRuleClass(Settings.InitialRules.Contains(rule))">@Client.CurrentSkin.Describe(rule)</li>
                }
            </ul>

        </div>
    </div>
}

@code {

    private GameSettings Settings => Game.Settings;
    
    private static string DetermineRuleClass(bool applicable) => applicable ? "color:white" : "color:grey";
}
