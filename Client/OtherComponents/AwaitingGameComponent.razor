@inherits GameComponent

@if (Client.InGame)
{
    <div class="setup-layout">
        <section class="lobby-panel setup-panel setup-settings">
            <div class="lobby-panel-head">
                <div>
                    <span class="lobby-kicker">Welcome to</span>
                    <h2 class="lobby-player-name">@(Client.GameName)</h2>
                </div>
            </div>
            <div class="lobby-panel-body">
                <dl class="lobby-details">
                    <dt>Turns</dt>
                    <dd>@Settings.MaximumTurns</dd>
                    <dt>Players</dt>
                    <dd>@Settings.NumberOfPlayers</dd>
                </dl>

                <div class="lobby-section-title">Factions in play <span>@Settings.AllowedFactionsInPlay.Count</span></div>
                <div class="setup-factions">
                    @foreach (var faction in Settings.AllowedFactionsInPlay)
                    {
                        <FactionComponent Faction="@faction" Diameter="40"/>
                    }
                </div>

                <div class="setup-rules setup-rules-readonly">
                    @foreach (var (title, group) in RuleGroups)
                    {
                        var rules = Game.GetRulesInGroup(group, Game.ExpansionLevel).ToArray();
                        if (rules.Length > 0)
                        {
                            <fieldset class="setup-rule-group">
                                <legend>@title</legend>
                                <ul>
                                    @foreach (var rule in rules)
                                    {
                                        <li class="@(Settings.InitialRules.Contains(rule) ? "is-on" : "")">@Client.CurrentSkin.Describe(rule)</li>
                                    }
                                </ul>
                            </fieldset>
                        }
                    }
                </div>
            </div>
        </section>

        <section class="lobby-panel setup-panel setup-players">
            <div class="lobby-panel-head">
                <div>
                    <span class="lobby-kicker">Seats</span>
                    <h2>Players</h2>
                </div>
            </div>
            <div class="lobby-panel-body">
                <JoinedPlayersPanel/>
            </div>
        </section>
    </div>
}

@code {

    private GameSettings Settings => Game.Settings;

    private static readonly (string, RuleGroup)[] RuleGroups =
    [
        ("Core Game, Advanced Rules", RuleGroup.CoreAdvanced),
        ("Core Game, Exceptions to Basic Rules", RuleGroup.CoreBasicExceptions),
        ("Core Game, Exceptions to Advanced Rules", RuleGroup.CoreAdvancedExceptions),
        ("Ixians & Tleilaxu Expansion", RuleGroup.ExpansionIxAndBtBasic),
        ("Ixians & Tleilaxu Expansion, Advanced Rules", RuleGroup.ExpansionIxAndBtAdvanced),
        ("House Rules", RuleGroup.House)
    ];
}
