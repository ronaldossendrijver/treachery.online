@inherits GameComponent

@{
    var player = Client.Player;
    var acceptableDeals = player is null ? [] : DealAccepted.AcceptableDeals(Game, player).ToArray();
    var cancellableDeals = player is null ? [] : DealAccepted.CancellableDeals(Game, player).ToArray();
    var currentDeals = DealAccepted.CurrentDeals(Game).ToArray();
}

<div class="deals-overview">
    @if (!Client.IsObserver && (acceptableDeals.Any() || cancellableDeals.Any()))
    {
        <section class="deals-group">
            <h3>
                Offers
                @if (acceptableDeals.Length > 0)
                {
                    <span class="deal-count-badge is-incoming" title="Offers awaiting your response">@acceptableDeals.Length</span>
                }
                @if (cancellableDeals.Length > 0)
                {
                    <span class="deal-count-badge is-outgoing" title="Your offers awaiting a response">@cancellableDeals.Length</span>
                }
            </h3>
            <div class="deals-table-wrap">
                <table class="ui-table ui-table-sm">
                    <thead>
                        <tr><th scope="col">From / to</th><th scope="col">Price</th><th scope="col">Offer</th><th scope="col">Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var offer in acceptableDeals)
                        {
                            var offerToShow = offer;
                            var validity = offer.Acceptance(Faction).Validate();
                            <tr>
                                <th scope="row">
                                    <img class="deal-faction-icon" width="28" src="@Client.CurrentSkin.GetImageUrl(offer.Initiator)" alt="@Name(offer.Initiator)" />
                                </th>
                                <td>@offer.Price</td>
                                <td class="ui-text-break">@offer.GetDealDescription().ToString(Client.CurrentSkin)</td>
                                <td><button class="ui-btn ui-btn-primary ui-btn-sm" @onclick="e => Accept(offerToShow)" disabled="@(validity != null)">Accept</button></td>
                            </tr>
                        }
                        @foreach (var offer in cancellableDeals)
                        {
                            var offerToShow = offer;
                            <tr>
                                <th scope="row">
                                    <img class="deal-faction-icon" width="28" src="@Client.CurrentSkin.GetImageUrl(offer.Initiator)" alt="@Name(offer.Initiator)" />
                                </th>
                                <td>@offer.Price</td>
                                <td class="ui-text-break">@offer.GetDealDescription().ToString(Client.CurrentSkin)</td>
                                <td><button class="ui-btn ui-btn-secondary ui-btn-sm" @onclick="e => Cancel(offerToShow)">Withdraw</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (currentDeals.Any())
    {
        <section class="deals-group">
            <h3>
                Current deals
                <span class="deal-count-badge is-current">@currentDeals.Length</span>
            </h3>
            <div class="deals-table-wrap">
                <table class="ui-table ui-table-sm">
                    <thead>
                        <tr><th scope="col">Parties</th><th scope="col">Agreement</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var deal in currentDeals)
                        {
                            <tr>
                                <th scope="row" class="deal-parties">
                                    <img class="deal-faction-icon" width="28" src="@Client.CurrentSkin.GetImageUrl(deal.BoundFaction)" alt="@Name(deal.BoundFaction)" />
                                    <span aria-hidden="true">→</span>
                                    <img class="deal-faction-icon" width="28" src="@Client.CurrentSkin.GetImageUrl(deal.ConsumingFaction)" alt="@Name(deal.ConsumingFaction)" />
                                </th>
                                <td class="ui-text-break">@deal.DealContentsDescription(Game).ToString(Client.CurrentSkin)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private async Task Accept(DealOffered offered) => await Request(offered.Acceptance(Faction));

    private async Task Cancel(DealOffered offered) => await Request(offered.Cancellation());
}
