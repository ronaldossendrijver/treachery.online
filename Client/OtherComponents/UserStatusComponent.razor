@inherits GameComponent

@if (Client.UserStatus is null) return;

<details class="status-menu">
    <summary class="ui-btn @BtnTypeFromStatus(Client.UserStatus.Value) ui-btn-sm" aria-label="Change status">
        @Name(Client.UserStatus)
    </summary>
    <ul class="status-menu-options">
        @foreach (var status in Enumerations.GetValuesExceptDefault(UserStatus.None).Where(s => s != Client.UserStatus))
        {
            <li><button type="button" disabled="@_busy" @onclick="@(_ => SetUserStatus(status))">@Name(status)</button></li>
        }
    </ul>
</details>

@code 
{
    private bool _busy;
    
    private string BtnTypeFromStatus(UserStatus status) => status switch
    {
        UserStatus.None => "ui-btn-dark",
        UserStatus.Online => "ui-btn-success",
        UserStatus.Away => "ui-btn-dark",
        UserStatus.Lfg => "ui-btn-primary",
        UserStatus.Lfm => "ui-btn-primary",
        UserStatus.InGame => "ui-btn-secondary",
        _ => "ui-btn-dark",
    };


    private async Task SetUserStatus(UserStatus status)
    {
        _busy = true;
        StateHasChanged();
        await Client.RequestSetUserStatus(status);
        _busy = false;
        StateHasChanged();
    }
}