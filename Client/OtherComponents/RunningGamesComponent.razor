@inherits GameComponent

<section class="lobby-panel lobby-panel-active">
    <header class="lobby-panel-head">
        <div>
            <span class="lobby-kicker">Struggles for Arrakis</span>
            <h2>Active games</h2>
        </div>
    </header>
    <div class="lobby-panel-body">

        @if (!Client.ActiveGamesWithoutOpenSeats.Any() && !Client.ActiveGamesWithOpenSeats.Any() && !Client.ScheduledGames.Any())
        {
            <div class="lobby-empty">
                <img src="art/worm.gif" alt=""/>
                <p>The desert is quiet. No games are running right now.</p>
                <small>Create a game under <strong>Your games</strong> and invite others to join.</small>
            </div>
        }
        else
        {
            if (Client.ActiveGamesWithOpenSeats.Any())
            {
                <h3 class="lobby-section-title">Open seats <span>you can join</span></h3>
                <div class="lobby-game-list">
                    @foreach (var av in Client.ActiveGamesWithOpenSeats)
                    {
                        Passwords.TryAdd(av.GameId, string.Empty);
                        JoinErrors.TryAdd(av.GameId, string.Empty);
                        var showMax = av.Phase == Phase.AwaitingPlayers && (!av.RequiresLoad || av.HasDetails);
                        var showBots = av.Phase != Phase.AwaitingPlayers || av.RequiresLoad;

                        <article class="lobby-game @(IsIdle(av, 15) ? "is-idle" : "")">
                            <div class="lobby-game-main">
                                <div class="lobby-game-name">@av.Name</div>
                                <div class="lobby-game-meta">
                                    @PlayerChips(av, showMax, showBots)
                                    @if (av.HasDetails && av.Phase == Phase.AwaitingPlayers)
                                    {
                                        <span>@Name(av.Ruleset), @av.MaxTurns turns, not yet started</span>
                                    }
                                    else if (av.HasDetails)
                                    {
                                        <span>@Name(av.Ruleset), Turn @av.Turn: @Name(av.MainPhase)</span>
                                    }
                                </div>
                                @if (av.HasDetails && av.Phase != Phase.AwaitingPlayers)
                                {
                                    @Factions(av.FactionsInPlay)
                                }
                            </div>
                            <div class="lobby-game-actions">
                                @if (av.RequiresLoad && !av.YouAreIn(Client.UserId!.Value))
                                {
                                    @if (av.HasPassword)
                                    {
                                        <input class="lobby-input lobby-input-sm" @bind="Passwords[av.GameId]" maxlength="24" placeholder="Password" aria-label="Game password"/>
                                    }
                                    <CommandButton Small OnClick="@(_ => JoinGameAsObserver(av.GameId, Passwords[av.GameId]))" Title="Open saved game" MarginClass="">Open</CommandButton>
                                }
                                else if (!av.YouAreIn(Client.UserId!.Value))
                                {
                                    if (av.HasPassword)
                                    {
                                        <input class="lobby-input lobby-input-sm" @bind="Passwords[av.GameId]" maxlength="24" placeholder="Password" aria-label="Game password"/>
                                    }
                                    if (av.Phase == Phase.AwaitingPlayers)
                                    {
                                        <CommandButton Small OnClick="@(_ => JoinGameAsPlayer(av.GameId, Passwords[av.GameId], -1))" Title="Join game" MarginClass="">Join</CommandButton>
                                    }
                                    else if (av.Phase != Phase.SelectingFactions)
                                    {
                                        foreach (var availableSeat in av.AvailableSeats)
                                        {
                                            <CommandButton
                                                Small
                                                Class="ui-btn-primary lobby-seat-btn"
                                                OnClick="@(_ => JoinGameAsPlayer(av.GameId, Passwords[av.GameId], availableSeat.Seat))"
                                                MarginClass=""
                                                Title="@JoinButtonTitle(availableSeat.Faction)">
                                                <FactionComponent Faction="@availableSeat.Faction" Diameter="22"/>
                                            </CommandButton>
                                        }
                                    }
                                    <CommandButton Small Class="ui-btn-secondary" OnClick="@(_ => JoinGameAsObserver(av.GameId, Passwords[av.GameId]))" Title="Observe game" MarginClass="">👁 Observe</CommandButton>
                                }
                                else
                                {
                                    <CommandButton Small OnClick="@(_ => JoinGameAsPlayer(av.GameId, string.Empty, av.YourCurrentSeat(Client.UserId!.Value)))" Title="Resume game" MarginClass="">▶ Resume</CommandButton>
                                }
                                @JoinError(av.GameId)
                            </div>
                        </article>
                    }
                </div>
            }
            if (Client.ScheduledGames.Any())
            {
                <h3 class="lobby-section-title">Scheduled games</h3>
                <div class="lobby-game-list">
                    @foreach (var game in Client.ScheduledGames)
                    {
                        <article class="lobby-game lobby-game-scheduled">
                            <div class="lobby-game-date" title="Starts at (your local time)">
                                <strong>@game.DateTime.ToLocalTime().ToString("dd-MM")</strong>
                                <span>@game.DateTime.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                            <div class="lobby-game-main">
                                <div class="lobby-game-name">@game.CreatorName</div>
                                <div class="lobby-game-meta">
                                    <span>@Name(game.Ruleset), @game.NumberOfPlayers players, @game.MaximumTurns turns@(game.AllowedFactionsInPlay.Count == 12 ? " (all factions)" : "")</span>
                                </div>
                                @if (game.AllowedFactionsInPlay.Count != 12)
                                {
                                    @Factions(game.AllowedFactionsInPlay)
                                }
                                <div class="lobby-subscribers">
                                    @foreach (var p in game.Subscribers.Where(u => u.Value != SubscriptionType.DontParticipate))
                                    {
                                        <span class="lobby-chip">
                                            <span class="lobby-player-name">@game.SubscriberNames.GetValueOrDefault(p.Key, "?")</span>
                                            <em>@Name(p.Value)</em>
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="lobby-game-actions">
                                <SubscribeComponent ScheduledGame="@game"/>
                            </div>
                        </article>
                    }
                </div>
            }
            if (Client.ActiveGamesWithoutOpenSeats.Any())
            {
                <h3 class="lobby-section-title">In progress <span>no open seats</span></h3>
                <div class="lobby-game-list">
                    @foreach (var av in Client.ActiveGamesWithoutOpenSeats)
                    {
                        Passwords.TryAdd(av.GameId, string.Empty);
                        JoinErrors.TryAdd(av.GameId, string.Empty);

                        <article class="lobby-game @(IsIdle(av, 20) ? "is-idle" : "")">
                            <div class="lobby-game-main">
                                <div class="lobby-game-name">@av.Name</div>
                                <div class="lobby-game-meta">
                                    @PlayerChips(av, false, true)
                                    @if (av.HasDetails && av.Phase == Phase.AwaitingPlayers)
                                    {
                                        <span>@Name(av.Ruleset), @av.MaxTurns turns</span>
                                    }
                                    else if (av.HasDetails)
                                    {
                                        <span>@Name(av.Ruleset), Turn @av.Turn: @Name(av.MainPhase)</span>
                                    }
                                </div>
                                @if (av.HasDetails && av.Phase != Phase.AwaitingPlayers)
                                {
                                    @Factions(av.FactionsInPlay)
                                }
                            </div>
                            <div class="lobby-game-actions">
                                @if (av.RequiresLoad && !av.YouAreIn(Client.UserId!.Value))
                                {
                                    @if (av.HasPassword)
                                    {
                                        <input class="lobby-input lobby-input-sm" @bind="Passwords[av.GameId]" maxlength="24" placeholder="Password" aria-label="Game password"/>
                                    }
                                    <CommandButton Small OnClick="@(_ => JoinGameAsObserver(av.GameId, Passwords[av.GameId]))" Title="Open saved game" MarginClass="">Open</CommandButton>
                                }
                                else if (!av.YouAreIn(Client.UserId!.Value))
                                {
                                    <CommandButton Small Class="ui-btn-secondary" OnClick="@(_ => JoinGameAsObserver(av.GameId, Passwords[av.GameId]))" Title="Observe game" MarginClass="">👁 Observe</CommandButton>
                                }
                                else
                                {
                                    <CommandButton Small OnClick="@(_ => JoinGameAsPlayer(av.GameId, string.Empty, av.YourCurrentSeat(Client.UserId!.Value)))" Title="Resume game" MarginClass="">▶ Resume</CommandButton>
                                }
                                @JoinError(av.GameId)
                            </div>
                        </article>
                    }
                </div>
            }
        }
    </div>
</section>
@code {

    private Dictionary<string, string> JoinErrors { get; } = new();
    private Dictionary<string, string> Passwords { get; } = new();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            StartRedrawCycle(IGameService.HeartbeatDelay);
        }
    }

    private async Task JoinGameAsPlayer(string gameId, string password, int seat)
    {
        JoinErrors[gameId] = await Client.RequestJoinGame(gameId, password, seat) ?? string.Empty;
    }

    private async Task JoinGameAsObserver(string gameId, string password)
    {
        JoinErrors[gameId] = await Client.RequestObserveGame(gameId, password) ?? string.Empty;
    }

    private string JoinButtonTitle(Faction faction) => $"Join game as {Name(faction)}";

    private static bool IsIdle(GameInfo av, int minutes) =>
        av.LastActivity != null && DateTimeOffset.Now.Subtract((DateTimeOffset)av.LastActivity).TotalMinutes > minutes;

    private RenderFragment PlayerChips(GameInfo av, bool showMax, bool showBots) => __builder =>
    {
        <span class="lobby-chip" title="Players">
            <UserIcon Size="16" Title="Players" MarginClass=""/>@av.NrOfPlayers@(showMax ? $"/{av.MaxPlayers}" : "")
        </span>
        @if (showBots && av.NrOfBots > 0 && (!av.RequiresLoad || av.HasDetails))
        {
            <span class="lobby-chip" title="Bots"><BotIcon Size="14" Title="Bots" MarginClass=""/>@av.NrOfBots</span>
        }
    };

    private RenderFragment Factions(IEnumerable<Faction> factions) => __builder =>
    {
        <div class="lobby-game-factions">
            @foreach (var f in factions.Where(f => f != Faction.None))
            {
                <Image Shown="f" Width="20" NoShadow/>
            }
        </div>
    };

    private RenderFragment JoinError(string gameId) => __builder =>
    {
        if (!string.IsNullOrEmpty(JoinErrors[gameId]))
        {
            <div class="lobby-error" role="alert">@JoinErrors[gameId]</div>
        }
    };
}
