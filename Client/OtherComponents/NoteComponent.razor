@inherits GameComponent

<div @ref="@_element" class="tracker">

    <nav class="tracker-nav" role="tablist" aria-label="Factions">
        @foreach (var p in Players)
        {
            <button type="button" role="tab" class="tracker-tab @(p == Shown ? "is-active" : "")" aria-selected="@(p == Shown)" @onclick="@(_ => Toggle(p))">
                <img width="28" height="28" src="@Client.CurrentSkin.GetFactionTableImageUrl(p.Faction)" alt=""/>
                <span class="tracker-tab-label">@Client.CurrentSkin.Describe(p.Faction)</span>
                <span class="tracker-tab-count" title="Treachery cards">@Game.CardsOwnedBy(p).Count()</span>
            </button>
        }
    </nav>

    <div class="tracker-pane" role="tabpanel">

        @if (Shown is { } shown)
        {
            <header class="tracker-pane-head">
                <img width="44" height="44" src="@Client.CurrentSkin.GetFactionTableImageUrl(shown.Faction)" alt=""/>
                <div>
                    <div class="lobby-kicker">Mentat</div>
                    <h3>@Client.CurrentSkin.Describe(shown.Faction)</h3>
                </div>
            </header>

            <section class="tracker-section">
                <div class="tracker-section-title">Status</div>
                <div class="tracker-stats">
                    <div class="tracker-stat" title="@Client.CurrentSkin.Describe(Concept.Resource)">
                        <img width="24" height="24" src="@Client.CurrentSkin.Harvester_URL" alt=""/>
                        <div>
                            <strong>@shown.Resources</strong>
                            <span>@ResourcesText(shown)</span>
                        </div>
                    </div>

                    <div class="tracker-stat" title="@Client.CurrentSkin.Describe(shown.Force)">
                        <img width="24" height="24" src="@Client.CurrentSkin.GetFactionForceImageUrl(shown.Faction)" alt=""/>
                        <div>
                            <strong>@shown.ForcesInReserve</strong>
                            <span>in reserve</span>
                        </div>
                    </div>

                    @if (shown.HasSpecialForces)
                    {
                        <div class="tracker-stat" title="@Client.CurrentSkin.Describe(shown.SpecialForce)">
                            <img width="24" height="24" src="@Client.CurrentSkin.GetFactionSpecialForceImageUrl(shown.Faction)" alt=""/>
                            <div>
                                <strong>@shown.SpecialForcesInReserve</strong>
                                <span>in reserve</span>
                            </div>
                        </div>
                    }

                    <div class="tracker-stat" title="Victory points">
                        <span class="tracker-stat-glyph" aria-hidden="true">★</span>
                        <div>
                            <strong>@Game.NumberOfVictoryPoints(shown, true)</strong>
                            <span>victory points</span>
                        </div>
                    </div>

                    @if (shown.Faction == Faction.Green && Game.Applicable(Rule.GreenMessiah))
                    {
                        <div class="tracker-stat" title="@Client.CurrentSkin.Describe(Concept.Messiah)">
                            <img width="24" height="24" src="@Client.CurrentSkin.Messiah_URL" alt=""/>
                            <div>
                                <strong>@MessiahStatus(shown)</strong>
                                <span>@MessiahDetail(shown)</span>
                            </div>
                        </div>
                    }
                </div>
            </section>

            var cards = Game.CardsOwnedBy(shown).ToList();

            <section class="tracker-section">
                <div class="tracker-section-title">Treachery cards <span>@cards.Count / @shown.MaximumNumberOfCards owned · @cards.Count(IsKnownCard) known</span></div>
                @if (cards.Count > 0)
                {
                    <div class="tracker-cards">
                        @foreach (var c in cards)
                        {
                            if (IsKnownCard(c))
                            {
                                <div class="tracker-card is-static">
                                    <Image Shown=c />
                                </div>
                            }
                            else
                            {
                                <div class="tracker-card is-static" title="Unknown">
                                    <img src="@Client.CurrentSkin.CardBack_TreacheryCard_URL" alt="Unknown card"/>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <span class="tracker-empty">They don't own any treachery cards.</span>
                }
            </section>

            @if (shown.RevealedTraitors.Count > 0)
            {
                <section class="tracker-section">
                    <div class="tracker-section-title">Revealed @(shown.RevealedTraitors.Count > 1 ? "traitors" : "traitor")</div>
                    <div class="tracker-heroes">
                        @foreach (var h in shown.RevealedTraitors)
                        {
                            <Image Shown=@h Width=64/>
                        }
                    </div>
                </section>
            }

            @if (shown.RevealedFaceDancers.Count > 0)
            {
                <section class="tracker-section">
                    <div class="tracker-section-title">Revealed face dancers</div>
                    <div class="tracker-heroes">
                        @foreach (var h in shown.RevealedFaceDancers)
                        {
                            <Image Shown=@h Width=64/>
                        }
                    </div>
                </section>
            }
        }
        else
        {
            <p class="tracker-empty tracker-pick-hint">Select a faction to view what is publicly known about it.</p>
        }

        <details class="tracker-help">
            <summary>About the notekeeping assistant</summary>
            <p>The Mentat keeps track of publicly available information about each opponent: their @Client.CurrentSkin.Describe(Concept.Resource), forces in reserve, victory points, the treachery cards they own (cards you know are shown face up) and any traitors or face dancers they revealed.</p>
        </details>
    </div>

</div>

@code {

    private Player? _shown;
    private ElementReference _element;
    private bool _popoversNeedUpdate = true;

    private Player? Shown => _shown is not null && Game.Players.Contains(_shown) ? _shown : Players.FirstOrDefault();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_popoversNeedUpdate)
        {
            _popoversNeedUpdate = false;
            await Browser.RefreshPopovers(_element);
        }
    }

    private IEnumerable<Player> Players => Game.Players.Where(p => p != Client.Player).OrderBy(p => Name(p.Faction));

    private void Toggle(Player toShow)
    {
        _shown = toShow;
        _popoversNeedUpdate = true;
    }

    private bool IsKnownCard(TreacheryCard c) => Client.Player?.KnownCards.Contains(c) ?? false;

    private string MessiahStatus(Player p)
    {
        if (p.TotalForcesKilledInBattle < 7)
        {
            return "Not yet";
        }

        return p.MessiahAvailable ? "Available" : "Dead";
    }

    private string MessiahDetail(Player p) => p.TotalForcesKilledInBattle < 7
        ? Client.CurrentSkin.Format("{0} after {1} more forces are killed", Concept.Messiah, 7 - p.TotalForcesKilledInBattle)
        : Client.CurrentSkin.Describe(Concept.Messiah);

    private string ResourcesText(Player p)
    {
        if (p.Bribes > 0)
        {
            return p.ResourcesAfterBidding > 0
                ? Client.CurrentSkin.Format("{0} at end of turn, {1} at end of bidding", p.Bribes, p.ResourcesAfterBidding)
                : Client.CurrentSkin.Format("{0} at {1}", p.Bribes, MainPhase.Contemplate);
        }

        return p.ResourcesAfterBidding > 0
            ? Client.CurrentSkin.Format("{0} at end of {1}", p.ResourcesAfterBidding, MainPhase.Bidding)
            : Client.CurrentSkin.Describe(Concept.Resource);
    }
}
