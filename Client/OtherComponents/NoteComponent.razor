@inherits GameComponent

<div @ref="@_element" class="ui-card ui-mb-2">

    <div class="ui-card-header" @onclick="@(_ => _collapsed = !_collapsed)" style="cursor:pointer">
        Mentat: Notekeeping Assistant
        <CollapseButton Collapsed="@_collapsed" />
    </div>

    @if (!_collapsed) {
        <div class="ui-card-body">

            <div class="ui-mb-1">

                @foreach (var p in Players.Where(p => p != Client.Player))
                {
                    <button class="ui-btn @ButtonStyle(p) ui-p-1" @onclick="@(_ => Toggle(p))" title="@Client.CurrentSkin.Describe(p.Faction)">
                        <img class="ui-img-fluid" width="29" height="29" src="@Client.CurrentSkin.GetFactionTableImageUrl(p.Faction)" alt="@Client.CurrentSkin.Describe(p.Faction)"/>
                    </button>
                }

            </div>

            @if (_shown is Player shown)
            {
                <div class="ui-row ui-m-0">

                    <!-- Resources -->
                    <div class="ui-col ui-col-auto ui-ps-0">
                        <img class="ui-img-fluid ui-m-0 ui-p-0" width="24" height="24" src="@Client.CurrentSkin.Harvester_URL" title="@Client.CurrentSkin.Describe(Concept.Resource)" alt=""/><strong>&nbsp;@ResourcesText(shown)</strong>
                    </div>

                    <!-- Forces -->
                    <div class="ui-col ui-col-auto ui-ps-0">
                        <img class="ui-img-fluid ui-m-0 ui-p-0" width="24" height="24" src="@Client.CurrentSkin.GetFactionForceImageUrl(shown.Faction)" title="@Client.CurrentSkin.Describe(shown.Force)" alt=""/><strong>&nbsp;@shown.ForcesInReserve</strong>
                    </div>

                    <!-- Special Forces -->
                    @if (shown.HasSpecialForces)
                    {
                        <div class="ui-col ui-col-auto ui-ps-0">
                            <img class="ui-img-fluid ui-m-0 ui-p-0" width="24" height="24" src="@Client.CurrentSkin.GetFactionSpecialForceImageUrl(shown.Faction)" title="@Client.CurrentSkin.Describe(shown.SpecialForce)" alt=""/><strong>&nbsp;@shown.SpecialForcesInReserve</strong>
                        </div>
                    }

                </div>

                var cards = Game.CardsOwnedBy(shown).ToList();

                if (cards.Count > 0)
                {
                    <div>Treachery cards</div>
                    <div class="ui-row ui-row-cols-4 ui-m-0">

                        @foreach (var c in cards)
                        {
                            var isKnown = IsKnownCard(c);
                            var popover = isKnown ? Client.CurrentSkin.GetPopup(c) : "<div class='ui-p-1 ui-small' style='color:black;background-color:white;border: 1px solid black;'>Unknown</div>";

                            <Hoverable Class="ui-card ui-border-0 ui-p-1" Popover=@popover>

                                @if (IsKnownCard(c))
                                {
                                    <img src="@Client.CurrentSkin.GetImageUrl(c)" class="ui-img-fluid" alt="@Client.CurrentSkin.Describe(c)" />
                                }
                                else
                                {
                                    <img src="@Client.CurrentSkin.CardBack_TreacheryCard_URL" class="ui-img-fluid" alt="Unknown" />
                                }

                            </Hoverable>
                        }

                    </div>
                }
                else
                {
                    <div>They don't own any Treachery cards</div>
                }

                if (shown.RevealedTraitors.Count > 0)
                {
                    <div class="ui-mt-1">@(shown.RevealedTraitors.Count > 1 ? "Revealed Traitors" : "Revealed Traitor")</div>
                    <div class="ui-row ui-row-cols-4 ui-m-0">
                        @foreach (var c in shown.RevealedTraitors)
                        {
                            <Image Class="ui-img-fluid ui-pe-1" Shown=@c Width=60/>
                        }
                    </div>
                }

                if (shown.RevealedFaceDancers.Count > 0)
                {
                    <div class="ui-mt-1">Revealed Face Dancers</div>
                    <div class="ui-row ui-row-cols-4 ui-m-0">
                        @foreach (var c in shown.RevealedFaceDancers)
                        {
                            <Image Class="ui-img-fluid ui-pe-1" Shown=@c Width=60/>
                        }
                    </div>
                }

                <div>Current victory points: <strong>@Game.NumberOfVictoryPoints(shown, true)</strong></div>

                if (shown.Faction == Faction.Green && Game.Applicable(Rule.GreenMessiah))
                {
                    if (shown.TotalForcesKilledInBattle >= 7)
                    {
                        if (shown.MessiahAvailable)
                        {
                            <div><img class="ui-img-fluid ui-m-0 ui-p-0" width="32" height="32" src="@Client.CurrentSkin.Messiah_URL" title="@Client.CurrentSkin.Describe(Concept.Messiah)" alt=""/> is available.</div>
                        }
                        else
                        {
                            <div><img class="ui-img-fluid ui-m-0 ui-p-0" width="32" height="32" src="@Client.CurrentSkin.Messiah_URL" title="@Client.CurrentSkin.Describe(Concept.Messiah)" alt=""/> is dead.</div>
                        }
                    }
                    else
                    {
                        <div><img class="ui-img-fluid ui-m-0 ui-p-0" width="32" height="32" src="@Client.CurrentSkin.Messiah_URL" title="@Client.CurrentSkin.Describe(Concept.Messiah)" alt=""/> available after <SimpleNumberComponent>@(7 - shown.TotalForcesKilledInBattle)</SimpleNumberComponent> more forces are killed.</div>
                    }
                }
            }

        </div>
    }

</div>

@code {

    private object? _shown;
    private ElementReference _element;
    private bool _popoversNeedUpdate = true;
    private bool _collapsed = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_popoversNeedUpdate)
        {
            _popoversNeedUpdate = false;
            await Browser.RefreshPopovers(_element);
        }
    }

    private IEnumerable<Player> Players => Game.Players.OrderBy(p => Name(p.Faction));
    
    private void Toggle(object toShow)
    {
        _shown = toShow == _shown ? null : toShow;
        _popoversNeedUpdate = true;
    }

    private bool IsKnownCard(TreacheryCard c) => Client.Player?.KnownCards.Contains(c) ?? false;

    private string ButtonStyle(object o) => o == _shown ? "ui-btn-primary" : "ui-btn-outline-primary";

    private string ResourcesText(Player p)
    {
        if (p.Bribes > 0)
        {
            return p.ResourcesAfterBidding > 0 
                ? Client.CurrentSkin.Format("{0}, {1} at end of turn, {2} at end of bidding", p.Resources, p.Bribes, p.ResourcesAfterBidding) 
                : Client.CurrentSkin.Format("{0}, {1} at {2}", p.Resources, p.Bribes, MainPhase.Contemplate);
        }

        return p.ResourcesAfterBidding > 0 
            ? Client.CurrentSkin.Format("{0}, {1} at end of {2}", p.Resources, p.ResourcesAfterBidding, MainPhase.Bidding) 
            : Client.CurrentSkin.Format("{0}", p.Resources);
    }
}
