@inherits GameComponent;

@if (Client.Game != null && _flashes.Count > 0)
{
    var totalCount = _flashes.Sum(f => f.Items.Count);
    <div class="flash-stage" aria-live="polite">
        @foreach (var flash in _flashes)
        {
            <div @key="flash.Id" class="flash-panel" role="button" tabindex="0" title="Click to dismiss"
                 style="--flash-duration:@(flash.Time)ms;--flash-count:@totalCount"
                 @onclick="() => Hide(flash)" @onkeydown="e => OnKeyDown(e, flash)">
                <div class="flash-items">
                    @for (var i = 0; i < flash.Items.Count; i++)
                    {
                        var item = flash.Items[i];
                        <figure class="flash-item @(IsRound(item.ToShow!) ? "is-round" : "is-card")" style="--flash-index:@i">
                            <div class="flash-item-frame">
                                <img src="@Client.CurrentSkin.GetImageUrl(item.ToShow!)" alt="@Name(item.ToShow)" />
                            </div>
                            @if (item.Message != null)
                            {
                                <figcaption class="flash-caption"><ExpressionComponent Game="Game" Expression="@item.Message.Expression" Size="20" /></figcaption>
                            }
                        </figure>
                    }
                </div>
                <div class="flash-timer" aria-hidden="true"></div>
            </div>
        }
    </div>
}

@code {

    private sealed record ActiveFlash(int Id, List<FlashInfo> Items, int Time);

    private readonly List<ActiveFlash> _flashes = [];
    private int _flashId;
    private int _afterEventId = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await DetectFlash();
    }

    protected override void Redraw() => _ = InvokeAsync(DetectFlash);

    // Called whenever the game is updated: starts a new flash when the latest event produced something to show.
    // Each flash keeps a snapshot of its items and its own timer, so later game updates never cut it short.
    private async Task DetectFlash()
    {
        if (Client.Game == null)
        {
            _flashes.Clear();
            StateHasChanged();
            return;
        }

        if (Game.EventCount == _afterEventId)
        {
            StateHasChanged();
            return;
        }

        _afterEventId = Game.EventCount;

        var items = Client.Status?.FlashInfo.Where(i => i.ToShow != null).ToList() ?? [];
        if (items.Count == 0)
        {
            StateHasChanged();
            return;
        }

        var flash = new ActiveFlash(++_flashId, items, 5000 + items.Count * 1000);
        _flashes.Add(flash);
        StateHasChanged();

        await Task.Delay(flash.Time);
        Hide(flash);
    }

    private static bool IsRound(object toShow) => toShow is Treachery.Shared.Faction or Leader or Messiah;

    private void OnKeyDown(KeyboardEventArgs e, ActiveFlash flash)
    {
        if (e.Key is "Enter" or " " or "Escape") Hide(flash);
    }

    private void Hide(ActiveFlash flash)
    {
        if (_flashes.Remove(flash)) StateHasChanged();
    }
}