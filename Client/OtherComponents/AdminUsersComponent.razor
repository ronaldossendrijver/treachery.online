<section class="lobby-panel">
    <div class="lobby-panel-head">
        <div>
            <span class="lobby-kicker">@Info.Users.Count accounts</span>
            <h2>Users</h2>
        </div>
    </div>
    <div class="lobby-panel-body">
        <div class="admin-stats">
            <div><strong>@Info.UsersByUserTokenCount</strong><span>Users by token</span></div>
            <div><strong>@Info.GamesByGameIdCount</strong><span>Games by id</span></div>
            <div><strong>@Info.Users.Count</strong><span>Total users</span></div>
            <div><strong>@Info.ConnectionInfoByUserIdCount</strong><span>Connections</span></div>
        </div>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Last login</th>
                    <th class="admin-actions-col">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in _rows)
                {
                    var user = row.User;
                    <tr @key="user.Id">
                        <td data-label="Id">@user.Id</td>
                        <td data-label="Username" class="admin-strong">@user.Username</td>
                        <td data-label="Email">@user.Email</td>
                        <td data-label="Last login" class="admin-nowrap">@row.LastLogin</td>
                        <td data-label="Actions" class="admin-actions">
                            <button class="ui-btn ui-btn-danger ui-btn-sm" @onclick="@(() => OnDelete.InvokeAsync(user))">Delete</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {

    [Parameter, EditorRequired] public AdminInfo Info { get; set; } = null!;
    [Parameter] public EventCallback<UserInfo> OnDelete { get; set; }

    private AdminInfo? _renderedInfo;
    private bool _dirty;
    private (UserInfo User, string LastLogin)[] _rows = [];

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Info, _renderedInfo))
            return;

        _renderedInfo = Info;
        _rows = Info.Users
            .Select(u => (u, u.LastLogin != default ? u.LastLogin.LocalDateTime.ToString("yyyy-MM-dd HH:mm") : string.Empty))
            .ToArray();
        _dirty = true;
    }

    // Only re-render when a new AdminInfo was retrieved; avoids re-rendering a large user list on every server heartbeat.
    protected override bool ShouldRender()
    {
        var result = _dirty;
        _dirty = false;
        return result;
    }
}
