@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@inject IGameService GameService

@code {
    private DotNetObjectReference<ClientErrorCapture>? _reference;
    private bool _started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _reference = DotNetObjectReference.Create(this);
        try
        {
            await JavaScript.InvokeVoidAsync("treacheryErrorLogging.start", _reference);
            _started = true;
        }
        catch (JSException exception)
        {
            Support.Log($"Unable to start client error capture: {exception}");
        }
    }

    [JSInvokable]
    public Task ReportClientError(
        string source,
        string message,
        string details,
        string url,
        string userAgent,
        int? lineNumber,
        int? columnNumber)
    {
        return GameService.ReportClientError(new ClientErrorReport
        {
            Source = source,
            Message = message,
            Details = details,
            Url = url,
            UserAgent = userAgent,
            LineNumber = lineNumber,
            ColumnNumber = columnNumber
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_reference == null)
            return;

        try
        {
            if (_started)
                await JavaScript.InvokeVoidAsync("treacheryErrorLogging.stop");
        }
        finally
        {
            _reference.Dispose();
        }
    }
}
