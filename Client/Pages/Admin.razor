@page "/admin/"

@using Treachery.Client.OtherComponents
@using System.Globalization
@using System.Threading
@implements IDisposable

@if (!Client.IsConnected || !Client.LoggedIn)
{
    <div class="login-screen">
        <video class="login-video" autoplay muted loop playsinline preload="auto" poster="art/planet.png" aria-hidden="true" tabindex="-1">
            <source src="art/planet.mp4" type="video/mp4"/>
        </video>
        <div class="login-dust" aria-hidden="true"></div>
        <div class="login-vignette" aria-hidden="true"></div>
        <main class="login-stage">
            <section class="login-hero" aria-label="treachery.online administration">
                <h1 class="login-sr-only">treachery.online administration</h1>
            </section>
            <section class="login-panel">
                @if (!Client.IsConnected)
                {
                    <div class="login-connecting" role="status">
                        <img src="art/worm.gif" alt=""/>
                        <strong>Not connected</strong>
                        <span>Waiting for the server…</span>
                    </div>
                }
                else
                {
                    <LoginComponent/>
                }
            </section>
        </main>
    </div>
}
else 
{
    <div class="lobby-screen admin-screen">
        <div class="lobby-ambient" aria-hidden="true"></div>
        <header class="lobby-header">
            <video class="lobby-logo" autoplay muted loop playsinline preload="auto" poster="art/planet.png" aria-hidden="true" tabindex="-1">
                <source src="art/planet.mp4" type="video/mp4"/>
            </video>
            <div class="lobby-greeting">
                <span class="lobby-kicker">Administration</span>
                <h1>Server control</h1>
                <p>Monitor running games, users and errors, and manage maintenance and persisted state.</p>
            </div>
        </header>
        <main class="lobby-grid admin-grid">
            <div class="admin-main">
                <section class="lobby-panel">
                    <div class="lobby-panel-head">
                        <div>
                            <span class="lobby-kicker">@FilteredGames.Count() shown</span>
                            <h2>Running games</h2>
                        </div>
                    </div>
                    <div class="lobby-panel-body">
                        <div class="admin-filters">
                            <label class="lobby-field" for="gameUsernameFilter">
                                <span>Username</span>
                                <input id="gameUsernameFilter" class="lobby-input" @bind="@GameUsernameInput"/>
                            </label>
                            <label class="lobby-field" for="gameTimeFromFilter">
                                <span>Activity from</span>
                                <input id="gameTimeFromFilter" type="datetime-local" class="lobby-input" value="@GameTimeFromInput" @onchange="@(e => GameTimeFromInput = e.Value?.ToString() ?? string.Empty)"/>
                            </label>
                            <label class="lobby-field" for="gameTimeToFilter">
                                <span>Activity to</span>
                                <input id="gameTimeToFilter" type="datetime-local" class="lobby-input" value="@GameTimeToInput" @onchange="@(e => GameTimeToInput = e.Value?.ToString() ?? string.Empty)"/>
                            </label>
                            <button class="ui-btn ui-btn-primary admin-filter-btn" @onclick="ApplyGameFilter">Filter</button>
                        </div>
                        <div class="admin-table-wrap">
                            <table class="admin-table">
                                <thead>
                                <tr>
                                    <th>Game</th>
                                    <th>Creator</th>
                                    <th>Created</th>
                                    <th>Last activity</th>
                                    <th class="admin-actions-col">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var av in FilteredGames)
                                {
                                    var idle = av.LastActivity != null && DateTimeOffset.Now.Subtract((DateTimeOffset)av.LastActivity).TotalMinutes > 20;
                                    <tr class="@(idle ? "is-idle" : "")">
                                        <td data-label="Game" class="admin-strong">@av.Name</td>
                                        <td data-label="Creator">@av.CreatorUsername</td>
                                        <td data-label="Created">@av.CreationDate.LocalDateTime</td>
                                        <td data-label="Last activity">@av.LastActivity?.LocalDateTime</td>
                                        <td data-label="Actions" class="admin-actions">
                                            <button class="ui-btn ui-btn-secondary ui-btn-sm lobby-icon-btn" title="Download savegame"
                                                    aria-label="Download savegame" @onclick="@(_ => Download(av))">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                                    <path d="M8 1a.75.75 0 0 1 .75.75v7.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V1.75A.75.75 0 0 1 8 1zM2.75 12a.75.75 0 0 1 .75.75v.5h9v-.5a.75.75 0 0 1 1.5 0V14a.75.75 0 0 1-.75.75h-10.5A.75.75 0 0 1 2 14v-1.25a.75.75 0 0 1 .75-.75z"/>
                                                </svg>
                                            </button>
                                            <button class="ui-btn ui-btn-secondary ui-btn-sm" @onclick="@(_ => Close(av))">Close</button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            @if (!FilteredGames.Any())
                            {
                                <p class="admin-empty">No games match these filters.</p>
                            }
                        </div>
                    </div>
                </section>

                <section class="lobby-panel">
                    <div class="lobby-panel-head">
                        <div>
                            <h2>Error log</h2>
                        </div>
                    </div>
                    <div class="lobby-panel-body">
                        <div class="admin-filters">
                            <label class="lobby-field" for="errorLogVersion">
                                <span>Version</span>
                                <input id="errorLogVersion" type="number" class="lobby-input" @bind="ErrorLogVersion"/>
                            </label>
                            <label class="lobby-field" for="errorLogFrom">
                                <span>From</span>
                                <input id="errorLogFrom" type="datetime-local" class="lobby-input" value="@ErrorLogFromInput" @onchange="@(e => ErrorLogFromInput = e.Value?.ToString() ?? string.Empty)"/>
                            </label>
                            <label class="lobby-field" for="errorLogTo">
                                <span>To</span>
                                <input id="errorLogTo" type="datetime-local" class="lobby-input" value="@ErrorLogToInput" @onchange="@(e => ErrorLogToInput = e.Value?.ToString() ?? string.Empty)"/>
                            </label>
                            <button class="ui-btn ui-btn-primary admin-filter-btn" @onclick="LoadErrorLog">Filter</button>
                        </div>
                        <div class="admin-table-wrap">
                            <table class="admin-table admin-error-table">
                                <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Version</th>
                                    <th>Source</th>
                                    <th>Savegame</th>
                                    <th>User</th>
                                    <th class="admin-wide-col">Message</th>
                                    <th class="admin-wide-col">Details</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var error in Client.ErrorLogs)
                                {
                                    <tr>
                                        <td data-label="Time">@error.OccurredAt.LocalDateTime</td>
                                        <td data-label="Version">@(error.GameVersion?.ToString() ?? "Unknown")</td>
                                        <td data-label="Source">@error.Source</td>
                                        <td data-label="Savegame">
                                            @if (error.HasGameSnapshot)
                                            {
                                                <button class="ui-btn ui-btn-secondary ui-btn-sm" title="Download savegame at the time of this bot decision"
                                                        @onclick="@(() => DownloadBotDecisionGame(error))">
                                                    Download
                                                </button>
                                            }
                                        </td>
                                        <td data-label="User">@(error.Username ?? error.UserId?.ToString() ?? "")</td>
                                        <td data-label="Message" class="admin-copy admin-wide-col" title="Click to copy error message"
                                            @onclick="@(() => Browser.CopyToClipboard(error.Message))">@error.Message</td>
                                        <td data-label="Details" class="admin-wide-col">
                                            <details class="admin-details">
                                                <summary>View</summary>
                                                <pre class="admin-copy" title="Click to copy error details"
                                                     @onclick="@(() => CopyErrorDetails(error))">@error.Details</pre>
                                                <div class="admin-copy" title="Click to copy browser/session info"
                                                     @onclick="@(() => Browser.CopyToClipboard(error.UserAgent ?? string.Empty))">@error.UserAgent</div>
                                            </details>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            @if (!Client.ErrorLogs.Any())
                            {
                                <p class="admin-empty">No errors logged in this period.</p>
                            }
                        </div>
                    </div>
                </section>

                @if (Client.AdminInfo != null)
                {
                    <section class="lobby-panel">
                        <div class="lobby-panel-head">
                            <div>
                                <span class="lobby-kicker">@Client.AdminInfo.Users.Count accounts</span>
                                <h2>Users</h2>
                            </div>
                        </div>
                        <div class="lobby-panel-body">
                            <div class="admin-stats">
                                <div><strong>@Client.AdminInfo.UsersByUserTokenCount</strong><span>Users by token</span></div>
                                <div><strong>@Client.AdminInfo.GamesByGameIdCount</strong><span>Games by id</span></div>
                                <div><strong>@Client.AdminInfo.Users.Count</strong><span>Total users</span></div>
                                <div><strong>@Client.AdminInfo.ConnectionInfoByUserIdCount</strong><span>Connections</span></div>
                            </div>
                            <div class="admin-table-wrap">
                                <table class="admin-table">
                                    <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Username</th>
                                        <th>Player name</th>
                                        <th>Email</th>
                                        <th>Last login</th>
                                        <th class="admin-actions-col">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var av in Client.AdminInfo.Users)
                                    {
                                        <tr>
                                            <td data-label="Id">@av.Id</td>
                                            <td data-label="Username" class="admin-strong">@av.Username</td>
                                            <td data-label="Player name">@av.PlayerName</td>
                                            <td data-label="Email">@av.Email</td>
                                            <td data-label="Last login">
                                                @if (av.LastLogin != default)
                                                {
                                                    @av.LastLogin.LocalDateTime
                                                }
                                            </td>
                                            <td data-label="Actions" class="admin-actions"><button class="ui-btn ui-btn-secondary ui-btn-sm" @onclick="@(_ => DeleteUser(av))">Delete</button></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                }
            </div>

            <div class="lobby-side admin-side">
                <section class="lobby-panel">
                    <div class="lobby-panel-head">
                        <div>
                            <span class="lobby-kicker">Server</span>
                            <h2>Controls</h2>
                        </div>
                    </div>
                    <div class="lobby-panel-body admin-controls">
                        <div class="lobby-section-title">Info</div>
                        <button class="ui-btn ui-btn-primary" @onclick="@GetAdminInfo">Get users</button>
                        <div class="lobby-section-title">Maintenance window</div>
                        <div class="admin-maintenance">
                            <DateTimePicker @bind-Value="@MaintenanceDate"/>
                            <button class="ui-btn ui-btn-primary" @onclick="@UpdateMaintenance">Update</button>
                        </div>
                        <div class="lobby-section-title">Persisted data</div>
                        <div class="lobby-form-actions">
                            <button class="ui-btn ui-btn-secondary" @onclick="@PersistState">Persist data</button>
                            <button class="ui-btn ui-btn-secondary" @onclick="@RestoreState">Restore data</button>
                        </div>
                    </div>
                </section>

                <section class="lobby-panel">
                    <div class="lobby-panel-head">
                        <div>
                            <span class="lobby-kicker">This session</span>
                            <h2>Log</h2>
                        </div>
                    </div>
                    <div class="lobby-panel-body">
                        @if (Messages.Count == 0)
                        {
                            <p class="admin-empty">No actions yet.</p>
                        }
                        else
                        {
                            <ol class="admin-log" aria-live="polite">
                                @foreach (var m in Enumerable.Reverse(Messages))
                                {
                                    <li>@m</li>
                                }
                            </ol>
                        }
                    </div>
                </section>

                <section class="lobby-panel">
                    <div class="lobby-panel-head">
                        <div>
                            <span class="lobby-kicker">@Client.ScheduledGames.Count() planned</span>
                            <h2>Scheduled games</h2>
                        </div>
                    </div>
                    <div class="lobby-panel-body">
                        @if (!Client.ScheduledGames.Any())
                        {
                            <p class="admin-empty">No scheduled games.</p>
                        }
                        <div class="lobby-game-list">
                            @foreach (var av in Client.ScheduledGames.OrderByDescending(av => av.DateTime))
                            {
                                <div class="lobby-game lobby-game-scheduled">
                                    <div class="lobby-game-main">
                                        <span class="lobby-game-name">@av.CreatorName</span>
                                        <span class="lobby-game-time">@av.DateTime</span>
                                    </div>
                                    <div class="lobby-game-actions">
                                        <button class="ui-btn ui-btn-secondary ui-btn-sm" @onclick="@(_ => Cancel(av))">Cancel</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>
}
@code {

    private readonly CancellationTokenSource _errorLogRefreshCancellation = new();
    private bool _errorLogRefreshStarted;
    private DateTimeOffset MaintenanceDate { get; set; }
    private const string DateTimeInputFormat = "yyyy-MM-ddTHH:mm";
    private static readonly string[] DateTimeInputParseFormats = ["yyyy-MM-ddTHH:mm", "yyyy-MM-ddTHH:mm:ss", "yyyy-MM-ddTHH:mm:ss.FFFFFFF"];

    private string GameTimeFromInput { get; set; } = string.Empty;
    private string GameTimeToInput { get; set; } = string.Empty;
    private string GameUsernameInput { get; set; } = string.Empty;
    private DateTime? GameTimeFrom { get; set; }
    private DateTime? GameTimeTo { get; set; }
    private string GameUsernameFilter { get; set; } = string.Empty;
    private int? ErrorLogVersion { get; set; }
    private string ErrorLogFromInput { get; set; } = string.Empty;
    private string ErrorLogToInput { get; set; } = string.Empty;
    private List<string> Messages { get; } = [];

    private IEnumerable<GameInfo> FilteredGames => Client.ActiveGames
        .Where(game => string.IsNullOrWhiteSpace(GameUsernameFilter)
                       || game.CreatorUsername.Contains(GameUsernameFilter, StringComparison.OrdinalIgnoreCase))
        .Where(game => GameTimeFrom == null || (game.LastActivity != null && game.LastActivity.Value.LocalDateTime >= GameTimeFrom))
        .Where(game => GameTimeTo == null || (game.LastActivity != null && game.LastActivity.Value.LocalDateTime <= GameTimeTo))
        .OrderByDescending(game => game.LastActivity);

    protected override async Task OnInitializedAsync()
    {
        Client.RefreshHandler += StateHasChanged;
        Client.IsAdmin = true;
        GameTimeFromInput = FormatDateTimeInput(DateTime.Now.AddDays(-3));
        ApplyGameFilter();
        ErrorLogVersion = Game.LatestVersion;
        ErrorLogFromInput = FormatDateTimeInput(DateTime.Now.AddDays(-31));
        await Client.Start();
        MaintenanceDate = Client.ServerInfo?.ScheduledMaintenance ?? DateTimeOffset.MinValue;
    }

    public void Dispose()
    {
        Client.RefreshHandler -= StateHasChanged;
        _errorLogRefreshCancellation.Cancel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Client.LoggedIn && !_errorLogRefreshStarted)
        {
            _errorLogRefreshStarted = true;
            await RefreshErrorLog(false);
            _ = RefreshErrorLogPeriodically(_errorLogRefreshCancellation.Token);
        }
    }


    private async Task UpdateMaintenance()
    {
        Messages.Add(await Client.AdminUpdateMaintenance(MaintenanceDate));
        StateHasChanged();
    }
    
    private async Task GetAdminInfo()
    {
        Messages.Add(await Client.GetAdminInfo());
        StateHasChanged();
    }

    private Task LoadErrorLog() => RefreshErrorLog(true);

    private async Task RefreshErrorLog(bool addMessage)
    {
        if (!Client.LoggedIn)
            return;

        var errorLogFrom = ParseDateTimeInput(ErrorLogFromInput);
        var errorLogTo = ParseDateTimeInput(ErrorLogToInput);
        var result = await Client.GetAdminErrorLog(
            errorLogFrom.HasValue ? new DateTimeOffset(errorLogFrom.Value) : null,
            errorLogTo.HasValue ? new DateTimeOffset(errorLogTo.Value) : null,
            ErrorLogVersion);
        if (addMessage)
            Messages.Add(result);
        StateHasChanged();
    }

    private void ApplyGameFilter()
    {
        GameTimeFrom = ParseDateTimeInput(GameTimeFromInput);
        GameTimeTo = ParseDateTimeInput(GameTimeToInput);
        GameUsernameFilter = GameUsernameInput.Trim();
    }

    private static string FormatDateTimeInput(DateTime value)
        => value.ToString(DateTimeInputFormat, CultureInfo.InvariantCulture);

    private static DateTime? ParseDateTimeInput(string value)
        => DateTime.TryParseExact(value?.Trim(), DateTimeInputParseFormats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var result)
            ? result
            : null;

    private async Task RefreshErrorLogPeriodically(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(() => RefreshErrorLog(false));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }
    private async Task CopyErrorDetails(ErrorLogInfo error)
    {
        var contents = error.Details;
        if (!string.IsNullOrWhiteSpace(error.UserAgent))
            contents += $"{Environment.NewLine}User agent: {error.UserAgent}";

        await Browser.CopyToClipboard(contents);
    }
    
    private async Task PersistState()
    {
        Messages.Add(await Client.AdminPersistState());
        StateHasChanged();
    }
    
    private async Task RestoreState()
    {
        Messages.Add(await Client.AdminRestoreState());
        StateHasChanged();
    }

    private async Task Close(GameInfo av)
    {
        Messages.Add(await Client.AdminCloseGame(av.GameId));
        StateHasChanged();
    }

    private async Task Download(GameInfo av)
    {
        Messages.Add(await Client.AdminDownloadGame(av.GameId));
        StateHasChanged();
    }

    private async Task DownloadBotDecisionGame(ErrorLogInfo error)
    {
        Messages.Add(await Client.AdminDownloadBotDecisionGame(error));
        StateHasChanged();
    }
    
    private async Task Cancel(ScheduledGameInfo av)
    {
        Messages.Add(await Client.AdminCancelGame(av.ScheduledGameId));
        StateHasChanged();
    }
    
    private async Task DeleteUser(UserInfo av)
    {
        Messages.Add(await Client.AdminDeleteUser(av.Id));
        StateHasChanged();
    }
}
