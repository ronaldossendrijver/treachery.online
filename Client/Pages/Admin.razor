@page "/admin/"

@using Treachery.Client.OtherComponents
@using System.Globalization
@using System.Threading
@implements IDisposable

@if (!Client.IsConnected)
{
    <div class="ui-row ui-d-flex ui-align-items-center" style="@StartScreenStyle">
        <div class="ui-d-flex ui-justify-content-center">
            Not Connected
        </div>
    </div>
}
else if (!Client.LoggedIn)
{
    <div class="ui-row ui-d-flex ui-align-items-center" style="@StartScreenStyle">
        <div class="ui-col-sm-12 ui-col-lg-3"></div>
        <div class="ui-col-sm-12 ui-col-lg-6">
            <div class="ui-d-flex ui-justify-content-center">
                <LoginComponent/>
            </div>
        </div>
        <div class="ui-col-sm-12 ui-col-lg-3"></div>
    </div>
}
else 
{
    <div class="ui-row" style="@StartScreenStyle">
        <div class="ui-col-sm-12 ui-col-lg-2"></div>
        <div class="ui-col-sm-12 ui-col-lg-6">
            <div class="ui-card ui-mb-2">
                <div class="ui-card-header">Server info</div>
                <div class="ui-card-body">
                    <h3 class="h3">Info</h3>
                    <button class="ui-btn ui-btn-primary ui-me-1" @onclick="@GetAdminInfo">Get admin info</button>
                    <h3 class="h3">Maintenance window</h3>
                    <DateTimePicker @bind-Value="@MaintenanceDate"/>
                    <button class="ui-btn ui-btn-primary ui-me-1" @onclick="@UpdateMaintenance">Update</button>
                    <h3 class="h3">Persist data</h3>
                    <button class="ui-btn ui-btn-primary ui-me-1" @onclick="@PersistState">Persist data</button>
                    <h3 class="h3">Restore persisted data</h3>
                    <button class="ui-btn ui-btn-primary ui-me-1" @onclick="@RestoreState">Restore data</button>
                </div>
            </div>
            <div class="ui-card ui-mb-2">
                <div class="ui-card-header">Log</div>
                <div class="ui-card-body">
                    @foreach (var m in Messages)
                    {
                        <div>@m</div>
                    }
                </div>
            </div>
            @if (Client.AdminInfo != null)
            {
                <div class="ui-card ui-mb-2">
                    <div class="ui-card-header">Info</div>
                    <div class="ui-card-body">
                        <p><strong>Users by User Token: </strong>@Client.AdminInfo.UsersByUserTokenCount</p>
                        <p><strong>Games by Game Id: </strong>@Client.AdminInfo.GamesByGameIdCount</p>
                        <p><strong>Total Users: </strong>@Client.AdminInfo.Users.Count</p>
                        <p><strong>ConnectionInfo by UserId: </strong>@Client.AdminInfo.ConnectionInfoByUserIdCount</p>
                        <table class="ui-table ui-table-sm">
                            <thead>
                            <tr class="ui-small ui-table-dark">
                                <th>User id</th>
                                <th>Username</th>
                                <th>Player name</th>
                                <th>Email</th>
                                <th>Last login</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var av in Client.AdminInfo.Users)
                            {
                                <tr class="ui-small ui-table-dark">
                                    <td>@av.Id</td>
                                    <td>@av.Username</td>
                                    <td>@av.PlayerName</td>
                                    <td>@av.Email</td>
                                    <td>
                                        @if (av.LastLogin != default)
                                        {
                                            @av.LastLogin.LocalDateTime
                                        }
                                    </td>
                                    <td><button class="ui-btn ui-btn-primary ui-btn-sm ui-me-1" @onclick="@(_ => DeleteUser(av))">Delete</button></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            <div class="ui-card ui-mb-2">
                <div class="ui-card-header">Running games</div>
                <div class="ui-card-body">
                    <div class="ui-row ui-g-2 ui-mb-3">
                        <div class="ui-col-sm-12 ui-col-md-3">
                            <label class="ui-form-label" for="gameUsernameFilter">Username</label>
                            <input id="gameUsernameFilter" class="ui-form-control ui-form-control-sm" @bind="@GameUsernameInput"/>
                        </div>
                        <div class="ui-col-sm-12 ui-col-md-3">
                            <label class="ui-form-label" for="gameTimeFromFilter">Game time from</label>
                            <input id="gameTimeFromFilter" type="datetime-local" class="ui-form-control ui-form-control-sm" value="@GameTimeFromInput" @onchange="@(e => GameTimeFromInput = e.Value?.ToString() ?? string.Empty)"/>
                        </div>
                        <div class="ui-col-sm-12 ui-col-md-3">
                            <label class="ui-form-label" for="gameTimeToFilter">Game time to</label>
                            <input id="gameTimeToFilter" type="datetime-local" class="ui-form-control ui-form-control-sm" value="@GameTimeToInput" @onchange="@(e => GameTimeToInput = e.Value?.ToString() ?? string.Empty)"/>
                        </div>
                        <div class="ui-col-sm-12 ui-col-md-3 ui-d-flex ui-align-items-center">
                            <button class="ui-btn ui-btn-primary ui-btn-sm" @onclick="ApplyGameFilter">Filter</button>
                        </div>
                    </div>
                    <table class="ui-table ui-table-sm">
                        <thead>
                        <tr class="ui-small ui-table-dark">
                            <th>Created</th>
                            <th>Username</th>
                            <th>Last activity</th>
                            <th>Game</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var av in FilteredGames)
                        {
                            var fontColorStyle = av.LastActivity != null && DateTimeOffset.Now.Subtract((DateTimeOffset)av.LastActivity).TotalMinutes > 20 ? "color:grey" : "color:white";
                            <tr class="ui-small ui-table-dark">
                                <td style="@fontColorStyle">
                                    @av.CreationDate.LocalDateTime
                                </td>
                                <td style="@fontColorStyle">
                                    @av.CreatorUsername
                                </td>
                                <td style="@fontColorStyle">
                                    @av.LastActivity?.LocalDateTime
                                </td>
                                <td style="@fontColorStyle">
                                    @av.Name
                                </td>
                                <td>
                                    <button class="ui-btn ui-btn-primary ui-btn-sm ui-me-1" title="Download savegame"
                                            aria-label="Download savegame" @onclick="@(_ => Download(av))">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                            <path d="M8 1a.75.75 0 0 1 .75.75v7.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V1.75A.75.75 0 0 1 8 1zM2.75 12a.75.75 0 0 1 .75.75v.5h9v-.5a.75.75 0 0 1 1.5 0V14a.75.75 0 0 1-.75.75h-10.5A.75.75 0 0 1 2 14v-1.25a.75.75 0 0 1 .75-.75z"/>
                                        </svg>
                                    </button>
                                    <button class="ui-btn ui-btn-primary ui-btn-sm ui-me-1" @onclick="@(_ => Close(av))">Close</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="ui-card ui-mb-2">
                <div class="ui-card-header">Error log</div>
                <div class="ui-card-body">
                    <div class="ui-row ui-g-2 ui-mb-3">
                        <div class="ui-col-sm-12 ui-col-md-3">
                            <label class="ui-form-label" for="errorLogVersion">Version</label>
                            <input id="errorLogVersion" type="number" class="ui-form-control ui-form-control-sm"
                                   @bind="ErrorLogVersion"/>
                        </div>
                        <div class="ui-col-sm-12 ui-col-md-3">
                            <label class="ui-form-label" for="errorLogFrom">From</label>
                            <input id="errorLogFrom" type="datetime-local" class="ui-form-control ui-form-control-sm" value="@ErrorLogFromInput" @onchange="@(e => ErrorLogFromInput = e.Value?.ToString() ?? string.Empty)"/>
                        </div>
                        <div class="ui-col-sm-12 ui-col-md-3">
                            <label class="ui-form-label" for="errorLogTo">To</label>
                            <input id="errorLogTo" type="datetime-local" class="ui-form-control ui-form-control-sm" value="@ErrorLogToInput" @onchange="@(e => ErrorLogToInput = e.Value?.ToString() ?? string.Empty)"/>
                        </div>
                        <div class="ui-col-sm-12 ui-col-md-3 ui-d-flex ui-align-items-center">
                            <button class="ui-btn ui-btn-primary ui-btn-sm" @onclick="LoadErrorLog">Filter</button>
                        </div>
                    </div>
                    <p class="ui-small">Showing up to 500 entries. Entries are retained for 30 days. This list refreshes every 30 seconds.</p>
                    <div style="overflow-x:auto;">
                        <table class="ui-table ui-table-sm" style="table-layout:fixed;width:100%">
                            <thead>
                            <tr class="ui-small ui-table-dark">
                                <th>Time</th>
                                <th>Version</th>
                                <th>Source</th>
                                <th>Game</th>
                                <th>Savegame</th>
                                <th>User</th>
                                <th style="width:35%">Message</th>
                                <th style="width:35%">Details</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var error in Client.ErrorLogs)
                            {
                                <tr class="ui-small ui-table-dark">
                                    <td>@error.OccurredAt.LocalDateTime</td>
                                    <td>@(error.GameVersion?.ToString() ?? "Unknown")</td>
                                    <td>@error.Source</td>
                                    <td>@error.GameId</td>
                                    <td>
                                        @if (error.HasGameSnapshot)
                                        {
                                            <button class="ui-btn ui-btn-primary ui-btn-sm" title="Download savegame at the time of this bot decision"
                                                    @onclick="@(() => DownloadBotDecisionGame(error))">
                                                Download
                                            </button>
                                        }
                                    </td>
                                    <td>@(error.Username ?? error.UserId?.ToString() ?? "")</td>
                                    <td style="width:35%;overflow-wrap:anywhere;cursor:pointer" title="Click to copy error message"
                                        @onclick="@(() => Browser.CopyToClipboard(error.Message))">@error.Message</td>
                                    <td style="width:35%">
                                        <details>
                                            <summary>View</summary>
                                            <pre title="Click to copy error details"
                                                 style="white-space:pre-wrap;overflow-wrap:anywhere;cursor:pointer"
                                                 @onclick="@(() => CopyErrorDetails(error))">@error.Details</pre>
                                            <div title="Click to copy browser/session info" style="overflow-wrap:anywhere;cursor:pointer"
                                                 @onclick="@(() => Browser.CopyToClipboard(error.UserAgent ?? string.Empty))">@error.UserAgent</div>
                                        </details>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="ui-card ui-mb-2">
                <div class="ui-card-header">Scheduled games</div>
                <div class="ui-card-body">
                    <table class="ui-table ui-table-sm">
                        <tbody>
                        @foreach (var av in Client.ScheduledGames.OrderByDescending(av => av.DateTime))
                        {
                            <tr class="ui-small ui-table-dark">
                                <td class="ui-w-25">
                                    @av.DateTime
                                </td>
                                <td class="ui-w-25">
                                    @av.CreatorName
                                </td>
                                <td class="ui-w-25">
                                    <button class="ui-btn ui-btn-primary ui-btn-sm ui-me-1" @onclick="@(_ => Cancel(av))">Cancel</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="ui-col-sm-12 ui-col-lg-2">
            <div class="ui-card ui-mb-2">
                <div class="ui-card-header">Log</div>
                <div class="ui-card-body">
                    @foreach (var m in Messages)
                    {
                        <div>@m</div>
                    }
                </div>
            </div>
        </div>
        <div class="ui-col-sm-12 ui-col-lg-2"></div>
    </div>
}

@code {

    private readonly CancellationTokenSource _errorLogRefreshCancellation = new();
    private bool _errorLogRefreshStarted;
    private DateTimeOffset MaintenanceDate { get; set; }
    private const string DateTimeInputFormat = "yyyy-MM-ddTHH:mm";
    private static readonly string[] DateTimeInputParseFormats = ["yyyy-MM-ddTHH:mm", "yyyy-MM-ddTHH:mm:ss", "yyyy-MM-ddTHH:mm:ss.FFFFFFF"];

    private string GameTimeFromInput { get; set; } = string.Empty;
    private string GameTimeToInput { get; set; } = string.Empty;
    private string GameUsernameInput { get; set; } = string.Empty;
    private DateTime? GameTimeFrom { get; set; }
    private DateTime? GameTimeTo { get; set; }
    private string GameUsernameFilter { get; set; } = string.Empty;
    private int? ErrorLogVersion { get; set; }
    private string ErrorLogFromInput { get; set; } = string.Empty;
    private string ErrorLogToInput { get; set; } = string.Empty;
    private List<string> Messages { get; } = [];

    private IEnumerable<GameInfo> FilteredGames => Client.ActiveGames
        .Where(game => string.IsNullOrWhiteSpace(GameUsernameFilter)
                       || game.CreatorUsername.Contains(GameUsernameFilter, StringComparison.OrdinalIgnoreCase))
        .Where(game => GameTimeFrom == null || (game.LastActivity != null && game.LastActivity.Value.LocalDateTime >= GameTimeFrom))
        .Where(game => GameTimeTo == null || (game.LastActivity != null && game.LastActivity.Value.LocalDateTime <= GameTimeTo))
        .OrderByDescending(game => game.LastActivity);

    protected override async Task OnInitializedAsync()
    {
        Client.RefreshHandler += StateHasChanged;
        Client.IsAdmin = true;
        GameTimeFromInput = FormatDateTimeInput(DateTime.Now.AddDays(-3));
        ApplyGameFilter();
        ErrorLogVersion = Game.LatestVersion;
        ErrorLogFromInput = FormatDateTimeInput(DateTime.Now.AddDays(-31));
        await Client.Start();
        MaintenanceDate = Client.ServerInfo?.ScheduledMaintenance ?? DateTimeOffset.MinValue;
    }

    public void Dispose()
    {
        Client.RefreshHandler -= StateHasChanged;
        _errorLogRefreshCancellation.Cancel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Client.LoggedIn && !_errorLogRefreshStarted)
        {
            _errorLogRefreshStarted = true;
            await RefreshErrorLog(false);
            _ = RefreshErrorLogPeriodically(_errorLogRefreshCancellation.Token);
        }
    }
    
    private const string StartScreenStyle = "min-height: 97vh; background-image: url('art/planet.png'); background-size: 1024px; background-position-x: center; background-position-y: -50px; background-repeat: no-repeat;";

    private async Task UpdateMaintenance()
    {
        Messages.Add(await Client.AdminUpdateMaintenance(MaintenanceDate));
        StateHasChanged();
    }
    
    private async Task GetAdminInfo()
    {
        Messages.Add(await Client.GetAdminInfo());
        StateHasChanged();
    }

    private Task LoadErrorLog() => RefreshErrorLog(true);

    private async Task RefreshErrorLog(bool addMessage)
    {
        if (!Client.LoggedIn)
            return;

        var errorLogFrom = ParseDateTimeInput(ErrorLogFromInput);
        var errorLogTo = ParseDateTimeInput(ErrorLogToInput);
        var result = await Client.GetAdminErrorLog(
            errorLogFrom.HasValue ? new DateTimeOffset(errorLogFrom.Value) : null,
            errorLogTo.HasValue ? new DateTimeOffset(errorLogTo.Value) : null,
            ErrorLogVersion);
        if (addMessage)
            Messages.Add(result);
        StateHasChanged();
    }

    private void ApplyGameFilter()
    {
        GameTimeFrom = ParseDateTimeInput(GameTimeFromInput);
        GameTimeTo = ParseDateTimeInput(GameTimeToInput);
        GameUsernameFilter = GameUsernameInput.Trim();
    }

    private static string FormatDateTimeInput(DateTime value)
        => value.ToString(DateTimeInputFormat, CultureInfo.InvariantCulture);

    private static DateTime? ParseDateTimeInput(string value)
        => DateTime.TryParseExact(value?.Trim(), DateTimeInputParseFormats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var result)
            ? result
            : null;

    private async Task RefreshErrorLogPeriodically(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(() => RefreshErrorLog(false));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }
    private async Task CopyErrorDetails(ErrorLogInfo error)
    {
        var contents = error.Details;
        if (!string.IsNullOrWhiteSpace(error.UserAgent))
            contents += $"{Environment.NewLine}User agent: {error.UserAgent}";

        await Browser.CopyToClipboard(contents);
    }
    
    private async Task PersistState()
    {
        Messages.Add(await Client.AdminPersistState());
        StateHasChanged();
    }
    
    private async Task RestoreState()
    {
        Messages.Add(await Client.AdminRestoreState());
        StateHasChanged();
    }

    private async Task Close(GameInfo av)
    {
        Messages.Add(await Client.AdminCloseGame(av.GameId));
        StateHasChanged();
    }

    private async Task Download(GameInfo av)
    {
        Messages.Add(await Client.AdminDownloadGame(av.GameId));
        StateHasChanged();
    }

    private async Task DownloadBotDecisionGame(ErrorLogInfo error)
    {
        Messages.Add(await Client.AdminDownloadBotDecisionGame(error));
        StateHasChanged();
    }
    
    private async Task Cancel(ScheduledGameInfo av)
    {
        Messages.Add(await Client.AdminCancelGame(av.ScheduledGameId));
        StateHasChanged();
    }
    
    private async Task DeleteUser(UserInfo av)
    {
        Messages.Add(await Client.AdminDeleteUser(av.Id));
        StateHasChanged();
    }
}
