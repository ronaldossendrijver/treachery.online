@page "/"
@page "/{userToken}/{gameId}"

@using Treachery.Client.MapComponents
@using Treachery.Client.GameEventComponents
@implements IDisposable

@if (Client.InScheduledMaintenance && Client.ServerInfo != null)
{
    <div class="maintenance-banner" role="alert">
        treachery.online will be down for maintenance from @Client.ServerInfo.ScheduledMaintenance.ToLocalTime() until @Client.ServerInfo.ScheduledMaintenance.AddMinutes(60).ToLocalTime() (your local time)
    </div>
}

@if (!Client.IsConnected || !Client.LoggedIn)
{
    <div class="login-screen">
        <video class="login-video" autoplay muted loop playsinline preload="auto" poster="art/planet.png" aria-hidden="true" tabindex="-1">
            <source src="art/planet.mp4" type="video/mp4"/>
        </video>
        <div class="login-dust" aria-hidden="true"></div>
        <div class="login-vignette" aria-hidden="true"></div>
        <main class="login-stage">
            <section class="login-hero" aria-label="treachery.online">
                <h1 class="login-sr-only">treachery.online</h1>
            </section>
            <section class="login-panel">
                @if (!Client.IsConnected)
                {
                    <div class="login-connecting" role="status">
                        <img src="art/worm.gif" alt=""/>
                        <strong>Not connected</strong>
                        <span>Waiting for the server…</span>
                    </div>
                }
                else
                {
                    <LoginComponent/>
                }
            </section>
        </main>
    </div>
}
else if (!Client.InGame)
{
    <div class="lobby-screen">
        <div class="lobby-ambient" aria-hidden="true"></div>
        <header class="lobby-header">
            <video class="lobby-logo" autoplay muted loop playsinline preload="auto" poster="art/planet.png" aria-hidden="true" tabindex="-1">
                <source src="art/planet.mp4" type="video/mp4"/>
            </video>
            <div class="lobby-greeting">
                <span class="lobby-kicker">Welcome back</span>
                <h1><span class="lobby-player-name">@Client.PlayerName</span></h1>
                <p>Resume your games, join an open seat, or start a new struggle for Arrakis.</p>
            </div>
        </header>
        <main class="lobby-grid">
            <RunningGamesComponent/>
            <div class="lobby-side">
                <OwnGamesComponent/>
            </div>
        </main>
    </div>
}
else if (Client.Game.CurrentPhase is Phase.AwaitingPlayers)
{
    <div class="entry-screen">
        <div class="entry-card">
            @if (Client.IsHost)
            {
                <EstablishPlayersComponent/>
            }
            else
            {
                <AwaitingGameComponent/>
            }
        </div>
    </div>
}
else if (Client.PlayersNeedSeating)
{
    <div class="entry-screen">
        <div class="entry-card">
            <SeatPlayersComponent/>
        </div>
    </div>
}
else
{
    <main @ref="_element" class="game-workspace">
        <section id="mapdiv" class="map-stage" aria-label="Game map">
            <GameBoard OnLocationClick="@Client.LocationClick" OnFactionClick="@ToggleFactionMenu" />
            <div class="map-top-overlays">
                <div class="map-tanks-dock">
                    <TanksPile />
                </div>
                <div class="map-menu-dock">
                    <MenuComponent/>
                </div>
            </div>
            <div class="map-card-piles">
                <CardPilesRail />
            </div>
            <div class="map-launchers">
                <CommunicationsPanel />
                <DealsPanel />
            </div>
            @if (Client.Game?.CurrentReport is { } report)
            {
                <div class="map-report-dock">
                    <ReportComponent Report="report" />
                </div>
            }
            <FactionActionMenu SelectedFaction="@_selectedMapFaction" OnClose="@CloseFactionMenu" />
        </section>
        <div class="mobile-game-topbar">
            <strong>TREACHERY ONLINE</strong>
            <span>TURN @Client.Game!.CurrentTurn · @Client.CurrentSkin.Describe(Client.Game!.CurrentMainPhase)</span>
        </div>

        <aside class="game-rail @(Client.IsObserver ?"observer-rail" : "") @( _phoneSheetExpanded ? "sheet-expanded" : "sheet-collapsed")" aria-label="Game controls">
            <button class="sheet-handle" type="button" aria-expanded="@_phoneSheetExpanded" @onclick="TogglePhoneSheet">
                <span class="sheet-grip" aria-hidden="true"></span>
                <span class="sheet-title">Game controls</span>
                <span class="sheet-toggle-label">@(_phoneSheetExpanded ? "Hide" : "Show")</span>
            </button>
            <div class="rail-topbar">
                <div class="rail-phase-info">
                    <span class="eyebrow">TURN @Client.Game.CurrentTurn</span>
                    <span class="main-phase-hover" tabindex="0" aria-describedby="main-phase-sequence-popover">
                        <strong>@Client.CurrentSkin.Describe(Client.Game.CurrentMainPhase)</strong>
                        <span class="main-phase-hover-hint" aria-hidden="true">⌄</span>
                        <span id="main-phase-sequence-popover" class="main-phase-popover" role="tooltip">
                            <MainPhaseTracker />
                        </span>
                    </span>
                </div>
                <TurnActivityIndicator />
            </div>
            <div class="game-rail-content">
                <GameStatusComponent CanEndPhase="@(!Client.IsObserver && Client.Actions.Contains(typeof(EndPhase)))" />
                <div class="game-rail-scroll">
                    <ActionPanel/>
                    <div class="mobile-card-piles">
                        <CardPilesRail />
                    </div>
                    @if (ShowAllPlayerPanels)
                    {
                        foreach (var p in Client.Game.Players)
                        {
                            <PlayerPanel ShownPlayer="p" ShowHeader="true" />
                        }
                    }
                </div>
                @if (ShowOwnPlayerPanel)
                {
                    <div class="game-rail-footer">
                        <PlayerPanel ShownPlayer="Client.Player" />
                    </div>
                }
            </div>
        </aside>

        <ImageFlashComponent  />

    </main>
}
@if (Client.IsConnected && Client.LoggedIn && !IsInGameView)
{
    <CommunicationsPanel />
    <DealsPanel />
}
    
@code {

    [Parameter] public string? UserToken { get; set; }
    [Parameter] public string? GameId { get; set; }

    private ElementReference _element;

    protected override async Task OnInitializedAsync()
    {
        Client.RefreshHandler += StateHasChanged;
        Client.RefreshPopoverHandler += RefreshPopovers;
        
        await Client.Start(UserToken, GameId);
        
        Message.DefaultDescriber = DefaultSkin.Default;
        
        await LoadSkinDataIfSaved();
    }
    
    public void Dispose()
    {
        Client.RefreshHandler -= StateHasChanged;
        Client.RefreshPopoverHandler -= RefreshPopovers;
    }

    private bool _isFullscreen;
    private bool _phoneSheetExpanded;
    private Faction? _selectedMapFaction;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var checkFullscreen = await Browser.IsFullScreen();
        if (_isFullscreen != checkFullscreen)
        {
            _isFullscreen = checkFullscreen;
            StateHasChanged();
        }
        else
        {
            await Browser.SetPlanetMapScale();
        }
    }

    private async Task LoadSkinDataIfSaved()
    {
        var existingSkinData = await Browser.LoadStringSetting("treachery.online;setting.skin");
        if (existingSkinData is { Length: > 0 })
        {
            var skin = Skin.Load(existingSkinData, DefaultSkin.Default);
            if (skin.Version == Skin.LatestVersion)
            {
                Client.CurrentSkin = Skin.Load(existingSkinData, DefaultSkin.Default);
                Message.DefaultDescriber = Client.CurrentSkin;
            }
        }
    }

    private void RefreshPopovers() => _ = Browser.RefreshPopovers(_element);

    private void TogglePhoneSheet() => _phoneSheetExpanded = !_phoneSheetExpanded;

    private void ToggleFactionMenu(Faction faction) =>
        _selectedMapFaction = _selectedMapFaction == faction ? null : faction;

    private void CloseFactionMenu() => _selectedMapFaction = null;

    private bool IsInGameView =>
        Client.IsConnected && Client.LoggedIn && Client.InGame
        && Client.Game.CurrentPhase is not Phase.AwaitingPlayers
        && !Client.PlayersNeedSeating;

    private bool HasPlayerPanel =>
        !Client.IsObserver && Client.CurrentPhase > Phase.TradingFactions && Client.Player != null;

    private bool ShowOwnPlayerPanel => HasPlayerPanel && Client.Player!.Faction is not Faction.None;

    private bool ShowAllPlayerPanels => HasPlayerPanel && Client.Player!.Faction is Faction.None;
}
