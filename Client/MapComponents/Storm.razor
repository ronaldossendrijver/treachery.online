@inherits MapComponent

@if (Game.SectorInStorm >= 0)
{
    var storm = StormLayer(Game.SectorInStorm);
    <div class="storm-clouds" @key="@Game.SectorInStorm" aria-hidden="true" style="@storm.Style">
        <img class="storm-clouds-shadow" src="@storm.ShadowSrc" alt="" draggable="false"/>
        <div class="storm-clouds-mask" style="@storm.MaskStyle">
            <img class="storm-swirl storm-swirl-slow" src="art/storm-clouds.svg?v=4" alt="" draggable="false" style="@storm.SlowStyle"/>
            <img class="storm-swirl storm-swirl-fast" src="art/storm-clouds.svg?v=4" alt="" draggable="false" style="@storm.FastStyle"/>
        </div>
    </div>
}

@code {

    private object? _renderedKey;

    // Only the storm sector, skin or map affect this layer, so it skips re-rendering on every other game event.
    protected override bool ShouldRender()
    {
        if (!Client.InGame || Client.Game == null) return false;

        var key = (Game.SectorInStorm, Client.CurrentSkin, Game.Map);
        if (Equals(_renderedKey, key)) return false;

        _renderedKey = key;
        return true;
    }

    private double ScaleX => 563f / Client.CurrentSkin.MapDimensions.X;

    private double ScaleY => 626f / Client.CurrentSkin.MapDimensions.Y;

    private double CenterX => ScaleX * Client.CurrentSkin.PlanetCenter.X;

    private double CenterY => ScaleY * Client.CurrentSkin.PlanetCenter.Y;

    // Large enough that the rotating square texture always covers the storm wedge.
    private double CloudSize => 2.3 * ScaleX * Client.CurrentSkin.PlanetRadius;

    private sealed record StormLayerData(string Style, string MaskStyle, string ShadowSrc, string SlowStyle, string FastStyle);

    private StormLayerData? _stormLayer;
    private object? _stormLayerKey;

    // The storm overlay is confined to the bounding box of its clip wedge. Its ragged mask and its shadow are static
    // SVG images (rasterized once); only the two cloud textures move, as compositor-driven rotations.
    private StormLayerData StormLayer(int sector)
    {
        var key = (sector, Client.CurrentSkin, Game.Map);
        if (_stormLayer != null && Equals(_stormLayerKey, key)) return _stormLayer;

        var skin = Client.CurrentSkin;
        var clipRadius = 1.12 * skin.PlanetRadius;
        var spread = 6 * Math.PI / 180;
        var start = 2 * Math.PI * (6 - sector) / Map.NumberOfSectors + spread;
        var end = 2 * Math.PI * (5 - sector) / Map.NumberOfSectors - spread;
        var outline = Enumerable.Range(0, 65)
            .Select(i => start + (end - start) * i / 64)
            .Select(a => (X: ScaleX * (Math.Cos(a) * clipRadius + skin.PlanetCenter.X), Y: ScaleY * (Math.Sin(a) * clipRadius + skin.PlanetCenter.Y)))
            .Append((X: CenterX, Y: CenterY))
            .Append((X: ScaleX * (Math.Cos((start + end) / 2 + Math.PI) * 0.08 * skin.PlanetRadius + skin.PlanetCenter.X), Y: ScaleY * (Math.Sin((start + end) / 2 + Math.PI) * 0.08 * skin.PlanetRadius + skin.PlanetCenter.Y)))
            .ToList();

        // Padding leaves room for the shadow blur; the map svg used to clip everything to the map bounds.
        const double padding = 12;
        var x0 = Math.Floor(Math.Max(0, outline.Min(p => p.X) - padding));
        var y0 = Math.Floor(Math.Max(0, outline.Min(p => p.Y) - padding));
        var x1 = Math.Ceiling(Math.Min(skin.MapDimensions.X, outline.Max(p => p.X) + padding));
        var y1 = Math.Ceiling(Math.Min(skin.MapDimensions.Y, outline.Max(p => p.Y) + padding));
        var (w, h) = (x1 - x0, y1 - y0);

        var defs = FormattableString.Invariant($"""
            <defs>
            <filter id='e' x='-25%' y='-25%' width='150%' height='150%'><feTurbulence type='fractalNoise' baseFrequency='0.03' numOctaves='2' seed='5' result='n'/><feDisplacementMap in='SourceGraphic' in2='n' scale='26' xChannelSelector='R' yChannelSelector='G' result='r'/><feGaussianBlur in='r' stdDeviation='5'/></filter>
            <filter id='p' x='-10%' y='-10%' width='120%' height='120%'><feGaussianBlur stdDeviation='1.5'/></filter>
            <filter id='s'><feGaussianBlur stdDeviation='3'/></filter>
            <clipPath id='c' clipPathUnits='userSpaceOnUse'><path d='{StormWedge(sector, 6, 1.12)}'/></clipPath>
            <mask id='m' maskUnits='userSpaceOnUse' x='{x0}' y='{y0}' width='{w}' height='{h}'><path d='{StormWedge(sector)}' fill='#fff' filter='url(#e)'/><path d='{StormWedge(sector, 0, 0.98)}' fill='#fff'/><path d='{skin.GetTerritoryBorder(Game.Map.PolarSink.Territory)}' fill='#000' filter='url(#p)'/></mask>
            </defs>
            """);
        var shape = FormattableString.Invariant($"x='{x0}' y='{y0}' width='{w}' height='{h}' clip-path='url(#c)' mask='url(#m)'");
        string Svg(string body) => "data:image/svg+xml," + Uri.EscapeDataString(FormattableString.Invariant(
            $"<svg xmlns='http://www.w3.org/2000/svg' width='{w}' height='{h}' viewBox='{x0} {y0} {w} {h}'>{defs}{body}</svg>"));

        var mask = Svg($"<rect {shape} fill='#fff'/>");
        // A soft darkening around the (semi-transparent) clouds.
        var shadow = Svg($"<g filter='url(#s)'><rect {shape} fill='rgb(40,42,50)' fill-opacity='0.25'/></g>");

        string Cloud(double size, double opacity) => FormattableString.Invariant(
            $"left:{Px(CenterX - size / 2 - x0)};top:{Px(CenterY - size / 2 - y0)};width:{Px(size)};height:{Px(size)};opacity:{opacity}");

        _stormLayerKey = key;
        _stormLayer = new StormLayerData(
            $"left:{Px(x0)};top:{Px(y0)};width:{Px(w)};height:{Px(h)}",
            $"--storm-mask:url(\"{mask}\")",
            shadow,
            Cloud(CloudSize * 1.4, 0.8),
            Cloud(CloudSize, 0.95));
        return _stormLayer;
    }

    // The storm sector, widened slightly so the clouds creep over its borders. The apex is pulled back
    // behind the planet center so the ragged edge filter does not erode the narrow tip of the sector.
    private string StormWedge(int sector, double spreadDegrees = 2.5, double radiusFactor = 1.05)
    {
        var radius = radiusFactor * Client.CurrentSkin.PlanetRadius;
        var spread = spreadDegrees * Math.PI / 180;
        var start = 2 * Math.PI * (6 - sector) / Map.NumberOfSectors + spread;
        var end = 2 * Math.PI * (5 - sector) / Map.NumberOfSectors - spread;
        var apexBack = spreadDegrees > 0 ? 0.08 * Client.CurrentSkin.PlanetRadius : 0;
        var mid = (start + end) / 2;
        string Point(double angle, double r) => FormattableString.Invariant(
            $"{Round(ScaleX * (Math.Cos(angle) * r + Client.CurrentSkin.PlanetCenter.X))},{Round(ScaleY * (Math.Sin(angle) * r + Client.CurrentSkin.PlanetCenter.Y))}");

        return FormattableString.Invariant(
            $"M {Point(mid + Math.PI, apexBack)} L {Point(start, radius)} A {Round(ScaleX * radius)} {Round(ScaleY * radius)} 0 0 0 {Point(end, radius)} Z");
    }
}