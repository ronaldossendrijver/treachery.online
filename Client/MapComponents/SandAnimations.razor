@inherits MapComponent

@* Purely decorative ambience: small local gusts of fine sand and the ripples of unseen worms travelling beneath open sand. *@

@* Gusts are HTML layers: a static radial fade mask, with the streak sliding and fading on the compositor only. *@
<div class="sand-gusts" aria-hidden="true">
    @foreach (var gust in _gusts)
    {
        <div class="sand-gust" style="@gust.Style">
            <img src="art/sand-gust.svg?v=1" alt="" draggable="false" style="@gust.AnimationStyle"/>
        </div>
    }
</div>

<svg class="sand-ambience" width="@Client.CurrentSkin.MapDimensions.X" height="@Client.CurrentSkin.MapDimensions.Y"
     viewBox="0 0 @Client.CurrentSkin.MapDimensions.X @Client.CurrentSkin.MapDimensions.Y" aria-hidden="true" focusable="false" pointer-events="none">

    <defs>
        <clipPath id="sandAmbienceClip">
            @foreach (var territory in SandTerritories)
            {
                <path d="@Client.CurrentSkin.GetTerritoryBorder(territory)"/>
            }
        </clipPath>
    </defs>

    @* CSS (not SMIL) animations: their value only changes in visible steps, so the trails are not repainted on every frame. *@
    <style>@_wormStyles</style>

    <g clip-path="url(#sandAmbienceClip)">

        @foreach (var worm in _worms)
        {
            <g opacity="0" style="@worm.Style">
                @foreach (var trail in worm.Trails)
                {
                    <path d="@worm.Path" pathLength="1000" fill="none" stroke="@trail.Color" stroke-width="@trail.Width"
                          stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="@($"{trail.Length} 3000")" stroke-dashoffset="@trail.Length" style="@trail.Style"/>
                }
            </g>
        }
    </g>
</svg>
@code {

    // The sand-gust keyframes in app.css slide the streak from -(GustRadius + GustWidth) to GustRadius: keep them in sync.
    private const double GustWidth = 54;
    private const double GustHeight = 18;
    private const double GustRadius = 24;
    private const double WormStep = 4;
    private const double WormMargin = 5;
    // Trail updates per second while a worm travels; it moves only about a pixel per second.
    private const double WormStepsPerSecond = 10;

    // The streak's travel and fade (the sand-gust keyframes in app.css) are expressed in these dimensions.
    private sealed record Gust(double X, double Y, string Style, string AnimationStyle);

    private sealed record Worm(string Path, string Style, List<WormTrail> Trails);

    private sealed record WormTrail(string Color, string Width, int Length, string Style);

    private sealed record Trail(string Color, string Width, int Length);

    // A shadowed groove with a faint pale crest, tapering behind the unseen worm.
    private static readonly Trail[] WormTrails =
    [
        new("rgba(122, 78, 34, 0.3)", "2.6", 75),
        new("rgba(255, 249, 232, 0.45)", "0.7", 55)
    ];

    private List<Gust> _gusts = [];
    private List<Worm> _worms = [];
    private string _wormStyles = "";
    private Dictionary<Territory, List<List<(double X, double Y)>>> _shapes = [];
    private object? _builtFor;
    private object? _renderedFor;

    private IEnumerable<Territory> SandTerritories => Game.Map.Territories(false).Where(IsSand);

    private static bool IsSand(Territory t) => !t.IsProtectedFromWorm && !t.IsHomeworld && !t.IsDiscovery && !t.IsStronghold;

    protected override void OnParametersSet()
    {
        var key = (Game.Map, Client.CurrentSkin);
        if (!Equals(_builtFor, key))
        {
            _builtFor = key;
            _shapes = SandTerritories.ToDictionary(t => t, t => ParsePolygons(Client.CurrentSkin.GetTerritoryBorder(t)));
            BuildGusts();
            BuildWorms();
        }
    }

    // The animations are self-running CSS; only re-render when the map or skin changes.
    protected override bool ShouldRender() => Client.InGame && !Equals(_renderedFor, _builtFor);

    protected override void OnAfterRender(bool firstRender) => _renderedFor = _builtFor;

    private void BuildGusts()
    {
        var random = new Random(4711);

        // Sample a grid over every sand territory so gusts can be placed anywhere they fully fit.
        var points = _shapes
            .Where(entry => entry.Value.Any(p => p.Count > 0))
            .SelectMany(entry =>
            {
                var all = entry.Value.SelectMany(p => p).ToList();
                var (minX, maxX, minY, maxY) = (all.Min(p => p.X), all.Max(p => p.X), all.Min(p => p.Y), all.Max(p => p.Y));
                var grid = new List<(Territory Territory, double X, double Y)>();
                for (var x = minX + GustRadius; x <= maxX - GustRadius; x += 12)
                for (var y = minY + GustRadius; y <= maxY - GustRadius; y += 12)
                    grid.Add((entry.Key, x, y));
                return grid;
            })
            .OrderBy(_ => random.Next())
            .ToList();

        _gusts = [];
        foreach (var (territory, x, y) in points)
        {
            if (_gusts.Count == 16) break;

            var center = (X: x, Y: y);
            if (!FitsWithin(territory, center.X, center.Y, GustRadius * 0.7)) continue;
            if (_gusts.Any(g => Math.Abs(g.X - center.X) + Math.Abs(g.Y - center.Y) < 42)) continue;

            var index = _gusts.Count;
            var angle = -25 + random.NextDouble() * 50 + (random.Next(2) == 0 ? 0 : 180);
            // Half the cycle of before at the same travel speed: gusts recur twice as often.
            var seconds = 0.75 * (19 + random.NextDouble() * 16);
            var begin = 1 + index * 3.25 + random.NextDouble() * 2;
            _gusts.Add(new Gust(
                center.X,
                center.Y,
                Inv($"left:{Px(center.X - GustRadius)};top:{Px(center.Y - GustRadius)};width:{Px(2 * GustRadius)};height:{Px(2 * GustRadius)};transform:rotate({Math.Round(angle)}deg)"),
                Inv($"left:{Px(GustRadius)};top:{Px(GustRadius - GustHeight / 2)};width:{Px(GustWidth)};height:{Px(GustHeight)};animation-duration:{Math.Round(seconds, 1)}s;animation-delay:{Math.Round(begin, 1)}s")));
        }
    }

    private void BuildWorms()
    {
        var map = Game.Map;
        var skin = Client.CurrentSkin;
        var starts = map.Locations(false)
            .Where(l => l is not DiscoveredLocation && l != map.HiddenMobileStronghold && l.Visible && IsSand(l.Territory))
            .Select(l => skin.GetCenter(l, map))
            .Where(p => IsClearSand(p.X, p.Y))
            .ToList();

        _worms = [];
        _wormStyles = "";
        if (starts.Count == 0) return;

        var random = new Random(1965);
        var styles = new System.Text.StringBuilder();
        var configs = new[] { (Speed: 1.25, Idle: 34.0, Begin: 6.0), (Speed: 1.0, Idle: 47.0, Begin: 31.0), (Speed: 1.1, Idle: 40.0, Begin: 18.0), (Speed: 1.35, Idle: 52.0, Begin: 44.0) };

        foreach (var config in configs)
        {
            var route = Enumerable.Range(0, 16)
                .Select(_ => Wander(starts[random.Next(starts.Count)], random))
                .MaxBy(r => r.Count)!;

            if (route.Count < 8) continue;

            var length = (route.Count - 1) * WormStep;
            var travel = length / config.Speed;
            var total = travel + config.Idle;
            var start = config.Idle / total * 0.5;
            var end = start + travel / total;
            var points = route.Where((_, i) => i % 3 == 0 || i == route.Count - 1).ToList();

            // Same timing as the former SMIL animations: hidden, fade in, travel, fade out, hidden.
            var index = _worms.Count;
            var timing = Inv($"animation-duration:{Math.Round(total, 1)}s;animation-delay:{config.Begin}s");
            var steps = Math.Max(2, (int)Math.Round(travel * WormStepsPerSecond));
            var trails = WormTrails.Select((trail, t) =>
            {
                var name = $"sand-worm-{index}-{t}";
                styles.Append(Inv($"@keyframes {name} {{ 0%, {Percent(start)} {{ stroke-dashoffset: {trail.Length}px; animation-timing-function: steps({steps}, jump-none); }} {Percent(end)}, 100% {{ stroke-dashoffset: {trail.Length - 1000}px; }} }}\n"));
                return new WormTrail(trail.Color, trail.Width, trail.Length, $"animation-name:{name};{timing}");
            }).ToList();

            var fade = $"sand-worm-{index}";
            styles.Append(Inv($"@keyframes {fade} {{ 0%, {Percent(start)} {{ opacity: 0; }} {Percent(start + 0.02)}, {Percent(end - 0.02)} {{ opacity: 1; }} {Percent(end + 0.01)}, 100% {{ opacity: 0; }} }}\n"));

            _worms.Add(new Worm(SmoothPath(points), $"animation-name:{fade};{timing}", trails));
        }

        _wormStyles = styles.ToString();
    }

    private static string Percent(double fraction) => Inv($"{Math.Round(fraction * 100, 2)}%");

    // A meandering walk that keeps its heading where it can and turns away whenever rock, strongholds or the map edge lie ahead.
    private List<(double X, double Y)> Wander(PointD from, Random random)
    {
        var points = new List<(double X, double Y)> { (from.X, from.Y) };
        var heading = random.NextDouble() * 2 * Math.PI;
        var drift = 0d;

        for (var step = 0; step < 90; step++)
        {
            drift = Math.Clamp(drift + (random.NextDouble() - 0.5) * 0.12, -0.12, 0.12);
            var (x, y) = points[^1];
            var found = false;

            foreach (var deflection in new[] { 0, 0.25, -0.25, 0.5, -0.5, 0.8, -0.8, 1.1, -1.1 })
            {
                var angle = heading + drift + deflection;
                var nx = x + Math.Cos(angle) * WormStep;
                var ny = y + Math.Sin(angle) * WormStep;
                if (!IsClearSand(nx, ny) || points.Skip(Math.Max(0, points.Count - 40)).SkipLast(3).Any(p => Math.Abs(p.X - nx) + Math.Abs(p.Y - ny) < WormStep * 2)) continue;

                points.Add((nx, ny));
                heading = angle;
                found = true;
                break;
            }

            if (!found) break;
        }

        return points;
    }

    private bool IsClearSand(double x, double y)
    {
        if (!InSand(x, y)) return false;

        for (var i = 0; i < 8; i++)
        {
            var a = i * Math.PI / 4;
            if (!InSand(x + Math.Cos(a) * WormMargin, y + Math.Sin(a) * WormMargin)) return false;
        }

        return true;
    }

    private bool InSand(double x, double y) => _shapes.Values.Any(polygons => Contains(polygons, x, y));

    private bool FitsWithin(Territory territory, double x, double y, double radius)
    {
        if (!_shapes.TryGetValue(territory, out var polygons) || !Contains(polygons, x, y)) return false;

        for (var i = 0; i < 12; i++)
        {
            var a = i * Math.PI / 6;
            if (!Contains(polygons, x + Math.Cos(a) * radius, y + Math.Sin(a) * radius)) return false;
        }

        return true;
    }

    private static bool Contains(List<List<(double X, double Y)>> polygons, double x, double y)
    {
        var inside = false;
        foreach (var polygon in polygons)
        {
            for (int i = 0, j = polygon.Count - 1; i < polygon.Count; j = i++)
            {
                var (xi, yi) = polygon[i];
                var (xj, yj) = polygon[j];
                if (yi > y != yj > y && x < (xj - xi) * (y - yi) / (yj - yi) + xi) inside = !inside;
            }
        }

        return inside;
    }

    // Territory borders are absolute M/L/Z polygons.
    private static List<List<(double X, double Y)>> ParsePolygons(string d)
    {
        var result = new List<List<(double X, double Y)>>();
        List<(double X, double Y)>? current = null;
        var numbers = new List<double>();

        foreach (System.Text.RegularExpressions.Match token in System.Text.RegularExpressions.Regex.Matches(d, @"[MmLlZz]|-?\d*\.?\d+(?:[eE][-+]?\d+)?"))
        {
            var value = token.Value;
            if (value is "M" or "m")
            {
                current = [];
                result.Add(current);
            }
            else if (value is not ("L" or "l" or "Z" or "z"))
            {
                numbers.Add(double.Parse(value, System.Globalization.CultureInfo.InvariantCulture));
                if (numbers.Count == 2)
                {
                    current?.Add((numbers[0], numbers[1]));
                    numbers.Clear();
                }
            }
        }

        return result.Where(p => p.Count > 2).ToList();
    }

    // Catmull-Rom spline through the points, expressed as cubic Béziers.
    private static string SmoothPath(List<(double X, double Y)> p)
    {
        var d = Inv($"M {Round(p[0].X)},{Round(p[0].Y)}");
        for (var i = 0; i < p.Count - 1; i++)
        {
            var p0 = p[Math.Max(0, i - 1)];
            var p1 = p[i];
            var p2 = p[i + 1];
            var p3 = p[Math.Min(p.Count - 1, i + 2)];
            d += Inv($" C {Round(p1.X + (p2.X - p0.X) / 6)},{Round(p1.Y + (p2.Y - p0.Y) / 6)} {Round(p2.X - (p3.X - p1.X) / 6)},{Round(p2.Y - (p3.Y - p1.Y) / 6)} {Round(p2.X)},{Round(p2.Y)}");
        }

        return d;
    }

    private static string Inv(FormattableString s) => FormattableString.Invariant(s);
}
