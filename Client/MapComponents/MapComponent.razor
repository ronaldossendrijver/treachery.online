@implements IDisposable

@code {

    protected override void OnInitialized()
    {
        Client.RefreshHandler += StateHasChanged;
    }

    private double _x;
    [Parameter]
    public double X { get; set; }

    private double _y;
    [Parameter]
    public double Y { get; set; }

    private PointD _xy;
    [Parameter]
    public PointD Xy { get; set; }

    private double _diameter;
    [Parameter]
    public double Diameter { get; set; }

    private double _width;
    [Parameter]
    public double Width { get; set; }

    private double _height;
    [Parameter]
    public double Height { get; set; }

    [Parameter]
    public double Opacity { get; set; } = 1.0f;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (Math.Abs(Diameter - _diameter) > 0)
        {
            _diameter = Diameter;
            _width = _diameter;
            Width = _diameter;
            _height = _diameter;
            Height = _diameter;
        }
        else if (Math.Abs(Width - _width) > 0 || Math.Abs(Height - _height) > 0)
        {
            _width = Width;
            _height = Height;
            _diameter = Math.Max(_width, _height);
            Diameter = _diameter;
        }

        if (Xy != _xy)
        {
            _xy = Xy;
            _x = _xy.X;
            X = _xy.X;
            _y = _xy.Y;
            Y = _xy.Y;
        }
        else if (Math.Abs(X - _x) > 0 || Math.Abs(Y - _y) > 0)
        {
            _x = X;
            _y = Y;
            _xy = new PointD(_x, _y);
            Xy = _xy;
        }
    }

    protected const float TwoPi = 6.2831853072f;

    protected Game Game => Client.Game!;

    protected Player Player => Client.Player!;

    protected static string Px(double x) => Utilities.Px(x);

    protected static string Round(double x) => Utilities.Round(x);

    private static int _nextId;
    private string? _id;
    protected string Id
    {
        get { return _id ??= (System.Threading.Interlocked.Increment(ref _nextId) - 1).ToString(); }
    }

    protected PointD PlayerTokenPosition(Game game, int positionAtTable)
    {
        var positionSector = Math.Floor((float)positionAtTable * Map.NumberOfSectors / game.MaximumPlayers);
        var angle = (4.5 - positionSector) * TwoPi / Map.NumberOfSectors;
        var x = Client.CurrentSkin.PlanetCenter.X + (float)(Client.CurrentSkin.MapRadius * Math.Cos(angle));
        var y = Client.CurrentSkin.PlanetCenter.Y + (float)(Client.CurrentSkin.MapRadius * Math.Sin(angle));
        return new PointD(x, y);
    }

    protected string Intel(Location intelligenceLocation)
    {
        var skin = Client.CurrentSkin;
        var territory = intelligenceLocation.Territory;
        var isPolarSink = Game.Map.PolarSink.Equals(intelligenceLocation);
        var isStronghold = territory.IsStronghold || Game.IsSpecialStronghold(territory);
        var hasOwner = Game.StrongholdOwnership.TryGetValue(intelligenceLocation, out var owner);

        var kind = intelligenceLocation is DiscoveredLocation ? "Discovery"
            : isPolarSink ? "Safe haven"
            : isStronghold ? "Stronghold"
            : territory.IsProtectedFromWorm ? "Rock"
            : "Sand";

        var result = "<div class='loc-intel'><div class='loc-intel-head'><div class='loc-intel-heading'>";
        result += $"<span class='loc-intel-kicker'>{kind}{(intelligenceLocation.Orientation != "" ? " · " + intelligenceLocation.Orientation + " sector" : "")}</span>";
        result += $"<h5 class='loc-intel-title'>{skin.Describe(territory)}</h5></div>";

        if (hasOwner)
        {
            result += $"<img class='loc-intel-owner' src='{skin.GetImageUrl(owner)}' alt='' title='{skin.Format("Held by {0}", owner)}'/>";
        }

        result += "</div>";

        if (hasOwner)
        {
            result += $"<img class='loc-intel-advantage' src='{skin.GetImageUrl(intelligenceLocation.Advantage)}' alt=''/>";
        }

        if (skin.ShowVerboseToolipsOnMap)
        {
            result += "<div class='loc-intel-chips'>";

            if (intelligenceLocation.Sector == Game.SectorInStorm)
                result += Chip("danger", "In storm");

            if (isPolarSink)
                result += Chip("good", "No battles");

            if (isStronghold)
                result += Chip("accent", "Victory point");

            result += territory.IsProtectedFromWorm
                ? Chip("good", skin.Format("Safe from {0}", Concept.Monster))
                : Chip("bad", skin.Format("Exposed to {0}", Concept.Monster));

            result += Game.IsProtectedFromStorm(intelligenceLocation)
                ? Chip("good", "Safe from storm")
                : Chip("bad", "Exposed to storm");

            if (intelligenceLocation.SpiceBlowAmount > 0)
                result += Chip("spice", skin.Format("{0} blow: {1}", Concept.Resource, intelligenceLocation.SpiceBlowAmount));

            result += "</div>";

            var notes = new List<string>();

            if (intelligenceLocation is DiscoveredLocation dl)
                notes.Add(skin.Format("{0}.", skin.GetDiscoveryTokenDescription(dl.Discovery)));

            if (territory == Game.AtomicsAftermath)
                notes.Add("<strong>Atomics aftermath:</strong> no shipping here.");

            if (Equals(intelligenceLocation, Game.Map.Arrakeen) || Equals(intelligenceLocation, Game.Map.Carthag))
            {
                notes.Add(skin.Format("<strong>Harvesters:</strong> when occupied, grants a {0} collection rate of 3-per-force.", Concept.Resource));
                notes.Add("<strong>Ornithopters:</strong> when occupied, your forces can move up to 3 territories.");
            }

            if (Game.Applicable(Rule.IncreasedResourceFlow) &&
                (Equals(intelligenceLocation, Game.Map.Arrakeen) || Equals(intelligenceLocation, Game.Map.Carthag) || Equals(intelligenceLocation, Game.Map.TueksSietch)))
            {
                var bonus = Equals(intelligenceLocation, Game.Map.TueksSietch) ? 1 : 2;
                notes.Add(skin.Format("Yields <strong>{0} {1}</strong> at end of turn when occupied.", bonus, Concept.Resource));
            }

            if (notes.Count > 0)
                result += "<ul class='loc-intel-notes'>" + string.Concat(notes.Select(n => $"<li>{n}</li>")) + "</ul>";
        }

        result += SpiceAndForceAndTokenInfo(intelligenceLocation);
        result += "</div>";

        return result;
    }

    private static string Chip(string tone, string text) => $"<span class='loc-intel-chip loc-intel-chip-{tone}'>{text}</span>";

    private static string Occupant(string src, string? amount = null, bool large = false, string extraClass = "") =>
        $"<span class='loc-intel-occupant{(large ? " loc-intel-occupant-leader" : "")} {extraClass}'><img src='{src}' alt=''/>{(amount != null ? $"<strong>{amount}</strong>" : "")}</span>";

    private string SpiceAndForceAndTokenInfo(Location intelligenceLocation)
    {
        var result = "";

        if (Game.ResourcesOnPlanet.TryGetValue(intelligenceLocation, out var resources))
        {
            result += Occupant(Client.CurrentSkin.Harvester_URL, resources.ToString());
        }

        if (Game.ForcesOnPlanetExcludingEmptyLocations().ContainsKey(intelligenceLocation))
        {
            foreach (var b in Game.BattalionsIn(intelligenceLocation))
            {
                if (b.AmountOfForces > 0)
                {
                    result += Occupant(Client.CurrentSkin.GetFactionForceImageUrl(b.Faction), b.AmountOfForces.ToString());
                }

                if (b.AmountOfSpecialForces > 0)
                {
                    var amount = b.Faction == Faction.White && Client.Faction != Faction.White ? "?" : (b.Faction == Faction.White ? Game.CurrentNoFieldValue : b.AmountOfSpecialForces).ToString();
                    result += Occupant(Client.CurrentSkin.GetFactionSpecialForceImageUrl(b.Faction), amount);
                }
            }
        }

        if (Game.TerrorIn(intelligenceLocation.Territory).Any())
        {
            result += Occupant(Client.CurrentSkin.GetImageUrl(Faction.Cyan), Game.TerrorIn(intelligenceLocation.Territory).Count().ToString(), extraClass: "loc-intel-terror");
        }

        var ambassador = Game.AmbassadorIn(intelligenceLocation.Territory);
        if (ambassador != Ambassador.None)
        {
            result += Occupant(Client.CurrentSkin.GetImageUrl(ambassador));
        }

        if (Game.DiscoveriesOnPlanet.TryGetValue(intelligenceLocation, out var discovery))
        {
            result += Occupant(Client.CurrentSkin.GetImageUrl(discovery.TokenType));
        }

        foreach (var hero in Game.LeaderState.Where(state => state.Value.Alive && state.Value.CurrentTerritory == intelligenceLocation.Territory).Select(state => state.Key))
        {
            result += Occupant(Client.CurrentSkin.GetImageUrl(hero), large: true);
        }

        return result == "" ? "" : $"<div class='loc-intel-occupants'>{result}</div>";
    }
    protected ElementReference Element;
    
    public void Dispose()
    {
        Client.RefreshHandler -= StateHasChanged;
    }
}
