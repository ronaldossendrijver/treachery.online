@inherits MapComponent

<div id="planetmap">

    <div id="planetmap_inner"
         style="width:@Px(Client.CurrentSkin.MapDimensions.X); height:@Px(Client.CurrentSkin.MapDimensions.Y);"
         data-map-center-x="@Client.CurrentSkin.PlanetCenter.X"
         data-map-center-y="@Client.CurrentSkin.PlanetCenter.Y"
         data-map-radius="@Client.CurrentSkin.MapRadius"
         data-player-token-radius="@Client.CurrentSkin.PlayerTokenRadius">

        <div class="planetmap-shadow" style="left:@Px(Client.CurrentSkin.PlanetCenter.X - Client.CurrentSkin.MapRadius); top:@Px(Client.CurrentSkin.PlanetCenter.Y - Client.CurrentSkin.MapRadius); width:@Px(2 * Client.CurrentSkin.MapRadius); height:@Px(2 * Client.CurrentSkin.MapRadius);"></div>

        <BackgroundImage Class="planetmap-art" X="0" Y="0" Width="@Client.CurrentSkin.MapDimensions.X" Height="@Client.CurrentSkin.MapDimensions.Y" Src="@Client.CurrentSkin.Map_URL"/>

        @if (Game.CurrentPhase > Phase.AwaitingPlayers)
        {
            <div class="planetmap-overlays">

                <SandAnimations />
                <SSW  />
                <ResourcesOnPlanet  />
                <Monsters  />
                <Planet  OnLocationClick="@OnLocationClick"/>
                <RecentMoves  />
                <ForcesOnPlanet  OnLocationClick="@OnLocationClick" />
                <Players OnLocationClick="@OnLocationClick" OnFactionClick="@OnFactionClick" />
                <Storm />
                <Bids  />
                <Disconnection  />

            </div>

            <div class="map-fx-layer" aria-hidden="true"></div>
        }

    </div>

</div>

@code {

    [Parameter]
    public EventCallback<LocationEventArgs> OnLocationClick { get; set; }

    [Parameter]
    public EventCallback<Faction> OnFactionClick { get; set; }
}
