@inherits GameComponent

@*
    A free-standing, draggable battle wheel. Pending decisions slide out from behind the wheel on parchment flaps:
    start-of-battle decisions on the left, end-of-battle decisions on the right.
*@
<section class="bwl-unit @(Frame.IsAggressor ? "is-aggressor" : "is-defender") @(Frame.IsActive ? "is-active" : "") @(LeftFlap != null ? "has-left" : "") @(RightFlap != null ? "has-right" : "")"
         data-draggable="@Frame.DragKey" @ref="_element" aria-label="@($"Battle wheel of {Name(Frame.Combatant)}")">

    @if (LeftFlap != null)
    {
        <aside class="bwl-flap is-left" aria-label="@LeftTitle">
            <span class="bwl-seal" aria-hidden="true">@Swords</span>
            <div class="bwl-parchment">
                <h3 class="bwl-flap-title">@LeftTitle</h3>
                <div class="bwl-flap-body"><CascadingValue Name="GameEventsNotCollapsible" Value="true" IsFixed="true">@LeftFlap</CascadingValue></div>
            </div>
        </aside>
    }

    <div class="bwl-center" style="@FaceBounds">
        <header class="bwl-tag" data-drag-handle title="Drag to move this battle wheel">
            <span class="battle-wheel-grip" aria-hidden="true"></span>
            <FactionComponent Faction="Frame.Combatant" Diameter="20" />
            <span class="bwl-tag-text">
                <strong>@(Frame.Role == null ? "Battle decisions" : Frame.Combatant == Faction ? "Your plan" : Name(Frame.Combatant))</strong>
                <span>@(Frame.Role != null ? Frame.Role + " · " : "")@Frame.Territory</span>
            </span>
            <button type="button" class="battle-wheel-hide" @onclick="@(() => BattleWheelState.Hidden = true)" title="Hide the battle wheels to see the map">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8s-2.4 4.5-6.5 4.5S1.5 8 1.5 8Z"/><circle cx="8" cy="8" r="2"/><path d="M2.5 13.5l11-11"/></svg>
                <span>Hide</span>
            </button>
        </header>
        <div class="bwl-wheel" data-drag-handle>
            @Wheel
        </div>
    </div>

    @if (RightFlap != null)
    {
        <aside class="bwl-flap is-right" aria-label="@RightTitle">
            <span class="bwl-seal" aria-hidden="true">@Swords</span>
            <div class="bwl-parchment">
                <h3 class="bwl-flap-title">@RightTitle</h3>
                <div class="bwl-flap-body"><CascadingValue Name="GameEventsNotCollapsible" Value="true" IsFixed="true">@RightFlap</CascadingValue></div>
            </div>
        </aside>
    }
</section>

@code {

    private static readonly RenderFragment Swords =
        @<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l10 10M11.5 16.5l5-5M14 14l4.5 4.5M20 4L10 14M7.5 11.5l5 5M10 14l-4.5 4.5"/><circle cx="19.4" cy="19.4" r="1.1"/><circle cx="4.6" cy="19.4" r="1.1"/></svg>;

    private ElementReference _element;
    private bool _wasShown;

    [Parameter, EditorRequired]
    public BattleWheelFrame Frame { get; set; } = null!;

    [Parameter]
    public RenderFragment? Wheel { get; set; }

    [Parameter]
    public RenderFragment? LeftFlap { get; set; }

    [Parameter]
    public string LeftTitle { get; set; } = "Battle decisions";

    [Parameter]
    public RenderFragment? RightFlap { get; set; }

    [Parameter]
    public string RightTitle { get; set; } = "After battle";

    // Skin cards/leader may stick out of the wheel (e.g. cards left of it); reserve that room so flaps don't cover them.
    private string FaceBounds
    {
        get
        {
            var skin = Client.CurrentSkin;
            var minX = Math.Min(0f, Math.Min(skin.BattleWheelCardX, skin.BattleScreenHeroX));
            var maxX = Math.Max(skin.BattleScreenWidth, Math.Max(skin.BattleWheelCardX + 2.1f * skin.BattleWheelCardWidth, skin.BattleScreenHeroX + skin.BattleWheelHeroWidth));
            return FormattableString.Invariant($"--bwl-ol:{-minX:0.#};--bwl-ext:{maxX - minX:0.#}");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!Frame.Hidden && !_wasShown) Browser.RestoreDragPosition(_element, Frame.DragKey);
        _wasShown = !Frame.Hidden;
    }
}
