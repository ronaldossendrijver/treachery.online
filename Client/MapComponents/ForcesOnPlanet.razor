@inherits MapComponent

@{
    void StrongholdTokens(Location stronghold, double x, double y, float opacity)
    {
        if (Game.StrongholdOwnership.TryGetValue(stronghold, out var owner))
        {
            <MapImage X=x Y=y Diameter=@Client.CurrentSkin.PlayerTokenRadius Src="@Client.CurrentSkin.GetFactionTableImageUrl(owner)"
               Opacity=opacity Popover=@Client.CurrentSkin.GetPopup(stronghold.Advantage, owner)/>

            y += Client.CurrentSkin.PlayerTokenRadius;
        }

        foreach (var terr in Game.TerrorIn(stronghold.Territory))
        {
            var popover = Client.Faction == Faction.Cyan ? Client.CurrentSkin.Format("{0} - {1}", terr, Client.CurrentSkin.GetTerrorTypeDescription(terr)) : "Terror";
            <MapImage X=x Y=y Filter="hue-rotate(180deg);" Diameter=@Client.CurrentSkin.PlayerTokenRadius Src=@Client.CurrentSkin.GetFactionTableImageUrl(Faction.Cyan)
                Opacity=opacity ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="1" ShadowY="1" ShadowBlur="0" Popover=@popover PopoverAsTooltip="true"/>

            y += Client.CurrentSkin.PlayerTokenRadius;
        }

        var ambassador = Game.AmbassadorIn(stronghold.Territory);
        if (ambassador != Ambassador.None)
        {
            var popover = $"{Client.CurrentSkin.Describe(ambassador)} Ambassador - {Client.CurrentSkin.GetAmbassadorDescription(ambassador)}";
            <MapImage X=x Y=y Diameter=@Client.CurrentSkin.PlayerTokenRadius Src=@Client.CurrentSkin.GetImageUrl(ambassador)
                Opacity=opacity ShadowColor="@Client.CurrentSkin.SHADOW" ShadowX="1" ShadowY="1" ShadowBlur="0" Popover=@popover PopoverAsTooltip="true"/>
        }
    }

    foreach (var stronghold in Game.Map.Strongholds.Where(s => s is not HiddenMobileStronghold))
    {
        var center = Client.CurrentSkin.GetCenter(stronghold, Game.Map);
        StrongholdTokens(stronghold, center.X - 2.2f * Client.CurrentSkin.PlayerTokenRadius, center.Y - Client.CurrentSkin.PlayerTokenRadius, 1f);
    }

    var forceLocations = Game.ForcesOnPlanetExcludingEmptyLocations();

    foreach (var location in Game.Map.Locations(false).Where(l => l.Visible && l is not HiddenMobileStronghold).OrderBy(l => Client.CurrentSkin.GetCenter(l, Game.Map).Y))
    {
        var pos = Client.CurrentSkin.GetCenter(location, Game.Map);
        float forceDiameter = 2 * Client.CurrentSkin.FORCETOKEN_RADIUS;

        if (location is DiscoveredLocation ds)
        {
            forceDiameter = 1.5f * Client.CurrentSkin.FORCETOKEN_RADIUS;

            <MapImage X=@(pos.X - 1.25f * Client.CurrentSkin.FORCETOKEN_RADIUS) Y=@(pos.Y - 1.25f * Client.CurrentSkin.FORCETOKEN_RADIUS) Diameter=@(2.5f * Client.CurrentSkin.FORCETOKEN_RADIUS) 
                Src=@Client.CurrentSkin.GetImageUrl(ds.Discovery) Popover=@Intel(ds) 
                ShadowX=1 ShadowY=1
                OnClick=@(e => OnClick(e, location)) />

            @if (Client.Status != null && Client.Status.HighlightedTerritories.Contains(location.Territory))
            {
                <Circle X=pos.X Y=pos.Y Radius=@(1.25f * Client.CurrentSkin.FORCETOKEN_RADIUS)
                    FillColor="@Client.CurrentSkin.HIGHLIGHT_OVERLAY_COLOR" FillOpacity="1" StrokeColor="red" StrokeWidth="1" />
            }
        }
        else if (Game.DiscoveriesOnPlanet.TryGetValue(location, out var discovery))
        {
            var popoverToShow =
                (Client.Faction == Faction.Yellow && discovery.TokenType == DiscoveryTokenType.Yellow) || (Client.Faction == Faction.Orange && discovery.TokenType == DiscoveryTokenType.Orange) ?
                $"{Client.CurrentSkin.Describe(discovery.Token)} - {Client.CurrentSkin.GetDiscoveryTokenDescription(discovery.Token)}" : Client.CurrentSkin.Describe(discovery.TokenType);

            <MapImage X=@(pos.X - 1.25f * Client.CurrentSkin.FORCETOKEN_RADIUS) Y=@(pos.Y - 1.25f * Client.CurrentSkin.FORCETOKEN_RADIUS) Diameter=@(2.5f * Client.CurrentSkin.FORCETOKEN_RADIUS)
                Src=@Client.CurrentSkin.GetImageUrl(discovery.TokenType) Popover=@popoverToShow PopoverAsTooltip=true
                Opacity="0.9f" ShadowX=1 ShadowY=1 />
        }

        <ForcesInLocation Location=@location Battalions=@forceLocations Diameter=@forceDiameter />
    }

    var hms = Game.Map.HiddenMobileStronghold;
    if (hms.Visible && hms.AttachedToLocation != null)
    {
        var skin = Client.CurrentSkin;
        var tip = skin.GetHmsTip(hms, Game.Map);
        var angle = skin.GetHmsAngle(hms, Game.Map);
        var body = skin.GetCenter(hms, Game.Map);
        var origin = $"transform-origin:{Px(tip.X)} {Px(tip.Y)};";
        var rotation = FormattableString.Invariant($"--hms-rotation:{Round(angle * 180 / Math.PI - 180)}deg;");

        // The hull image is laid out so that its tip lies exactly on the point the HMS points at.
        var scale = 3.0 * skin.PlayerTokenRadius / HullViewBoxHeight;
        var hullX = tip.X - HullTipX * scale;
        var hullY = tip.Y - HullTipY * scale;
        var hullWidth = HullViewBoxWidth * scale;
        var hullHeight = HullViewBoxHeight * scale;
        var hullStyle = $"left:{Px(hullX)};top:{Px(hullY)};width:{Px(hullWidth)};height:{Px(hullHeight)};";
        var targetSize = 0.32 * skin.FORCETOKEN_RADIUS;
        var targetStyle = $"left:{Px(tip.X - 0.5 * targetSize)};top:{Px(tip.Y - 0.5 * targetSize)};width:{Px(targetSize)};height:{Px(targetSize)};";

        var away = new PointD(Math.Cos(angle), Math.Sin(angle));
        var eye = new PointD(tip.X + 1.25 * skin.PlayerTokenRadius * away.X, tip.Y + 1.25 * skin.PlayerTokenRadius * away.Y);
        var tokens = new PointD(body.X + 1.7 * skin.PlayerTokenRadius * away.X, body.Y + 1.7 * skin.PlayerTokenRadius * away.Y);

        <div class="hms-hover @(_showHms ? "" : "is-hidden")" style="@rotation">

            <div class="hms-ground-shadow hms-layer" style="@origin" aria-hidden="true">
                <div class="hms-sway hms-layer" style="@origin">
                    <div class="hms-craft hms-layer" style="@origin">
                        <img src="@skin.HMS_URL" style="@hullStyle" alt=""/>
                    </div>
                </div>
            </div>

            <div class="hms-float hms-layer" style="@origin">
                <div class="hms-sway hms-layer" style="@origin">

                    <div class="hms-craft hms-layer" style="@origin">
                        <MapImage class="hms-hull" X=@hullX Y=@hullY Width=@hullWidth Height=@hullHeight
                            Src="@skin.HMS_URL"
                            Opacity="@(_showHms ? 0.85f : 0.3f)"
                            Popover=@Intel(hms)
                            OnClick=@(e => OnClick(e, hms)) />

                        @if (_showHms && Client.Status != null && Client.Status.HighlightedTerritories.Contains(hms.Territory))
                        {
                            <Circle X="@(tip.X - skin.HmsBodyDistance)" Y="tip.Y" Radius="@(1.05 * skin.HmsBodyRadius)"
                                FillColor="@skin.HIGHLIGHT_OVERLAY_COLOR" FillOpacity="1" StrokeColor="red" StrokeWidth="1" />
                        }
                    </div>

                    @{ StrongholdTokens(hms, tokens.X - 0.5 * skin.PlayerTokenRadius, tokens.Y - 0.5 * skin.PlayerTokenRadius, _showHms ? 1f : 0.2f); }

                    @if (_showHms)
                    {
                        <ForcesInLocation Location=@hms Battalions=@forceLocations Diameter=@(1.5f * skin.FORCETOKEN_RADIUS) />
                    }

                    <MapImage X="@(eye.X - 0.5 * skin.FORCETOKEN_RADIUS)" Y="@(eye.Y - 0.5 * skin.FORCETOKEN_RADIUS)"
                       Diameter="@(skin.FORCETOKEN_RADIUS)"
                       Src="@(_showHms ? skin.Eye_URL : skin.EyeSlash_URL)"
                       ShadowColor="black" ShadowX="1" ShadowY="1" ShadowBlur="0"
                       OnClick="@(OnShowHmsClick)"
                       Popover="@(_showHms ? "Hide HMS" : "Show HMS")" PopoverAsTooltip="true"/>
                </div>
            </div>

            @* Marks the exact point (the location center) the HMS points at. *@
            <div class="hms-target" style="@targetStyle" aria-hidden="true"></div>
        </div>
    }
}

@code {

    private readonly Situation _situation = new();
    protected override bool ShouldRender()
    {
        if (Client.InGame) DetectKilledForces();
        return Client.InGame && (CheckAndResetDirty() || _situation.RequiresUpdate(Client));
    }

    private Game? _forcesSnapshotGame;
    private Dictionary<string, (Faction Faction, int Amount)> _forcesSnapshot = [];
    private Dictionary<Faction, int> _killedSnapshot = [];

    // Runs before the re-render, while the DOM still shows the old tokens, so killed tokens can dissolve in place.
    private void DetectKilledForces()
    {
        var forces = new Dictionary<string, (Faction Faction, int Amount)>();
        foreach (var (location, battalions) in Game.ForcesOnPlanetExcludingEmptyLocations())
        {
            foreach (var battalion in battalions)
            {
                if (battalion.AmountOfForces > 0)
                    forces[ForcesInLocation.ForceFxKey(location, battalion.Faction, false)] = (battalion.Faction, battalion.AmountOfForces);
                if (battalion.AmountOfSpecialForces > 0)
                    forces[ForcesInLocation.ForceFxKey(location, battalion.Faction, true)] = (battalion.Faction, battalion.AmountOfSpecialForces);
            }
        }

        var killed = Game.Players.ToDictionary(p => p.Faction, p => p.ForcesKilled + p.SpecialForcesKilled);

        if (ReferenceEquals(_forcesSnapshotGame, Game))
        {
            var newlyKilled = killed.Where(k => k.Value > _killedSnapshot.GetValueOrDefault(k.Key)).Select(k => k.Key).ToHashSet();
            if (newlyKilled.Count > 0)
            {
                var lost = _forcesSnapshot
                    .Select(s => (s.Key, s.Value.Faction, From: s.Value.Amount, To: forces.TryGetValue(s.Key, out var now) ? now.Amount : 0))
                    .Where(s => newlyKilled.Contains(s.Faction) && s.To < s.From)
                    .Select(s => new Browser.FxLoss(s.Key, s.From, s.To))
                    .ToList();

                if (lost.Count > 0) Browser.Disintegrate(lost);
            }
        }

        _forcesSnapshotGame = Game;
        _forcesSnapshot = forces;
        _killedSnapshot = killed;
    }

    private bool _showHms = true;
    private bool _dirty;

    // Geometry of the HMS hull image (hms.svg): its viewBox size and the position of its tip within that viewBox.
    private const double HullViewBoxWidth = 67;
    private const double HullViewBoxHeight = 46;
    private const double HullTipX = 64.1;
    private const double HullTipY = 22.7;

    [Parameter]
    public EventCallback<LocationEventArgs> OnLocationClick { get; set; }

    private async Task OnClick(MouseEventArgs e, Location l)
    {
        await OnLocationClick.InvokeAsync(new LocationEventArgs { Location = l, AltKey = e.AltKey, CtrlKey = e.CtrlKey, ShiftKey = e.ShiftKey });
    }

    private bool CheckAndResetDirty()
    {
        var result = _dirty;
        _dirty = false;
        return result;
    }

    private void OnShowHmsClick(MouseEventArgs e)
    {
        _showHms = !_showHms;
        _dirty = true;
        StateHasChanged();
    }
}