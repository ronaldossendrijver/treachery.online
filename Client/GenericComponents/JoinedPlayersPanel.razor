@inherits GameComponent

<div class="joined-players">
    @if (Game.CurrentPhase is Phase.AwaitingPlayers)
    {
        <div class="joined-players-grid" role="list" aria-label="Seated players">
            @foreach (var userId in Game.Participation.SeatedPlayers.Keys.ToArray())
            {
                var isMe = Client.UserId == userId;
                var isHost = Game.IsHost(userId);

                <div class="joined-player-row @(isMe ? "is-me" : "")" role="listitem">
                    <span class="joined-player-faction" aria-hidden="true"></span>
                    <span class="joined-player-name">
                        <span>@Game.GetPlayerName(userId)</span>
                        @if (isHost)
                        {
                            <HostIcon Size="16"/>
                        }
                    </span>
                    <span class="joined-player-status"></span>
                    <span class="joined-player-actions">
                        @if (Client.IsHost)
                        {
                            if (!isHost)
                            {
                                <CommandButton Small MarginClass="ui-m-0" OnClick="@(_ => SetOrUnsetHost(userId))">Make host</CommandButton>
                            }
                            if (!isMe)
                            {
                                <CommandButton Small Class="ui-btn-danger" MarginClass="ui-m-0" OnClick="@(_ => Remove(userId, true))">Kick</CommandButton>
                            }
                        }
                    </span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="joined-players-grid" role="list" aria-label="Players by seat">
            @foreach (var player in Game.Players.OrderBy(p => p.Seat))
            {
                var userId = Game.GetUserIdOfPlayer(player);
                var makeAvailableText = Game.SeatIsAvailable(player.Seat) ? "Close" : "Open";
                var isMe = Client.UserId == userId;
                var isHost = Game.IsHost(userId);
                var isBot = Game.IsBot(player);

                <div class="joined-player-row @(isMe ? "is-me" : "")" role="listitem">
                    <span class="joined-player-faction">
                        @if (player.Faction != Faction.None)
                        {
                            <FactionComponent Faction="@player.Faction" Diameter="24"/>
                        }
                    </span>
                    <span class="joined-player-name">
                        @if (isBot)
                        {
                            <BotIcon Size="16"/>
                            <span class="joined-player-bot">Bot</span>
                        }
                        else
                        {
                            <span>@Game.GetPlayerName(player)</span>
                        }
                        @if (isHost)
                        {
                            <HostIcon Size="16"/>
                        }
                    </span>
                    <span class="joined-player-status">
                        @if (Game.SeatIsAvailable(player.Seat))
                        {
                            <span class="ui-badge ui-text-bg-success">open</span>
                        }
                    </span>
                    <span class="joined-player-actions">
                        @if (Client.IsHost)
                        {
                            <CommandButton Small MarginClass="ui-m-0" OnClick="@(_ => OpenSeat(player.Seat))">@makeAvailableText seat</CommandButton>
                            @if (!isBot)
                            {
                                if (!isHost)
                                {
                                    <CommandButton Small MarginClass="ui-m-0" OnClick="@(_ => SetOrUnsetHost(userId))">Make host</CommandButton>
                                }

                                if (!isMe)
                                {
                                    <CommandButton Small Class="ui-btn-danger" MarginClass="ui-m-0" OnClick="@(_ => Remove(userId, true))">Kick</CommandButton>
                                }
                            }
                        }
                    </span>
                </div>
            }
        </div>
    }
    @if (!string.IsNullOrEmpty(ActionResult))
    {
        <div class="ui-text-danger joined-players-result">@ActionResult</div>
    }
    <div class="joined-players-footer">
        @if (!Client.IsHost || Game.CurrentPhase > Phase.AwaitingPlayers)
        {
            <CommandButton Small Class="ui-btn-danger" MarginClass="ui-m-0" OnClick="@(_ => Leave())">Leave game</CommandButton>
        }
        @if (Client.IsHost && Client.InGame && Game.CurrentPhase >= Phase.TradingFactions)
        {
            <CommandButton Small Class="ui-btn-warning" MarginClass="ui-m-0" OnClick="@(_ => Reseat())">Re-seat players</CommandButton>
        }
    </div>
    @if (Game.NumberOfObservers > 0)
    {
        <div class="joined-players-observers">
            <span class="joined-players-observers-label">Observers</span>
            @foreach (var o in Game.ObserverNames)
            {
                <span class="joined-player-observer">@o</span>
            }
        </div>
    }
</div>

@code {

    private string? ActionResult { get; set; }

    private async Task Leave()
    {
        if (Client.UserId != null)
            await Remove(Client.UserId.Value, false);  
    } 
    
    private async Task Remove(int userId, bool kick)
    {
        if (kick)
        {
            ActionResult = await Client.RequestKick(userId);
        }
        else
        {
            await Client.RequestLeaveGame();
            ActionResult = string.Empty;
        }
    }

    private async Task SetOrUnsetHost(int userId)
    {
        ActionResult = await Client.RequestSetOrUnsetHost(userId);
    }

    private async Task OpenSeat(int seatId)
    {
        ActionResult = await Client.RequestOpenOrCloseSeat(seatId);
    }
    
    private void Reseat()
    {
        Client.RequestReseat();
    }
}
