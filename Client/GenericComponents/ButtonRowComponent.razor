@using Microsoft.AspNetCore.Components.Sections
@using System.Threading
@implements IDisposable

@if (ActionsSection != null)
{
    <SectionContent SectionId="ActionsSection">@Buttons</SectionContent>
}
else
{
    @Buttons
}
@code {

    [CascadingParameter(Name = "GameEventActions")]
    public object? ActionsSection { get; set; }

    private RenderFragment Buttons => __builder =>
    {
        <div class="ui-button-row @Alignment">

            @if (Other.HasDelegate)
            {
                <button class="ui-btn ui-btn-primary ui-btn-other" @onclick="Other" disabled=@Disabled>@OtherText</button>
            }

            @if (Pass.HasDelegate)
            {
                if (AutoPassEnabled)
                {
                    <button class="ui-btn ui-btn-primary ui-btn-pass ui-btn-autopass @(_autoPassPaused ? "is-paused" : "")" style="--autopass-duration: @(AutoPassMilliseconds)ms"
                            @onclick="Pass" @onmouseenter="PauseAutoPass" @onmouseleave="ResumeAutoPass">@PassText</button>
                }
                else
                {
                    <button class="ui-btn ui-btn-primary ui-btn-pass" @onclick="Pass" disabled=@Disabled>@PassText</button>
                }
            }

            @if (Confirm.HasDelegate)
            {
                if (ConfirmError != null)
                {
                    <span class="ui-d-inline-block ui-btn-confirm-wrap" tabindex="0" data-toggle="tooltip" data-delay="0" title=@ConfirmError.ToString(Client.CurrentSkin)>
                        <button class="ui-btn ui-btn-primary ui-btn-confirm" disabled=@true>@ConfirmText</button>
                    </span>
                }
                else
                {
                    <button class="ui-btn ui-btn-primary ui-btn-confirm" @onclick="Confirm" disabled=@Disabled>@ConfirmText</button>
                }
            }

        </div>
    };

    [Parameter]
    public EventCallback Confirm { get; set; }

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    [Parameter]
    public Message? ConfirmError { get; set; }

    [Parameter]
    public EventCallback Pass { get; set; }

    [Parameter]
    public string PassText { get; set; } = "Pass";

    [Parameter]
    public EventCallback Other { get; set; }

    [Parameter]
    public string OtherText { get; set; } = "Other";

    [Parameter]
    public string Alignment { get; set; } = "text-end";

    [Parameter]
    public bool Disabled { get; set; }

    private const int AutoPassMilliseconds = 20000;

    private bool AutoPassEnabled => Pass.HasDelegate && !Confirm.HasDelegate && !Other.HasDelegate && !Disabled;

    private int _autoPassRemaining = AutoPassMilliseconds;
    private DateTime _autoPassStartedAt;
    private CancellationTokenSource? _autoPassCts;
    private bool _autoPassPaused;
    private bool _autoPassDone;

    protected override void OnParametersSet()
    {
        if (AutoPassEnabled)
        {
            if (_autoPassCts == null && !_autoPassPaused && !_autoPassDone)
                StartAutoPass();
        }
        else
        {
            CancelAutoPass();
            _autoPassRemaining = AutoPassMilliseconds;
            _autoPassPaused = false;
        }
    }

    private void StartAutoPass()
    {
        _autoPassCts = new CancellationTokenSource();
        _autoPassStartedAt = DateTime.UtcNow;
        _ = RunAutoPass(_autoPassRemaining, _autoPassCts.Token);
    }

    private async Task RunAutoPass(int milliseconds, CancellationToken token)
    {
        try
        {
            await Task.Delay(milliseconds, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested) return;

        _autoPassDone = true;
        _autoPassCts = null;
        await InvokeAsync(() => Pass.InvokeAsync());
    }

    private void PauseAutoPass()
    {
        if (!AutoPassEnabled || _autoPassDone) return;

        _autoPassPaused = true;
        if (_autoPassCts != null)
        {
            var elapsed = (int)(DateTime.UtcNow - _autoPassStartedAt).TotalMilliseconds;
            _autoPassRemaining = Math.Max(0, _autoPassRemaining - elapsed);
            CancelAutoPass();
        }
    }

    private void ResumeAutoPass()
    {
        if (!AutoPassEnabled || _autoPassDone) return;

        _autoPassPaused = false;
        if (_autoPassCts == null)
            StartAutoPass();
    }

    private void CancelAutoPass()
    {
        _autoPassCts?.Cancel();
        _autoPassCts?.Dispose();
        _autoPassCts = null;
    }

    public void Dispose() => CancelAutoPass();
}
