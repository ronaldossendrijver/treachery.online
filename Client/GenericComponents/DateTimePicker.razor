<div class="ui-row ui-mb-1">
    <div class="ui-col">
        <label for="datePicker">@Label</label>
        <input type="date" id="datePicker" class="ui-form-control" @bind:get="@SelectedDate" @bind:set="@HandleDateChanged" @bind:event="onchange"/>
    </div>
    <div class="ui-col">
        <label for="timePicker">@TimeLabel</label>
        <input type="time" id="timePicker" class="ui-form-control" @bind:get="@SelectedTime" @bind:set="@HandleTimeChanged" @bind:event="onchange"/>
    </div>
</div>

@code 
{
    [Parameter]
    public string Label { get; set; } = "Select Date";

    [Parameter]
    public string TimeLabel { get; set; } = "Select Time";

    [Parameter] 
    public DateTimeOffset Value { get; set; } = DateTimeOffset.MinValue;
    
    [Parameter]
    public EventCallback<DateTimeOffset> ValueChanged { get; set; }
    
    [Parameter] 
    public int Step { get; set; } = 15;
    
    private DateTime? SelectedDate { get; set; }
    private TimeOnly? SelectedTime { get; set; }
    private DateTimeOffset? _lastValue;

    protected override async Task OnParametersSetAsync()
    {
        if (Value == DateTimeOffset.MinValue)
        {
            await ValueChanged.InvokeAsync(DateTimeOffset.Now);
        }
        else if (_lastValue != Value)
        {
            _lastValue = Value;
            SelectedDate = Value.DateTime.Date;
            SelectedTime = TimeOnly.FromDateTime(Value.DateTime);
        }
    }
    
    private async Task HandleDateChanged(DateTime? value)
    {
        // Ignore incomplete input so the user can keep editing
        if (value == null)
            return;

        SelectedDate = value.Value.Date;
        await NotifyValueChanged();
    }

    private async Task HandleTimeChanged(TimeOnly? value)
    {
        if (value == null)
            return;

        SelectedTime = value;
        await NotifyValueChanged();
    }

    private async Task NotifyValueChanged()
    {
        var value = ConstructDateTimeOffset(SelectedDate, SelectedTime);
        _lastValue = value;
        await ValueChanged.InvokeAsync(value);
    }
    
    private DateTimeOffset ConstructDateTimeOffset(DateTime? date, TimeOnly? time)
    {
        var dateTime = date ?? DateTime.Now;
        var localDateTime = new DateTime(DateOnly.FromDateTime(dateTime), time ?? TimeOnly.MinValue);
        return new DateTimeOffset(localDateTime, TimeZoneInfo.Local.GetUtcOffset(localDateTime));
    }
}