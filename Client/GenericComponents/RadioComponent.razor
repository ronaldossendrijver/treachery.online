@inherits GameComponent;
@typeparam T

@if (Label != null)
{
    <label class="ui-mb-0" for="@Id">@Label</label>
}

@foreach (var item in _shown.Values)
{
    <div class="ui-form-check ui-mb-0">
        <input class="ui-form-check-input" style="cursor:pointer" type="radio" id="@Id-@item.Id" value=@item.Id @onclick=@(_ => ChangeValue(item.Value)) checked=@Equals(item.Value, Value) title="@(string.IsNullOrEmpty(item.Title) ? null : item.Title)">
        <label class="ui-form-check-label" style="cursor:pointer" for="@Id-@item.Id" title="@(string.IsNullOrEmpty(item.Title) ? null : item.Title)">@item.Label</label>
    </div>
}

@code {

    [Parameter]
    public IEnumerable<T>? Values { get; set; }

    [Parameter]
    public T? Value { get; set; }

    private Dictionary<string, ValueToShow> _shown = [];

    [Parameter]
    public IEnumerable<string>? ValueLabels { get; set; }

    [Parameter]
    public IEnumerable<string>? ValueTitles { get; set; }

    [Parameter]
    public string EmptyLabel { get; set; } = "";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<T> ValueChanged { get; set; }

    [Parameter]
    public RenderFragment? Label { get; set; }

    [Parameter]
    public bool Required { get; set; } = true;

    private T[] ValuesToShow { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        ValuesToShow = Values?.ToArray() ?? [];

        if (!ValuesToShow.Contains(Value))
        {
            await SetValue(Required ? ValuesToShow.FirstOrDefault() : default);
        }

        var valueLabels = ValueLabels?.ToArray();
        if (valueLabels == null || valueLabels.Length != ValuesToShow.Length)
        {
            valueLabels = ValuesToShow.Select(v => v != null ? Client.CurrentSkin.Describe(v) : EmptyLabel).ToArray();
        }

        var valueTitles = ValueTitles?.ToArray();
        if (valueTitles == null || valueTitles.Length != ValuesToShow.Length)
            valueTitles = ValuesToShow.Select(_ => string.Empty).ToArray();

        _shown = ValuesToShow.Zip(valueLabels, (v, l) => new ValueToShow { Value = v, Id = GetId(v), Label = l })
            .Zip(valueTitles, (item, title) =>
            {
                item.Title = title;
                return item;
            })
            .ToDictionary(item => item.Id);
    }

    private async Task ChangeValue(T? value)
    {
        await SetValue(value);
    }

    private async Task SetValue(T? newValue)
    {
        if (!Equals(Value, newValue))
        {
            Value = newValue;
            await ValueChanged.InvokeAsync(newValue);
        }
    }

    private struct ValueToShow
    {
        internal T? Value;
        internal string Id;
        internal string Label;
        internal string? Title;
    }
}
