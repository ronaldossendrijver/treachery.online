@inherits GameEventComponent<SetShipmentPermission>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Shipment permissions</Header>
    <Body>

        @if (Game.ShipmentPermissions.Any())
        {
            <div class="ev-section">
                <div class="ev-label">Granted</div>
                <ul class="ev-list">
                    @foreach (var kvp in Game.ShipmentPermissions)
                    {
                        <li class="ev-row">
                            <Image Shown="@kvp.Key" Width="26" PopoverAsTooltip />
                            <span class="ev-pills">
                                @foreach (var (permission, label, description) in Permissions)
                                {
                                    <span class="ev-pill @(kvp.Value.HasFlag(permission) ? "is-on" : "")" title="@description">@label</span>
                                }
                            </span>
                            <button type="button" class="ev-remove" title="Revoke all permissions of @Client.CurrentSkin.Describe(kvp.Key)" aria-label="Revoke" @onclick="e => Revoke(kvp.Key)">&times;</button>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="ev-section">
            <div class="ev-label">Grant to</div>
            <SelectFromImageComponent Values="@SetShipmentPermission.ValidTargets(Game, Player)" Selected="@targets" Required="true" ImageWidth="32" T="Faction" OnChanged="StateHasChanged" />
            <div class="ev-pills ev-toggles" role="group" aria-label="Permissions to grant">
                @foreach (var (permission, label, description) in Permissions)
                {
                    var on = _permission.HasFlag(permission);
                    <button type="button" class="ev-pill ev-toggle @(on ? "is-on" : "")" aria-pressed="@(on ? "true" : "false")" title="@description" @onclick="() => Toggle(permission)">@label</button>
                }
            </div>
        </div>

        <ButtonRowComponent Confirm="Confirm" ConfirmText="Grant" ConfirmError="@Validation" />

    </Body>

</GameEventComponentLayout>
@code {

    private static readonly (ShipmentPermission Permission, string Label, string Description)[] Permissions =
    [
        (ShipmentPermission.Cross, "Cross planet", "Allow cross planet shipments"),
        (ShipmentPermission.ToHomeworld, "To homeworld", "Allow shipment to (own) homeworld"),
        (ShipmentPermission.OrangeRate, "Half price", "May ship at half price")
    ];

    internal List<Faction> targets = new();
    internal ShipmentPermission _permission = ShipmentPermission.None;

    protected override Faction IsFactionSpecific => Faction.Orange;

    protected override SetShipmentPermission ConfirmedResult => new(Game, Faction) { Factions = targets.ToArray(), Permission = _permission };

    private void Toggle(ShipmentPermission permission) => _permission ^= permission;

    private async Task Revoke(Faction f)
    {
        await Request(new SetShipmentPermission(Game, Faction) { Factions = new[] { f }, Permission = ShipmentPermission.None });
    }
}