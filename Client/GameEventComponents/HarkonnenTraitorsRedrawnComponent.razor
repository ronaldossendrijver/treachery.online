@inherits GameEventComponent<HarkonnenTraitorsRedrawn>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">
    <Header>Reveal and redraw up to @HarkonnenTraitorsRedrawn.MaximumRedraw(Game, Player) of your own leaders, or keep your traitors</Header>
    <Body>
        @foreach (var leader in HarkonnenTraitorsRedrawn.ValidLeaders(Player))
        {
            <ChecklistItemComponent Value="leader" Values="Selected">@Name(leader)</ChecklistItemComponent>
        }
        <ButtonRowComponent Confirm="Confirm" ConfirmError="@Validation" Pass="Pass" PassText="Keep all" />
    </Body>
</GameEventComponentLayout>

@code {
    protected override bool IsUrgent => true;
    protected override Faction IsFactionSpecific => Faction.Black;
    private List<IHero> Selected = [];
    protected override HarkonnenTraitorsRedrawn ConfirmedResult => new(Game, Faction)
        { LeaderIds = Selected.Select(LeaderManager.HeroLookup.GetId).ToList() };
    protected override HarkonnenTraitorsRedrawn PassedResult => new(Game, Faction) { Passed = true };
}
