@inherits GameEventComponent<AcceptOrCancelPurpleRevival>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Early revival requests</Header>

    <Body>

        @if (Game.CurrentRevivalRequests.Any())
        {
            <div class="ev-section">
                <div class="ev-label">Requested</div>
                <SelectFromImageComponent Game=Game Required=true @bind-Value=@OfferHero Values=@Game.CurrentRevivalRequests.Select(req => req.Hero) ImageWidth="56"/>
                @if (Game.CurrentRevivalRequests.Any(req => req.Player.IsBot))
                {
                    <div class="ev-note">Bots are waiting for your decision before they revive.</div>
                }
            </div>

            <SelectResourcesComponent @bind-Value="Price" Min=0 Max=50 Label="Price" />

            <ButtonRowComponent Pass="Pass" PassText="Deny all" Confirm="Confirm" ConfirmText=@OfferLabel Other=Other OtherText="Deny" ConfirmError=@Validation />
        }

        @if (Game.EarlyRevivalsOffers.Any())
        {
            <div class="ev-section">
                <div class="ev-label">Your offers</div>
                <ul class="ev-chips">
                    @foreach (var kvp in Game.EarlyRevivalsOffers)
                    {
                        <li class="ev-chip @(kvp.Value == int.MaxValue ? "is-denied" : "")">
                            <Image Shown=@kvp.Key Width="28" Game=Game />
                            @if (kvp.Value == int.MaxValue)
                            {
                                <span class="ev-chip-text">Denied</span>
                            }
                            else
                            {
                                <span class="ev-chip-price" title="Price">@kvp.Value</span>
                            }
                            <button type="button" class="ev-remove" title="Cancel this offer" aria-label="Cancel offer" @onclick="_ => Cancel(kvp.Key)">&times;</button>
                        </li>
                    }
                </ul>
            </div>
        }

    </Body>

</GameEventComponentLayout>
@code {

    protected override bool IsUrgent => Game.CurrentRevivalRequests.Any();

    protected override Faction IsFactionSpecific => Faction.Purple;

    internal IHero? OfferHero;
    internal int Price;

    protected override AcceptOrCancelPurpleRevival ConfirmedResult => new(Game, Faction) { Cancel = false, Hero = OfferHero, Price = Price };

    protected override AcceptOrCancelPurpleRevival PassedResult => new(Game, Faction) { Cancel = false, Hero = null };

    protected override AcceptOrCancelPurpleRevival OtherResult => new(Game, Faction) { Cancel = false, Hero = OfferHero, Price = int.MaxValue };

    private async Task Cancel(IHero hero)
    {
        await Request(new AcceptOrCancelPurpleRevival(Game, Faction) { Cancel = true, Hero = hero });
    }

    private string OfferLabel => Client.CurrentSkin.Format("Offer for {0}", Price);
}
