@using System.Globalization
@inherits GameEventComponent<Battle>

@{
    if (Game.CurrentBattle?.Territory is null) return;

    var opponent = Game.CurrentBattle.OpponentOf(Faction);
    if (opponent is null) return;

    var forceSupplier = Battle.DetermineForceSupplier(Game, Player);
    var maxForces = Battle.MaxForces(Game, forceSupplier, false);
    var maxSpecialForces = Battle.MaxForces(Game, forceSupplier, true);
    var heroes = Battle.ValidBattleHeroes(Game, Player).ToList();
    var heroRequired = !Game.Applicable(Rule.BattleWithoutLeader);
    var weapons = Weapons.ToList();
    var defenses = Defenses.ToList();

    if (maxForces <= 0) Forces = 0;
    if (maxSpecialForces <= 0) SpecialForces = 0;
    if (heroes.Count == 0) Hero = null;
    else if (Hero == null ? heroRequired : !heroes.Contains(Hero)) Hero = heroRequired ? heroes.First() : null;
    if (weapons.Count == 0) Weapon = null;
    if (defenses.Count == 0) Defense = null;

    var mayUseMessiah = Player.MessiahAvailable && !Game.Prevented(FactionAdvantage.GreenUseMessiah);
    if (!mayUseMessiah) Messiah = false;

    var maxBanker = Battle.MaxBankerBoost(Game, Player, Hero);
    if (maxBanker <= 0) BankerBonus = 0;

    var mustPay = Forces + SpecialForces > 0 && Battle.MustPayForAnyForcesInBattle(Game, Player);
    var maxTotalResources = 0;
    var maxPaidByAlly = 0;
    if (mustPay)
    {
        var maxResources = Battle.MaxResources(Game, Player, Forces, SpecialForces);
        var maxAllyResources = Battle.MaxAllyResources(Game, Player, Forces, SpecialForces);
        maxTotalResources = Math.Min(Forces + SpecialForces, maxResources + maxAllyResources);
        maxPaidByAlly = Player.Ally == Faction.Brown ? Math.Min(maxAllyResources, Resources) : 0;
        if (maxPaidByAlly <= 0) ResourcesFromAlly = 0;
    }
    else
    {
        Resources = 0;
        ResourcesFromAlly = 0;
    }

    var dial = Support.RoundWithHalves(ConfirmedResult.Dial(Game, opponent.Faction));
    var tint = Client.CurrentSkin.FactionTableImage_URL.TryGetValue(Faction, out var tintUrl) ? tintUrl : null;
}

<div class="bw-plan">

    <div class="bw-intel">

        <span class="bw-chip">
            <span>Opponent</span>
            @if (opponent.ForcesIn(Game.CurrentBattle.Territory) > 0)
            {
                <img src="@Client.CurrentSkin.GetFactionForceImageUrl(opponent.Faction)" alt="@Client.CurrentSkin.Describe(opponent.Force)" width="20" height="20" />
                <strong>@opponent.ForcesIn(Game.CurrentBattle.Territory)</strong>
            }
            @if (opponent.HasAlly && opponent.AlliedPlayer.ForcesIn(Game.CurrentBattle.Territory) > 0)
            {
                <img src="@Client.CurrentSkin.GetFactionForceImageUrl(opponent.Ally)" alt="@Client.CurrentSkin.Describe(opponent.AlliedPlayer.Force)" width="20" height="20" />
                <strong>@opponent.AlliedPlayer.ForcesIn(Game.CurrentBattle.Territory)</strong>
            }
            @if (opponent.SpecialForcesIn(Game.CurrentBattle.Territory) > 0)
            {
                <img src="@Client.CurrentSkin.GetFactionSpecialForceImageUrl(opponent.Faction)" alt="@Client.CurrentSkin.Describe(opponent.SpecialForce)" width="20" height="20" />
                @if (opponent.Faction != Faction.White)
                {
                    <strong>@opponent.SpecialForcesIn(Game.CurrentBattle.Territory)</strong>
                }
            }
            @if (opponent.HasAlly && opponent.AlliedPlayer.SpecialForcesIn(Game.CurrentBattle.Territory) > 0)
            {
                <img src="@Client.CurrentSkin.GetFactionSpecialForceImageUrl(opponent.Ally)" alt="@Client.CurrentSkin.Describe(opponent.AlliedPlayer.SpecialForce)" width="20" height="20" />
                @if (opponent.Ally != Faction.White)
                {
                    <strong>@opponent.AlliedPlayer.SpecialForcesIn(Game.CurrentBattle.Territory)</strong>
                }
            }
        </span>

        @if (!Battle.ValidBattleHeroes(Game, opponent).Any())
        {
            <span class="bw-chip is-good">Opponent has no leaders available</span>
        }

        @if (Game.CurrentPinkBattleContribution > 0)
        {
            var pinkOnOurSide = Player.Faction == Faction.Pink || Player.Ally == Faction.Pink;
            <span class="bw-chip @(pinkOnOurSide ? "is-good" : "is-warn")">
                <FactionComponent Faction="Faction.Pink" Diameter="18" />
                +@Game.CurrentPinkBattleContribution to @(pinkOnOurSide ? "your" : "opponent's") dial
            </span>
        }

        @if (Game.CurrentVoice != null)
        {
            @if (Faction == Faction.Blue || Player.Ally == Faction.Blue)
            {
                <span class="bw-chip is-good">Voice: opponent @(Game.CurrentVoice.Must ? "must use" : "may not use") @Client.CurrentSkin.Describe(Game.CurrentVoice.Type)</span>
            }
            else
            {
                <span class="bw-chip is-warn">Voice: you @(Game.CurrentVoice.Must ? "must use" : "may not use") @Client.CurrentSkin.Describe(Game.CurrentVoice.Type)</span>
            }
        }

        @if (Faction == Faction.Green || Player.Ally == Faction.Green)
        {
            var opponentBattlePlan = Game.CurrentBattle.Aggressor == Faction ? Game.DefenderPlan : Game.AggressorPlan;
            if (Game.GreenKarma)
            {
                if (opponentBattlePlan != null)
                {
                    foreach (var aspect in new[] { PrescienceAspect.Dial, PrescienceAspect.Leader, PrescienceAspect.Weapon, PrescienceAspect.Defense })
                    {
                        <Hoverable Class="bw-chip is-good" Popover="@GetPopupForAspect(aspect, opponentBattlePlan, true)">Enemy @aspect: <strong>@GetTextForAspect(aspect, opponentBattlePlan, true)</strong></Hoverable>
                    }
                }
                else
                {
                    <span class="bw-chip is-good">Enemy plan is revealed once confirmed</span>
                }
            }
            else
            {
                foreach (var aspect in new[] { Game.CurrentPrescience?.Aspect, Game.CurrentNexusPrescience?.GreenPrescienceAspect })
                {
                    if (aspect == null) continue;

                    if (opponentBattlePlan != null)
                    {
                        <Hoverable Class="bw-chip is-good" Popover="@GetPopupForAspect(aspect.Value, opponentBattlePlan, false)">Prescience · enemy @aspect: <strong>@GetTextForAspect(aspect.Value, opponentBattlePlan, false)</strong></Hoverable>
                    }
                    else
                    {
                        <span class="bw-chip is-good">Prescience · enemy @aspect revealed once confirmed</span>
                    }
                }
            }
        }

    </div>

    <div class="bw-wheel">
        <img class="bw-wheel-art" src="@Client.CurrentSkin.BattleScreen_URL" alt="" />
        @if (tint != null)
        {
            <img class="bw-wheel-tint" src="@tint" alt="" />
        }

        <div class="bw-dial" title="Your dial (strength of the forces you dial)">
            <span class="bw-dial-value">@dial</span>
            <span class="bw-dial-label">dial</span>
        </div>

        <button type="button" class="bw-slot bw-slot-leader @(_picker == Picker.Leader ? "is-active" : "") @(Hero == null ? "is-empty" : "")"
                disabled="@(heroes.Count == 0)" aria-label="Choose leader" @onclick="@(() => TogglePicker(Picker.Leader))">
            @if (Hero != null)
            {
                <Image Shown="Hero" Game="Game" Width="86" NoShadow />
            }
            else
            {
                <span class="bw-slot-empty"><b>@(heroes.Count == 0 ? "–" : "+")</b>@(heroes.Count == 0 ? "No leader" : "Leader")</span>
            }
        </button>

        @if (Messiah)
        {
            <img class="bw-messiah" src="@Client.CurrentSkin.Messiah_URL" alt="@Client.CurrentSkin.Describe(Concept.Messiah)" title="@Client.CurrentSkin.Describe(Concept.Messiah)" />
        }

        <button type="button" class="bw-slot bw-slot-card bw-slot-weapon @(_picker == Picker.Weapon ? "is-active" : "") @(Weapon == null ? "is-empty" : "")"
                disabled="@(weapons.Count == 0)" aria-label="Choose weapon" @onclick="@(() => TogglePicker(Picker.Weapon))">
            @if (Weapon != null)
            {
                <Image Shown="Weapon" Width="86" NoShadow />
            }
            else
            {
                <span class="bw-slot-empty"><b>@(weapons.Count == 0 ? "–" : "+")</b>Weapon</span>
            }
        </button>

        <button type="button" class="bw-slot bw-slot-card bw-slot-defense @(_picker == Picker.Defense ? "is-active" : "") @(Defense == null ? "is-empty" : "")"
                disabled="@(defenses.Count == 0)" aria-label="Choose defense" @onclick="@(() => TogglePicker(Picker.Defense))">
            @if (Defense != null)
            {
                <Image Shown="Defense" Width="86" NoShadow />
            }
            else
            {
                <span class="bw-slot-empty"><b>@(defenses.Count == 0 ? "–" : "+")</b>Defense</span>
            }
        </button>
    </div>

    @if (_picker != Picker.None)
    {
        <div class="bw-picker" role="listbox" aria-label="@PickerTitle">
            <div class="bw-picker-head">
                <span>@PickerTitle</span>
                <button type="button" class="bw-picker-close" aria-label="Close" @onclick="@(() => _picker = Picker.None)">×</button>
            </div>
            <div class="bw-picker-grid">
                @switch (_picker)
                {
                    case Picker.Leader:
                        @if (!heroRequired)
                        {
                            <button type="button" class="bw-option bw-option-none @(Hero == null ? "is-selected" : "")" @onclick="@(() => Pick(() => Hero = null))">None</button>
                        }
                        @foreach (var h in heroes)
                        {
                            <button type="button" class="bw-option @(Equals(Hero, h) ? "is-selected" : "")" @onclick="@(() => Pick(() => Hero = h))">
                                <Image Shown="h" Game="Game" Width="64" NoShadow />
                            </button>
                        }
                        break;

                    case Picker.Weapon:
                        <button type="button" class="bw-option bw-option-none @(Weapon == null ? "is-selected" : "")" @onclick="@(() => Pick(() => Weapon = null))">None</button>
                        @foreach (var w in weapons.Where(w => w != null))
                        {
                            <button type="button" class="bw-option is-card @(Equals(Weapon, w) ? "is-selected" : "")" @onclick="@(() => Pick(() => Weapon = w))">
                                <Image Shown="w" Width="64" NoShadow />
                            </button>
                        }
                        break;

                    case Picker.Defense:
                        <button type="button" class="bw-option bw-option-none @(Defense == null ? "is-selected" : "")" @onclick="@(() => Pick(() => Defense = null))">None</button>
                        @foreach (var d in defenses.Where(d => d != null))
                        {
                            <button type="button" class="bw-option is-card @(Equals(Defense, d) ? "is-selected" : "")" @onclick="@(() => Pick(() => Defense = d))">
                                <Image Shown="d" Width="64" NoShadow />
                            </button>
                        }
                        break;
                }
            </div>
        </div>
    }

    <div class="bw-controls">
        @if (maxForces > 0)
        {
            <SelectForcesComponent @bind-Value="Forces" Min="0" Max="maxForces" Faction="@forceSupplier.Faction" Special="false" />
        }
        @if (maxSpecialForces > 0)
        {
            <SelectForcesComponent @bind-Value="SpecialForces" Min="0" Max="maxSpecialForces" Faction="@forceSupplier.Faction" Special="true" />
        }
        @if (mustPay)
        {
            <SelectResourcesComponent @bind-Value="Resources" Min="0" Max="maxTotalResources" Title="@Client.CurrentSkin.Format("{0} used to support forces", Concept.Resource)" />
        }
        @if (maxPaidByAlly > 0)
        {
            <SelectResourcesFromFactionComponent @bind-Value="ResourcesFromAlly" Min="0" Max="maxPaidByAlly" Faction="Player.Ally" Title="@Client.CurrentSkin.Format("{0} paid by your ally", Concept.Resource)" />
        }
        @if (maxBanker > 0)
        {
            <SelectResourcesComponent @bind-Value="BankerBonus" Min="0" Max="maxBanker" Title="@Client.CurrentSkin.Format("Boost {0} {1} with {2}", Client.CurrentSkin.Describe(LeaderSkill.Banker), Hero, Concept.Resource)" />
        }
    </div>

    @if (mayUseMessiah)
    {
        <label class="bw-toggle">
            <input type="checkbox" @bind="Messiah" />
            <img src="@Client.CurrentSkin.Messiah_URL" alt="" width="26" height="26" />
            <span>@Client.CurrentSkin.Describe(Concept.Messiah) joins the fight</span>
        </label>
    }

    <div class="bw-confirm">
        <ButtonRowComponent Confirm="Confirm" ConfirmText="Battle!" ConfirmError="@Validation" />
    </div>

</div>

@code {

    private enum Picker { None, Leader, Weapon, Defense }

    private Picker _picker = Picker.None;

    protected override bool IsUrgent => true;

    internal int Forces { get; set; }
    internal int SpecialForces { get; set; }
    internal int Resources { get; set; }
    internal int ResourcesFromAlly { get; set; }
    internal IHero? Hero { get; set; }
    internal bool Messiah { get; set; }
    internal TreacheryCard? Defense { get; set; }
    internal TreacheryCard? Weapon { get; set; }
    internal int BankerBonus { get; set; }

    private string PickerTitle => _picker switch
    {
        Picker.Leader => "Choose your leader",
        Picker.Weapon => "Choose your weapon",
        Picker.Defense => "Choose your defense",
        _ => ""
    };

    private void TogglePicker(Picker picker) => _picker = _picker == picker ? Picker.None : picker;

    private void Pick(Action select)
    {
        select();
        _picker = Picker.None;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (Game.CurrentBattle?.PlanOf(Faction) == null)
        {
            var previousPlan = Game.CurrentBattle?.PreviousPlanOf(Faction);
            if (previousPlan != null && previousPlan.Validate() == null)
            {
                Forces = previousPlan.Forces + previousPlan.ForcesAtHalfStrength;
                SpecialForces = previousPlan.SpecialForces + previousPlan.SpecialForcesAtHalfStrength;
                Resources = previousPlan.Cost(Game);
                ResourcesFromAlly = previousPlan.AllyContributionAmount;
                Hero = previousPlan.Hero;
                Messiah = previousPlan.Messiah;
                Defense = previousPlan.Defense;
                Weapon = previousPlan.Weapon;
                BankerBonus = previousPlan.BankerBonus;
            }
        }
    }

    protected override Battle ConfirmedResult
    {
        get
        {
            Battle.DetermineForces(Game, Player, Forces, SpecialForces, Resources, out var forcesFull, out var forcesHalf, out var specialForcesFull, out var specialForcesHalf);

            return new Battle(Game, Faction)
            {
                Defense = Defense,
                Forces = forcesFull,
                ForcesAtHalfStrength = forcesHalf,
                AllyContributionAmount = ResourcesFromAlly,
                Hero = Hero,
                Messiah = Messiah,
                SpecialForces = specialForcesFull,
                SpecialForcesAtHalfStrength = specialForcesHalf,
                Weapon = Weapon,
                BankerBonus = BankerBonus
            };
        }
    }

    private string GetTextForAspect(PrescienceAspect aspect, Battle plan, bool showEverything)
    {
        switch (aspect)
        {
            case PrescienceAspect.Defense: return plan.Defense == null || (!showEverything && !plan.Defense.IsDefense) ? "None" : Name(plan.Defense);
            case PrescienceAspect.Weapon: return plan.Weapon == null || (!showEverything && !plan.Weapon.IsWeapon) ? "None" : Name(plan.Weapon);
            case PrescienceAspect.Dial: return plan.Dial(Game, Faction).ToString(CultureInfo.InvariantCulture);
            case PrescienceAspect.Leader: return plan.Hero == null ? "None" : Name(plan.Hero);
        }

        return "?";
    }

    private string GetPopupForAspect(PrescienceAspect aspect, Battle plan, bool showEverything)
    {
        switch (aspect)
        {
            case PrescienceAspect.Defense: return plan.Defense == null || (!showEverything && !plan.Defense.IsDefense) ? "" : Client.CurrentSkin.GetPopup(plan.Defense);
            case PrescienceAspect.Weapon: return plan.Weapon == null || (!showEverything && !plan.Weapon.IsWeapon) ? "" : Client.CurrentSkin.GetPopup(plan.Weapon);
            case PrescienceAspect.Dial: return "";
            case PrescienceAspect.Leader: return plan.Hero == null ? "" : Client.CurrentSkin.GetPopup(plan.Hero, Game);
        }

        return "?";
    }

    private IEnumerable<TreacheryCard?> Weapons
        => Battle.ValidWeapons(Game, Player, Defense, Hero, Game.CurrentBattle?.Territory).OrderBy(Name);

    private IEnumerable<TreacheryCard?> Defenses
        => Battle.ValidDefenses(Game, Player, Weapon, Game.CurrentBattle?.Territory).OrderBy(Name);
}