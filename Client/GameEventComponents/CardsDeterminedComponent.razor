@inherits GameEventComponent<CardsDetermined>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Select cards in play</Header>
    <Body>

        <h4>Treachery Cards</h4>
        <SelectFromImageComponent Selected="_selectedTreacheryCards" Values="@Game.TreacheryDeck!.Items" T="TreacheryCard" OnChanged="StateHasChanged" ImageWidth="80" />

        @if(Game.WhiteCache.Any())
        {
            <h4>@Client.CurrentSkin.Describe(Faction.White) Cards</h4>
            <SelectFromImageComponent Selected="@_selectedWhiteCards" Values="@Game.WhiteCache" T=TreacheryCard OnChanged="@StateHasChanged"/>
        }

        <ButtonRowComponent Confirm="Confirm" ConfirmText="Confirm Cards" ConfirmError="@Validation" />

    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;

    private List<TreacheryCard> _selectedTreacheryCards = [];
    private List<TreacheryCard> _selectedWhiteCards = [];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _selectedTreacheryCards = [.. Game.TreacheryDeck!.Items];
        _selectedWhiteCards = [.. Game.WhiteCache];
    }

    protected override CardsDetermined ConfirmedResult => new(Game, Faction) { TreacheryCards = _selectedTreacheryCards, WhiteCards = _selectedWhiteCards };
}
