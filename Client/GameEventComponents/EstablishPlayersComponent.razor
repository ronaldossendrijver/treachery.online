@inherits GameEventComponent<EstablishPlayers>

<div class="setup-layout">

    <section class="lobby-panel setup-panel setup-settings">
        <div class="lobby-panel-head">
            <div>
                <span class="lobby-kicker">Host settings</span>
                <h2>Shape your struggle</h2>
            </div>
        </div>
        <div class="lobby-panel-body">
            <div class="setup-basics">
                <div class="setup-stepper">
                    <span class="setup-label">Turns</span>
                    <SelectNumberComponent @bind-Value="@Settings.MaximumTurns" Min="1" Max="EstablishPlayers.GetMaximumNumberOfTurns()" Size="32"/>
                </div>
                <div class="setup-stepper">
                    <span class="setup-label">Players</span>
                    <SelectNumberComponent @bind-Value="@Settings.NumberOfPlayers" Min="2" Max="EstablishPlayers.GetMaximumNumberOfPlayers()" Size="32"/>
                </div>
                <div class="setup-ruleset">
                    <SelectComponent @bind-Value="@Ruleset" Values="@Game.GetAvailableRulesets()">
                        <Label><span class="setup-label">Ruleset</span></Label>
                    </SelectComponent>
                </div>
            </div>

            <div class="lobby-section-title">Factions in play <span>@Settings.AllowedFactionsInPlay.Count selected · click to toggle</span></div>
            <div class="setup-factions">
                <SelectFromImageComponent Selected="@Settings.AllowedFactionsInPlay" Values="EstablishPlayers.AvailableFactions()" T="Faction" OnChanged="@StateHasChanged" ImageWidth="44" Required="false"/>
            </div>

            <div class="lobby-section-title">Options</div>
            <div class="setup-options">
                <CheckboxComponent @bind-Value="@Settings.AutoOpenEmptySeats">Auto open all bot seats to other players at start</CheckboxComponent>
                <CheckboxComponent @bind-Value="@Settings.AsyncPlay">Async play (send e-mail updates)</CheckboxComponent>
                @if (Settings.AsyncPlay)
                {
                    <div class="setup-stepper setup-stepper-inline">
                        <span class="setup-label">Minutes between e-mails</span>
                        <SelectNumberComponent @bind-Value="@Settings.AsyncPlayMessageIntervalMinutes" Min="10" Max="120" StepDown="10" StepUp="10" Size="28"/>
                    </div>
                }
                <CheckboxComponent @bind-Value="@_advancedOptions">Change advanced options</CheckboxComponent>
            </div>

            @if (_advancedOptions)
            {
                <div class="setup-rules">
                    @foreach (var ruleGroup in EstablishPlayers.AvailableRuleGroups())
                    {
                        if (Game.GetRulesInGroup(ruleGroup, Game.ExpansionLevel).Any())
                        {
                            <fieldset class="setup-rule-group">
                                <legend>@Client.CurrentSkin.Describe(ruleGroup)</legend>
                                @foreach (var rule in Game.GetRulesInGroup(ruleGroup, Game.ExpansionLevel).OrderBy(r => Name(r)))
                                {
                                    <ChecklistItemComponent Value="@rule" Values="@Settings.InitialRules" />
                                }
                            </fieldset>
                        }
                    }
                </div>
            }
        </div>
    </section>

    <div class="setup-sidebar">
        <section class="lobby-panel setup-panel setup-players">
            <div class="lobby-panel-head">
                <div>
                    <span class="lobby-kicker">Seats</span>
                    <h2>Players</h2>
                </div>
            </div>
            <div class="lobby-panel-body">
                <JoinedPlayersPanel/>

                <div class="lobby-section-title">Bots</div>
                <div class="setup-bots">
                    <div class="setup-bots-type">
                        <RadioComponent @bind-Value="@AdvancedBots" Values="@AvailableBotTypes" ValueLabels="@AvailableBotTypeLabels"/>
                        @if (AdvancedBotsAvailable)
                        {
                            <aside class="setup-bots-info" aria-label="About Advanced Bots">
                                <AdvancedBotsInfo/>
                            </aside>
                        }
                    </div>
                    @if (AdvancedBotsRequireMembership)
                    {
                        <p class="setup-membership-hint">
                            Advanced bots are available to members.
                            <button type="button" class="ui-btn ui-btn-link" data-dialog-target="#establishPlayersMembershipModal" aria-haspopup="dialog">Become a member</button>
                        </p>
                        <MembershipComponent Id="establishPlayersMembershipModal"/>
                    }
                    @foreach (var rule in Game.GetRulesInGroup(RuleGroup.Bots, Game.ExpansionLevel).Where(r => r != Rule.AdvancedBots))
                    {
                        <ChecklistItemComponent Value="@rule" Values="@Settings.InitialRules" Callback="StateHasChanged" />
                    }
                </div>

                <div class="setup-actions">
                    <ButtonRowComponent Pass="@Cancel" PassText="Cancel game" Confirm="@Confirm" ConfirmText="Start game" ConfirmError="@Validation" />
                </div>
            </div>
        </section>
    </div>

</div>
@code {

    protected override bool IsUrgent => true;

    private GameSettings Settings { get; set; } = new()
    {
        NumberOfPlayers = 6,
        InitialRules = Game.RulesetDefinition[Ruleset.BasicGame].ToList(),
        AllowedFactionsInPlay = Enumerations.GetValuesExceptDefault(Faction.None).ToList(),
        MaximumTurns = 10
    };
    
    private bool _advancedOptions;

    private bool AdvancedBotsAvailable => Client.CanUseAdvancedBots;

    private bool AdvancedBotsRequireMembership => Client.ServerInfo is { AdvancedBotsAvailable: true, MembershipRequired: true } && !AdvancedBotsAvailable;

    private bool[] AvailableBotTypes => AdvancedBotsAvailable ? [false, true] : [false];

    private string[] AvailableBotTypeLabels => AdvancedBotsAvailable ? ["Basic (classic)", "Advanced (experimental)"] : ["Basic (classic)"];

    private bool AdvancedBots
    {
        get => Settings.InitialRules.Contains(Rule.AdvancedBots);
        set
        {
            Settings.InitialRules.Remove(Rule.AdvancedBots);
            if (value) Settings.InitialRules.Add(Rule.AdvancedBots);
        }
    }

    private bool _disposed;
    private bool _initializing = true;

    [Parameter]
    public Func<int> SeedFactory { get; set; } = () => new Random().Next();

    private Ruleset _ruleset;
    private Ruleset Ruleset
    {
        get => _ruleset;
        set
        {
            _ruleset = value;
            RulesetChanged(value);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized(); 
        await LoadSettings();
        _ = Task.Delay(3600).ContinueWith(_ => UpdateSettings());
        _initializing = false;
    }

    private async Task LoadSettings()
    {
        var loadedSettingsAsString = await Browser.LoadStringSetting("treachery.online;setting.establishPlayersSettings");
        var storedSettingsLoaded = false;
        if (!string.IsNullOrEmpty(loadedSettingsAsString))
        {
            try
            {
                var loadedSettings = Utilities.Deserialize<EstablishPlayersSettings>(loadedSettingsAsString);

                if (loadedSettings?.Settings != null)
                {
                    Settings = loadedSettings.Settings;
                    storedSettingsLoaded = true;
                }

                if (loadedSettings != null)
                {
                    if (loadedSettings.Ruleset != Ruleset.None)
                        Ruleset = loadedSettings.Ruleset;

                    _advancedOptions = loadedSettings.AdvancedOptions;
                }
            }
            catch (Exception)
            {
                //Ignore locally stored settings
            }
        }

        if (!storedSettingsLoaded)
            AdvancedBots = AdvancedBotsAvailable;
        else if (!AdvancedBotsAvailable)
            AdvancedBots = false;
    }

    public override void Dispose()
    {
        _disposed = true;
    }
    
    protected override async Task Confirm()
    {
        if (!AdvancedBotsAvailable)
            AdvancedBots = false;
        
        await StoreSettings();
        await base.Confirm();
    }
    
    private async Task Cancel()
    {
        if (Client.GameId != null)
            await Client.RequestCloseGame(Client.GameId);
    }

    private async Task UpdateSettings()
    {
        if (_disposed)
            return;

        if (Client.GameId != null)
            await Client.RequestUpdateSettings(Client.GameId, Settings);
            _ = Task.Delay(3600).ContinueWith(_ => UpdateSettings());
    }

    private async Task StoreSettings()
    {
        var savedSettings = new EstablishPlayersSettings
        {
            Settings = Settings,
            Ruleset = Ruleset,
            AdvancedOptions = _advancedOptions
        };
        
        var settingsAsString = Utilities.Serialize(savedSettings);

        try
        {
            await Browser.SaveStringSetting("treachery.online;setting.establishPlayersSettings", settingsAsString);
        }
        catch (Exception)
        {
            //Don't store settings
        }
    }

    private void RulesetChanged(Ruleset ruleset)
    {
        if (_initializing)
            return;
        
        var botRules = Settings.InitialRules.Where(r => Game.GetRuleGroup(r) == RuleGroup.Bots).ToArray();

        Settings.InitialRules.Clear();
        Settings.InitialRules.AddRange(botRules);

        if (Game.RulesetDefinition.TryGetValue(ruleset, out var value))
        {
            Settings.InitialRules.AddRange(value);
        }

        StateHasChanged();
    }

    protected override EstablishPlayers ConfirmedResult =>
        new(Game, Faction.None)
        {
            Settings = Settings,
            Seed = SeedFactory()
        };

    public class EstablishPlayersSettings
    {
        public GameSettings? Settings { get; init; }
        public bool AdvancedOptions { get; init; }
        public Ruleset Ruleset { get; init; }  
    }
}
