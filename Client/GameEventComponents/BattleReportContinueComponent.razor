@inherits GameEventComponent<EndPhase>

@*
    Lets the host end the battle from the battle wheel once its outcome has been reviewed. Automatic continuation is
    performed by the status panel; this control shares its Auto switch.
*@
<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>@(Game.NextPlayerToBattle != null ? "Proceed to the next battle" : "End the battle phase")</Header>

    <Body>
        <div>Review the battle outcome, then continue when everyone is ready.</div>
        @{ var error = Validation; }
        <div class="continue-split @(AutoContinueState.On ? "is-auto" : "")" role="group" aria-label="Continue">
            <button type="button" class="continue-split-main" disabled="@(AutoContinueState.On || error != null)"
                    title="@(error?.ToString(Client.CurrentSkin))" @onclick="Confirm">
                @(AutoContinueState.On ? "Continuing automatically…" : "Continue")
            </button>
            <button type="button" class="continue-split-auto" role="switch" aria-checked="@(AutoContinueState.On ? "true" : "false")"
                    title="@(AutoContinueState.On ? "Stop continuing automatically" : "Continue automatically from now on")"
                    @onclick="@(() => AutoContinueState.On = !AutoContinueState.On)">
                <span class="continue-split-switch" aria-hidden="true"></span>
                <span>Auto</span>
            </button>
        </div>
    </Body>

</GameEventComponentLayout>

@code {

    protected override bool IsUrgent => true;

    protected override EndPhase ConfirmedResult => new(Game, Faction);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AutoContinueState.Changed += OnAutoContinueChanged;
    }

    public override void Dispose()
    {
        AutoContinueState.Changed -= OnAutoContinueChanged;
        base.Dispose();
    }

    private void OnAutoContinueChanged() => InvokeAsync(StateHasChanged);
}
