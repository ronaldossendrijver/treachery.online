@inherits GameEventComponent<AllyPermission>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()" Collapsed="CollapseState.Collapsed">

    <Header>Manage your Alliance with &nbsp;<FactionComponent Faction="@Player.Ally"></FactionComponent></Header>

    <Body>

        @if (Player.AlliedPlayer!.IsBot)
        {
            var ally = Player.AlliedPlayer;

            if (ally.TreacheryCards.Any(c => c.IsWeapon))
            {
                <div>They claim they own a weapon.</div>
            }
            else
            {
                <div>They claim they don't own weapons.</div>
            }

            if (ally.TreacheryCards.Any(c => c.IsDefense))
            {
                <div>They claim they own a defense.</div>
            }
            else
            {
                <div>They claim they don't own defenses.</div>
            }

            var safeLeaders = ally.KnownNonTraitors.Where(l => l.Faction == Faction)
                .Union(ally.Traitors.Where(l => l.Faction == Faction)
                .Union(ally.FaceDancers.Where(l => l.Faction == Faction)))
                .ToArray();

            if (safeLeaders.Any())
            {
                <div>
                    They claim you can safely use:
                    @foreach (var l in safeLeaders) {
                        <Image Popover=@Client.CurrentSkin.GetPopup(l) Shown=l Width="30"/>
                    }
                </div>
            }
            else
            {

                <div>They don't know of any safe leaders you could use.</div>
            }

            <div>They own <strong>@ally.Resources</strong> @Client.CurrentSkin.Describe(Concept.Resource).</div>
        }

        <div class="mt-1">
            <SelectResourcesComponent @bind-Value="_spice" Min="0" Max="Player.Resources" OnChanged="SetEdited" Label="@WillingToPayLabel"/>
        </div>

        @if (Karma.CanKarma(Game, Player))
        {
            var permittedKarma = Game.GetPermittedUseOfAllyKarma(Player.Ally);

            <SelectFromImageComponent @bind-Value="_karmaCard" Values="Karma.ValidKarmaCards(Game, Player)" Required="false" T=TreacheryCard OnChanged=SetEdited ImageWidth="80">
                <Label>Select a @Client.CurrentSkin.Describe(TreacheryCardType.Karma) card they may use to ship at @Client.CurrentSkin.Describe(Faction.Orange) rates (currently: <strong>@(permittedKarma == null ? "none" : Name(permittedKarma))</strong>)?</Label>
            </SelectFromImageComponent>
        }
        else
        {
            _karmaCard = null;
        }

        @switch (Faction)
        {
            case Faction.Red:
                <div class="mt-1">
                    <label class="mt-1 mb-0">How many revivals will you pay for them (currently: <strong>@(Game.RedWillPayForExtraRevival)</strong>)?</label>
                    <SelectForcesComponent @bind-Value="_emperorWillPayForExtraRevival" Min="0" Max="3" Faction="Player.Ally" Special="false" OnChanged="@SetEdited"/>
                </div>
                break;

            case Faction.Orange:
                <CheckboxComponent @bind-Value="_guildAllyMayShipAsGuild" OnChanged=SetEdited>
                    Allow shipment at @Client.CurrentSkin.Describe(Faction.Orange) rates and site-to-site (currently: <strong>@(Game.OrangeAllowsShippingDiscount ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Purple:
                <CheckboxComponent @bind-Value="_purpleAllyMyReviveAsPurple" OnChanged=SetEdited>
                    Allow revival at @Client.CurrentSkin.Describe(Faction.Purple) rates (currently: <strong>@(Game.PurpleAllowsRevivalDiscount ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Grey:
                <CheckboxComponent @bind-Value="_greyAllyMayReplace" OnChanged=SetEdited>
                    Allow replacing treachery cards they win (currently: <strong>@(Game.GreyAllowsReplacingCards ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Yellow:
                <CheckboxComponent @bind-Value="_fremenAllowsThreeFreeRevivals" OnChanged=SetEdited>
                    Allow 3 free revivals (currently: <strong>@(Game.YellowAllowsThreeFreeRevivals ? "yes" : "no")</strong>)
                </CheckboxComponent>

                <CheckboxComponent @bind-Value="_fremenWillProtectFromShaiHulud" OnChanged=SetEdited>
                    Protect them from @Client.CurrentSkin.Describe(Concept.Monster) (currently: <strong>@(Game.YellowWillProtectFromMonster ? "yes" : "no")</strong>)
                </CheckboxComponent>

                @if (Game.Applicable(Rule.YellowDeterminesStorm))
                {
                    <CheckboxComponent @bind-Value="_fremenShareStormPrescience" OnChanged=SetEdited>
                        Share storm knowledge (currently: <strong>@(Game.YellowSharesPrescience ? "yes" : "no")</strong>)
                    </CheckboxComponent>
                }

                @if (Game.Applicable(Rule.YellowAllyGetsDialedResourcesRefunded))
                {
                    <CheckboxComponent @bind-Value="_fremenRefundsDial" OnChanged=SetEdited>
                        Refund @Name(Concept.Resource) dialled in battle (currently: <strong>@(Game.YellowRefundsBattleDial ? "yes" : "no")</strong>)
                    </CheckboxComponent>
                }

                break;

            case Faction.Green:
                <CheckboxComponent @bind-Value="_greenSharePrescience" OnChanged=SetEdited>
                    Share your Prescience (currently: <strong>@(Game.GreenSharesPrescience ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Blue:
                <CheckboxComponent @bind-Value="_blueAllyMayUseVoice" OnChanged=SetEdited>
                    Allow use of Voice (currently: <strong>@(Game.BlueAllowsUseOfVoice ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.White:
                <CheckboxComponent @bind-Value="_whiteAllyMayUseNoField" OnChanged=SetEdited>
                    Allow shipment by No-Field (currently: <strong>@(Game.WhiteAllowsUseOfNoField ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Cyan:
                <CheckboxComponent @bind-Value="_cyanAllyMayKeepCards" OnChanged=SetEdited>
                    Allow keeping a treachery card after a lost battle (currently: <strong>@(Game.CyanAllowsKeepingCards ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

            case Faction.Pink:
                <CheckboxComponent @bind-Value="_pinkAllyMayUseAmbassadors" OnChanged=SetEdited>
                    Allow them to activate and benefit from ambassadors (currently: <strong>@(Game.PinkSharesAmbassadors ? "yes" : "no")</strong>)
                </CheckboxComponent>
                break;

        }

        <ButtonRowComponent Confirm="ConfirmAndSetUnedited" ConfirmText="Confirm Changes" ConfirmError="@Validation" Disabled="@(!_edited)"/>

    </Body>

</GameEventComponentLayout>

@code {

    internal bool _purpleAllyMyReviveAsPurple;
    internal bool _greyAllyMayReplace;
    internal bool _guildAllyMayShipAsGuild;
    internal int _emperorWillPayForExtraRevival;
    internal bool _fremenWillProtectFromShaiHulud;
    internal bool _fremenAllowsThreeFreeRevivals;
    internal bool _fremenShareStormPrescience;
    internal bool _fremenRefundsDial;
    internal bool _greenSharePrescience;
    internal bool _blueAllyMayUseVoice;
    internal bool _whiteAllyMayUseNoField;
    internal bool _cyanAllyMayKeepCards;
    internal bool _pinkAllyMayUseAmbassadors;
    internal int _spice;
    internal TreacheryCard? _karmaCard;
    internal bool _edited;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!_edited)
        {
            _spice = Game.GetPermittedUseOfAllyResources(Player.Ally);
            _karmaCard = Game.GetPermittedUseOfAllyKarma(Player.Ally);

            switch (Faction)
            {
                case Faction.Purple:
                    _purpleAllyMyReviveAsPurple = Game.PurpleAllowsRevivalDiscount;
                    break;

                case Faction.Grey:
                    _greyAllyMayReplace = Game.GreyAllowsReplacingCards;
                    break;

                case Faction.Orange:
                    _guildAllyMayShipAsGuild = Game.OrangeAllowsShippingDiscount;
                    break;

                case Faction.Red:
                    _emperorWillPayForExtraRevival = Game.RedWillPayForExtraRevival;
                    break;

                case Faction.Yellow:
                    _fremenWillProtectFromShaiHulud = Game.YellowWillProtectFromMonster;
                    _fremenAllowsThreeFreeRevivals = Game.YellowAllowsThreeFreeRevivals;
                    _fremenShareStormPrescience = Game.YellowSharesPrescience;
                    _fremenRefundsDial = Game.YellowRefundsBattleDial;
                    break;

                case Faction.Green:
                    _greenSharePrescience = Game.GreenSharesPrescience;
                    break;

                case Faction.Blue:
                    _blueAllyMayUseVoice = Game.BlueAllowsUseOfVoice;
                    break;

                case Faction.White:
                    _whiteAllyMayUseNoField = Game.WhiteAllowsUseOfNoField;
                    break;

                case Faction.Cyan:
                    _cyanAllyMayKeepCards = Game.CyanAllowsKeepingCards;
                    break;

                case Faction.Pink:
                    _pinkAllyMayUseAmbassadors = Game.PinkSharesAmbassadors;
                    break;

            }
        }
    }

    private void SetEdited(bool value)
    {
        _edited = true;
    }

    private void SetEdited(int value)
    {
        _edited = true;
    }

    private void SetEdited(TreacheryCard c)
    {
        _edited = true;
    }

    protected override AllyPermission ConfirmedResult =>

        new(Game, Faction)
        {
            RedWillPayForExtraRevival = _emperorWillPayForExtraRevival,
            YellowAllowsThreeFreeRevivals = _fremenAllowsThreeFreeRevivals,
            YellowWillProtectFromMonster = _fremenWillProtectFromShaiHulud,
            YellowSharesPrescience = _fremenShareStormPrescience,
            YellowRefundsBattleDial = _fremenRefundsDial,
            GreenSharesPrescience = _greenSharePrescience,
            BlueAllowsUseOfVoice = _blueAllyMayUseVoice,
            WhiteAllowsUseOfNoField = _whiteAllyMayUseNoField,
            OrangeAllowsShippingDiscount = _guildAllyMayShipAsGuild,
            PurpleAllowsRevivalDiscount = _purpleAllyMyReviveAsPurple,
            GreyAllowsReplacingCards = _greyAllyMayReplace,
            CyanAllowsKeepingCards = _cyanAllyMayKeepCards,
            PinkSharesAmbassadors = _pinkAllyMayUseAmbassadors,
            PermittedResources = _spice,
            PermittedKarmaCard = _karmaCard
        };

    private async Task ConfirmAndSetUnedited()
    {
        await Confirm();
        _edited = false;
    }

    private string WillingToPayLabel =>
        string.Format("How much are you willing to pay for their {0}bids and shipments (currently: {1})? {2}",
            Faction == Faction.Brown ? "battles, " : "",
            Game.GetPermittedUseOfAllyResources(Player.Ally),
            Faction == Faction.Red ? "Payments for bids flow back to you." : "");
}
