@inherits GameEventComponent<KarmaFreeRevival>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>@Client.CurrentSkin.Describe(TreacheryCardType.Karma): @(Game.SecondEdition ? "War Machine — up to 4 forces and 1 leader" : "revive forces or a leader")</Header>
    <Body>
        @if (Game.SecondEdition)
        {
            <SelectFromImageComponent Game="Game" @bind-Value="powerCard" Values="Karma.ValidPowerCards(Game, Player)" Required="false" ImageWidth="60" />
        }

        @if (KarmaFreeRevival.ValidMaxAmount(Game, Player, false) > 0)
        {
            <SelectForcesComponent @bind-Value="amountOfForces" Min="0" Max="KarmaFreeRevival.ValidMaxAmount(Game, Player, false)" Faction="Faction" Special="false" />
        }
        else
        {
            amountOfForces = 0;
        }

        @if (KarmaFreeRevival.ValidMaxAmount(Game, Player, true) > 0)
        {
            <SelectForcesComponent @bind-Value="amountOfSpecialForces" Min="0" Max="KarmaFreeRevival.ValidMaxAmount(Game, Player, true)" Faction="Faction" Special="true" />
        }
        else
        {
            amountOfSpecialForces = 0;
        }

        <SelectFromImageComponent Game="Game" @bind-Value="hero" Values="Game.KilledHeroes(Player)" Required="false" ImageWidth="80"/>

        @if (hero != null && Revival.MayAssignSkill(Game, Player, hero))
        {
            <RadioComponent @bind-Value="assignSkill" Values="@(new[] {false,true})" ValueLabels="@(new[] {"No","Yes"})">
                <Label>Do you wish to assign a skill to this leader?</Label>
            </RadioComponent>
        }
        else
        {
            assignSkill = false;
        }

        <ButtonRowComponent Confirm="Confirm" ConfirmError="@Validation" />

    </Body>

</GameEventComponentLayout>

@code {

    protected override Faction IsFactionSpecific => Faction.Red;

    private int amountOfForces;
    private int amountOfSpecialForces;
    private IHero? hero;
    private bool assignSkill;
    private TreacheryCard? powerCard;

    protected override KarmaFreeRevival ConfirmedResult => new(Game, Faction) { AmountOfForces = amountOfForces, AmountOfSpecialForces = amountOfSpecialForces, Hero = hero, AssignSkill = assignSkill, PowerCardId = powerCard == null ? -1 : TreacheryCardManager.Lookup.GetId(powerCard) };
}
