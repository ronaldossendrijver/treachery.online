@inherits GameEventComponent<FactionTradeOffered>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Offer to trade factions</Header>
    <Body>
    
    <div>You're currently playing <FactionComponent Faction="@Faction"/>, do you wish to change factions?</div>

    <SelectFromImageComponent @bind-Value="_target" Values="FactionTradeOffered.ValidTargets(Game, Player)" Required="true" ImageWidth="40"/>

    <ButtonRowComponent Confirm="Confirm" ConfirmText="@ConfirmText" ConfirmError="@Validation"/>

    </Body>

</GameEventComponentLayout>

@code {

    private Faction _target;

    protected override FactionTradeOffered ConfirmedResult => new(Game, Faction) { Target = _target };

    private string ConfirmText => Game.Players.Any(p => p.Faction == _target) ? Client.CurrentSkin.Format("Offer Trade with {0}", _target) : Client.CurrentSkin.Format("Pick {0}", _target);
}