@inherits GameEventComponent<Voice>

<GameEventComponentLayout IsUrgent="@IsUrgent" BackgroundStyle="@BackgroundStyle" HeaderStyle="@HeaderStyle" BodyStyle="@BodyStyle" CollapsedType="GetType()">

    <Header>Use Voice</Header>
    <Body>

        @if (Game.CurrentBattle!.IsInvolved(Faction.Green))
        {
            <div class="ui-text-info ui-small ui-mb-2">Note: Use or pass Voice before Prescience.</div>
        }

        <RadioComponent @bind-Value="_mustUse" Values="@([true,false])" ValueLabels="@(["Force the use of...","Deny the use of..."])" />

        <SelectComponent @bind-Value="_type" Values="ValidTypes" />

        <ButtonRowComponent Confirm="Confirm" ConfirmError="@Validation" Pass="Pass" />

    </Body>

</GameEventComponentLayout>

@code {

    protected override Faction IsFactionSpecific => Faction.Blue;

    private bool _mustUse = true;
    private TreacheryCardType _type;

    protected override Voice ConfirmedResult => new(Game, Faction) { Must = _mustUse, Type = _type };

    protected override Voice PassedResult => new(Game, Faction) { Passed = true };

    private IEnumerable<TreacheryCardType> ValidTypes => Voice.ValidTypes(Game).OrderBy(t => Name(t));
}
